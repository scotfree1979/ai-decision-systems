    def _step3(self):
        """Gate & fetch anchor (lay) odds → update bets + record OC0 in oc_series."""
        if not self._markets:
            messagebox.showwarning("Anchors", "No markets in memory. Run Step 2 first.")
            return
        self.btn3.config(state="disabled")

        mode_now = (self._mode.get() or "learning").lower()

        def _snap(v: float) -> float:
            try:
                from engines.price_math import snap_to_tick
                return snap_to_tick(float(v))
            except Exception:
                return round(float(v), 2)

        def run():
            total = 0

            # TEST: inject synthetic anchors, no network
            if mode_now == "test":
                for m in self._markets:
                    mid = m.get("marketId")
                    for r in (m.get("runners") or []):
                        sid = r.get("selectionId")
                        if not mid or sid is None:
                            continue
                        try:
                            # Skip if already has anchor
                            row = _sqlite_exec(_AUTOSCALP_DB,
                                "SELECT anchor_odd FROM inbound_oc_cache WHERE marketId=? AND selectionId=? LIMIT 1",
                                [mid, sid], fetch=True)
                            has_anchor = bool(row and row[0] and row[0][0] is not None)
                            if has_anchor:
                                continue

                            # Deterministic synthetic anchor
                            base = 6.0 + ((int(sid) % 17) * 0.1)
                            lay = _snap(base)

                            hn = r.get("runnerName") or _bets_lookup_horse_name(mid, sid)
                            try:
                                _autoscalp_upsert_inbound_bets_min(mid, sid, None, None, hn, {"src": "anchor_inject_test"})
                            except Exception:
                                pass
                            _update_bets_anchor(mid, sid, lay)
                            _record_oc_series(mid, sid, "OC0", lay, source="SIM", meta={"mode": "TEST"})
                            _autoscalp_upsert_cache_anchor(mid, sid, lay)
                            total += 1
                        except Exception as e:
                            logging.warning(f"[anchors][TEST] {mid}/{sid} inject error: {e}")

                try: DBQ.join()
                except Exception: pass

                print(f"✅ Step 3 OK — anchors injected for ~{total} runners (TEST).")
                print("READY: next step")
                self.status.config(text="• Step 3 complete → Run Step 4 (TEST skips loop; use Dashboard Tests)", foreground="#2c7")
                self.btn4.config(state="disabled")
                return

            # LEARNING/LIVE: live fetch path
            try:
                from engines.upgrade_import_patch import get_session_token  # type: ignore
                token = (get_session_token() or "").strip()
            except Exception:
                token = (self._token.get() or "").strip()

            for m in self._markets:
                mid = m.get("marketId")
                for r in (m.get("runners") or []):
                    sid = r.get("selectionId")
                    if not mid or sid is None:
                        continue
                    try:
                        row = _sqlite_exec(_AUTOSCALP_DB,
                            "SELECT anchor_odd FROM inbound_oc_cache WHERE marketId=? AND selectionId=? LIMIT 1",
                            [mid, sid], fetch=True)
                        has_anchor = bool(row and row[0] and row[0][0] is not None)
                        if has_anchor:
                            continue

                        # AFTER (safer + opt-in)
                        use_direct = (os.getenv("AUTOSCALP_ENABLE_DIRECT_ODDS", "0") == "1") and bool(token)
                        odds = fetch_live_odds(token, mid, sid) if use_direct else {}
                        odds = odds or {}
                        lay = odds.get("lay")
                        if lay is None:
                            continue

                        lay = _snap(lay)
                        hn = r.get("runnerName") or _bets_lookup_horse_name(mid, sid)
                        try:
                            _autoscalp_upsert_inbound_bets_min(mid, sid, None, None, hn, {"src": "anchor_check"})
                        except Exception:
                            pass
                        _update_bets_anchor(mid, sid, lay)
                        _record_oc_series(mid, sid, "OC0", lay, meta={"odds": odds})
                        _autoscalp_upsert_cache_anchor(mid, sid, lay)
                        total += 1
                    except Exception as e:
                        logging.warning(f"[anchors] {mid}/{sid} fetch error: {e}")

            try: DBQ.join()
            except Exception: pass

            print(f"✅ Step 3 OK — anchors written (live) for ~{total} runners.")
            print("READY: next step")
            self.status.config(text="• Step 3 complete → Run Step 4 (start OC timeline loop)", foreground="#2c7")
            self.btn4.config(state="normal")

        threading.Thread(target=run, daemon=True).start()

