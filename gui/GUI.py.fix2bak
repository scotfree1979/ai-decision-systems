    def _step2(self):
        from engines.upgrade_import_patch import get_session_token
        tok = (get_session_token() or "").strip()
        markets = get_markets_and_insert(app_key=self._app_key, session_token=tok)
        """Ensure DB + launch writer + seed runners. TEST=synthetic; others=live fetch."""
        self.btn2.config(state="disabled")

        def run():
            try:
                # Make sure both schemas exist for the *current* mode
                ensure_tables()
                _ensure_autoscalp_tables()

                mode = (self._mode.get() or "learning").lower()

                if mode == "test":
                    # Seed synthetic markets/runners; no network, no stdin prompt
                    self._seed_test_markets(n_markets=10, runners_range=(8, 12))
                    return

                # ----- LEARNING/LIVE path -----
                ensure_parent(DB_PATH)
                launch_db_writer()

                today = now_utc().date()
                tgt = {(today + timedelta(days=d)).isoformat() for d in (0, 1)}

                markets = get_markets_and_insert() or []
                markets = _filter_markets_by_dates(markets, tgt)
                self._markets = markets

                if not any(m.get("marketStartTime") for m in markets):
                    print("⚠️ Only 0 runners with marketStartTime found. Skipping re-fetch in GUI (no stdin prompts).")
                    messagebox.showwarning(
                        "Seed Bets",
                        "No markets with start times found from API.\n"
                        "Check your session token (Step 1) or try again later."
                    )
                else:
                    print(f"✅ Step 2 OK — seeded {sum(len(m.get('runners') or []) for m in markets)} runners "
                          f"across {len(markets)} markets for {sorted(tgt)}.")

                print("READY: next step")
                self.status.config(text="• Step 2 complete → Run Step 3", foreground="#2c7")
                self.btn3.config(state="normal")

            except Exception as e:
                print(f"❌ Step 2 failed: {e}")
                messagebox.showerror("Seed Bets", str(e))
                self.btn2.config(state="normal")

        threading.Thread(target=run, daemon=True).start()



