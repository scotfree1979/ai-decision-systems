
# =======================
#   CORE IGNORE RULES
# =======================

# Databases (local + cloud clones)
**/*.db
**/*.db-shm
**/*.db-wal

# Logs & runtime traces
**/*.log
logs/**
tmp/**
runtime_watch.log
import_trace.txt
import_trace_runtime.py

# OS files
**/.DS_Store

# Python cache
**/__pycache__/
*.pyc

# Local caches & intermediates
cache/**
**/.cache/**
artifacts/**

# Local data (DBs, JSON snapshots, reports, etc)
data/**
reports/**
review_out/**
reviews/**

# Large generated files
*.json
*.csv
*.sql
*.gz
*.zip
*.tar
*.tgz
*.bak
*.tmp

# Blueprints, snapshots, and computed signals
blueprint_signals_*.json
mastery_snapshot*.json

*.sb-*

