# Check signals based on drift criteria and Betfair fire/ice signals
def check_signals(market):
    signals = []
    for runner in market.get('runners', []):
        metadata = runner.get('metadata', {})
        if 'runnerName' in runner and ('FIRE' in metadata or 'ICE' in metadata):
            drift_signal = 'FIRE' if 'FIRE' in metadata else 'ICE'
            signals.append({
                'marketId': market['marketId'],
                'selectionId': runner['selectionId'],
                'runnerName': runner['runnerName'],
                'signalType': drift_signal,
                'timeDetected': datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
                'strength': 1
            })
    return signals

