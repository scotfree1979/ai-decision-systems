# Fetch markets using hijacker
def fetch_markets():
    now = datetime.utcnow()
    start_time = now.strftime("%Y-%m-%dT%H:%M:%SZ")
    end_time = (now + timedelta(hours=6)).strftime("%Y-%m-%dT%H:%M:%SZ")

    params = {
        "filter": {
            "eventTypeIds": ["7"],
            "marketCountries": ["GB", "IE"],
            "marketTypeCodes": ["WIN"],
            "marketStartTime": {"from": start_time, "to": end_time}
        },
        "maxResults": "10",
        "marketProjection": ["RUNNER_METADATA", "MARKET_DESCRIPTION"],
        "sort": "FIRST_TO_START"
    }

    return list_market_catalogue(params)

# Get current prices using hijacker
def get_current_prices(market_id):
    params = {
        "marketIds": [market_id],
        "priceProjection": {"priceData": ["EX_BEST_OFFERS"], "virtualise": True}
    }
    response = list_market_book(params)
    prices = {}
    for runner in response[0]['runners']:
        if runner['ex']['availableToLay']:
            prices[runner['selectionId']] = runner['ex']['availableToLay'][0]['price']
    return prices

def run_scalping_engine():
    initialize_trading_session()

    risk_manager = RiskManager()

    while True:
        markets = fetch_markets()
        for market in markets:
            signals = check_signals(market)
            current_prices = get_current_prices(market['marketId'])
            market_start_time = market['marketStartTime']
            minutes_to_off = (datetime.strptime(market_start_time, "%Y-%m-%dT%H:%M:%S.%fZ") - datetime.utcnow()).total_seconds() / 60

            for signal in signals:
                print(f"🚩 Signal detected: {signal['runnerName']} in market {signal['marketId']} ({signal['signalType']})")
                lay_odds = current_prices.get(signal['selectionId'], 2.0)
                dynamic_stake = risk_manager.calculate_stake(signal)
                lay_response, status = place_scalp_bet(signal['marketId'], signal['selectionId'], dynamic_stake, lay_odds)

                if status['status'] == "Lay matched":
                    risk_manager.track_trade(
                        bet_id=lay_response['instructionReports'][0]['betId'],
                        market_id=signal['marketId'],
                        selection_id=signal['selectionId'],
                        odds=lay_odds,
                        stake=dynamic_stake,
                        bet_type='LAY',
                        liability=(lay_odds - 1) * dynamic_stake,
                        status='matched',
                        result='pending',
                        timestamp=datetime.utcnow()
                    )

            risk_manager.check_open_trades(market['marketId'], current_prices)
            risk_manager.hedge_before_race(market['marketId'], minutes_to_off, current_prices)

        print("🔄 Checking markets again in 60 seconds...")
        time.sleep(60)

if __name__ == "__main__":
    run_scalping_engine()
