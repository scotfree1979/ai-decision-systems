# signal_monitor.py (Final Integrated Version)

import logging

bot_signal_queues = {}

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

current_session = None  # explicitly track current session globally

# Explicit assignment of signals to bots based on signal type and session
bot_assignments = {
    'Market Drifter Signal': ['OGHeadTrader', 'OGPreoff'],
    'Market Steamer Signal': ['OGHeadTrader', 'OGPreoff'],
    'Odds Spike Reversal': ['OGHeadTrader'],
    'Early Pace Collapse': ['OG In-play'],
    'Late Surge Fade': ['OGPreoff'],
    'Drifter Recovery': ['OGPreoff'],
    'Venue/Trainer/Jockey Signals': ['OGHeadTrader', 'OGPreoff'],
    'ICE/FIRE In-Play Bets': ['OG In-play'],
    'Horse Hits Fence': ['OG In-play'],
    'Horse Rears Up': ['OG In-play'],
    'Missed Break': ['OG In-play'],
    'Jockey Loses Iron': ['OG In-play'],
    'Horse Pulling Hard': ['OG In-play'],
    'Favorite Struggling': ['OG In-play'],
    'Loose Horse': ['OG In-play'],
    'Horse Heavily Ridden': ['OG In-play'],
    'Runner Pulling Up': ['OG In-play'],
    'Heavy Ground Reaction': ['OG In-play'],
    'Late-Race Equipment Failure': ['OG In-play'],
    'Front Runner Comfortable': ['OG In-play'],
    'Horse Traveling Strongly': ['OG In-play'],
    'In-Play Lay Bets': ['OG In-play'],
    'Close Finish Forecasts': ['OG In-play', 'OGPreoff']
}

def process_signal(signal):
    global current_session

    signal_type = signal.get('signal_type')

    # Handle session-update signals explicitly
    if signal_type and signal_type.startswith('time_'):
        current_session = signal.get('time_session')
        logging.info(f"✅ Session explicitly updated to {current_session} min.")
        return []  # explicitly no further bot assignment needed for time-update signals

    # Explicitly assign signals to bots, including current session information
    assigned_bots = bot_assignments.get(signal_type, [])
    processed_signals = []

    if not assigned_bots:
        logging.warning(f"No explicit bot assignment found for signal: {signal_type}")

    for bot_name in assigned_bots:
        new_signal = signal.copy()
        new_signal['bot_name'] = bot_name
        new_signal['time_session'] = current_session  # explicitly include session info
        logging.info(f"✅ Signal explicitly assigned to {bot_name} (session: {current_session} min): {new_signal}")
        processed_signals.append(new_signal)

    return processed_signals
