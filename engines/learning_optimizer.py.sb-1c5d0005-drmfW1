import logging
import sqlite3
import json
from datetime import datetime, timedelta

DB_PATH = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db"

class LearningOptimizer:
    def __init__(self):
        self.db_path = DB_PATH
        self.last_run = None
        self.stats = {
            "total_bets": 0,
            "win_rate": 0.0,
            "average_odds": 0.0,
            "strategy_performance": {},
            "action_flags": {},
            "underperforming": []
        }

    def load_bets(self):
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            one_day_ago = (datetime.utcnow() - timedelta(days=1)).isoformat()
            cursor.execute("""
                SELECT strategy_name, status, odds, pnl
                FROM bets
                WHERE placed_at >= ?
            """, (one_day_ago,))
            rows = cursor.fetchall()
            conn.close()
            return rows
        except Exception as e:
            logging.error(f"❌ [LearningOptimizer] Failed to load bets: {e}")
            return []

    def analyze(self, rows):
        if not rows:
            logging.info("📫 [LearningOptimizer] No new bets to analyze.")
            return

        total = 0
        wins = 0
        total_odds = 0.0
        performance = {}
        strategy_pnls = {}

        for strategy, status, odds, pnl in rows:
            total += 1
            total_odds += odds if odds else 0
            if strategy not in performance:
                performance[strategy] = {"wins": 0, "bets": 0, "pnl": 0.0}
            performance[strategy]["bets"] += 1
            performance[strategy]["pnl"] += pnl if pnl else 0.0
            if status == "won":
                wins += 1
                performance[strategy]["wins"] += 1

        self.stats["total_bets"] = total
        self.stats["win_rate"] = round(wins / total, 2) if total else 0.0
        self.stats["average_odds"] = round(total_odds / total, 2) if total else 0.0
        self.stats["strategy_performance"] = {
            k: {
                "win_rate": round(v["wins"] / v["bets"], 2),
                "total_bets": v["bets"],
                "total_pnl": round(v["pnl"], 2)
            }
            for k, v in performance.items()
        }

        # Flag underperforming strategies and recommended actions
        self.stats["underperforming"] = [
            strategy for strategy, data in self.stats["strategy_performance"].items()
            if data["win_rate"] < 0.25 and data["total_bets"] > 5
        ]

        self.stats["action_flags"] = {
            "pause_strategies": self.stats["underperforming"],
            "review_required": [k for k, v in self.stats["strategy_performance"].items() if v["win_rate"] < 0.35]
        }

        logging.info(f"📊 [LearningOptimizer] {json.dumps(self.stats, indent=2)}")

    def enhance_bots(self):
        # Future integration hook
        logging.info("🧠 [LearningOptimizer] Enhancement module not yet connected to live bots.")

    def run(self):
        if self.last_run and datetime.utcnow() - self.last_run < timedelta(hours=6):
            logging.info("⏳ [LearningOptimizer] Skipping — already analyzed today.")
            return

        self.last_run = datetime.utcnow()
        logging.info("🔁 [LearningOptimizer] Starting daily optimization run...")
        rows = self.load_bets()
        self.analyze(rows)
        log_optimizer_run(self.stats)
        self.enhance_bots()

# ✅ Log-to-DB helper

def log_optimizer_run(stats):
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS optimizer_logs (
                run_at TEXT,
                total_bets INTEGER,
                win_rate REAL,
                average_odds REAL,
                strategy_performance TEXT,
                action_flags TEXT
            )
        """)
        conn.commit()

        cursor.execute("""
            INSERT INTO optimizer_logs (run_at, total_bets, win_rate, average_odds, strategy_performance, action_flags)
            VALUES (?, ?, ?, ?, ?, ?)
        """, (
            datetime.utcnow().isoformat(),
            stats.get("total_bets", 0),
            stats.get("win_rate", 0.0),
            stats.get("average_odds", 0.0),
            json.dumps(stats.get("strategy_performance", {})),
            json.dumps(stats.get("action_flags", {}))
        ))
        conn.commit()
        conn.close()
        logging.info("📂 [LearningOptimizer] Stats logged to optimizer_logs table.")
    except Exception as e:
        logging.error(f"❌ [LearningOptimizer] Failed to log stats: {e}")

if __name__ == "__main__":
    optimizer = LearningOptimizer()
    optimizer.run()
