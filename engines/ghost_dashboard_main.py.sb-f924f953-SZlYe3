import streamlit as st
import pandas as pd
import json
import time
import matplotlib.pyplot as plt
from datetime import datetime

# -------------------------
# 🔁 Signal Playback Engine – Tab 2
# -------------------------

st.title("🔁 Signal Playback Engine")

# -------------------------
# 🗓 Date + Speed Controls
# -------------------------
st.sidebar.header("Simulation Controls")
sim_date = st.sidebar.date_input("Select Date")
speed = st.sidebar.slider("Playback Speed (sec/tick)", 0.01, 1.0, 0.1, 0.01)
start_sim = st.sidebar.button("▶️ Start Simulation")

# Load data paths
csv_path = f"tickdata_{sim_date}.csv"
json_path = f"blueprint_signals_{sim_date}.json"

# -------------------------
# 🔄 Load Simulation Data
# -------------------------
def load_tick_data():
    return pd.read_csv(csv_path)

def load_signals():
    with open(json_path, "r") as f:
        return json.load(f)

# -------------------------
# 📊 Visualization Setup
# -------------------------
plot_placeholder = st.empty()
signal_feed = st.empty()
tracker_table = st.empty()

# -------------------------
# 🔁 Simulation Engine
# -------------------------
def simulate_signals(tick_df, signals):
    current_data = []
    signal_log = []

    for tick in tick_df.itertuples():
        runner = tick.runner
        market_id = tick.market_id
        odds = tick.lay_odds
        ts = tick.timestamp

        # Append to chart
        current_data.append((ts, odds))

        # Match signal
        matched = [s for s in signals if s['runner'] == runner and s['market_id'] == market_id]
        fired = []

        for sig in matched:
            entry = sig.get('entry')
            exit = sig.get('exit')
            bp_match = sig.get('blueprint_match')
            conf = sig.get('confidence')
            pattern = sig.get('tick_pattern')

            if abs(odds - entry) < 0.01 or abs(odds - exit) < 0.01:
                fired.append({
                    'runner': runner,
                    'market_id': market_id,
                    'odds': odds,
                    'timestamp': ts,
                    'type': 'ENTRY' if abs(odds - entry) < 0.01 else 'EXIT',
                    'confidence': conf,
                    'pattern': pattern,
                    'bp_match': bp_match
                })

        # Display chart
        ts_x, odds_y = zip(*current_data[-100:])
        fig, ax = plt.subplots()
        ax.plot(ts_x, odds_y, label=f"Lay Odds for {runner}")

        for f in fired:
            ax.axvline(f['timestamp'], color='red' if f['type'] == 'ENTRY' else 'blue', linestyle='--')

        ax.set_xlabel("Time")
        ax.set_ylabel("Odds")
        ax.legend()
        plot_placeholder.pyplot(fig)

        # Log signal
        for f in fired:
            signal_log.append(f)
            signal_feed.markdown(f"**{f['timestamp']}** – {f['type']} signal for `{f['runner']}` @ {f['odds']} | Conf: {f['confidence']} | Pattern: {f['pattern']} | BP: {f['bp_match']}")

        # Update tracker
        tracker_df = pd.DataFrame(signal_log)
        tracker_table.dataframe(tracker_df.tail(10), use_container_width=True)

        time.sleep(speed)

# -------------------------
# ▶️ Run Simulation
# -------------------------
if start_sim:
    try:
        tick_df = load_tick_data()
        signals = load_signals()
        simulate_signals(tick_df, signals)
    except Exception as e:
        st.error(f"Simulation failed: {e}")


