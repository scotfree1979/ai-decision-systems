HEADTRADER_START_BAL = 500


def calculate_metrics(df, name, starting_balance=None):
    df = df.copy()

    # Use fallback if 'status' or 'pnl' missing
    df["status"] = df.get("status", "unknown")
    df["pnl"] = pd.to_numeric(df.get("pnl", 0.0), errors="coerce").fillna(0.0)
    df["result"] = df.get("result", "")
    df["confidence"] = pd.to_numeric(df.get("confidence", 0.0), errors="coerce").fillna(0.0)
    df["signal_type"] = df.get("signal_type", "")

    settled = df[df["status"] == "settled"]
    pnl = round(settled["pnl"].sum(), 2)
    win_pct = round(len(settled[settled["result"] == "won"]) / len(settled) * 100, 2) if len(settled) else 0.0
    avg_conf = round(df["confidence"].mean(), 2)
    entry_signals = (df["signal_type"] == "entry").sum()
    exit_signals = (df["signal_type"] == "exit").sum()
    balance = starting_balance + pnl if starting_balance is not None else None

    return {
        "name": name,
        "signals": len(df),
        "settled": len(settled),
        "pnl": pnl,
        "win_pct": win_pct,
        "avg_conf": avg_conf,
        "entry_signals": entry_signals,
        "exit_signals": exit_signals,
        "balance": balance
    }


