if "signal_table" not in st.session_state:
    st.session_state.signal_table = []

# -------------------------
# ⚙️ Control Panel
# -------------------------
col1, col2 = st.columns([1, 1])
with col1:
    run_once = st.button("🔁 Run Signal Evaluation Once")
with col2:
    auto_refresh = st.checkbox("🔄 Auto Refresh Every 10 Seconds")

# -------------------------
# 🧠 Evaluate Signal Handler
# -------------------------
def run_signal_evaluation():
    output = evaluate_signal()  # This should return list of evaluated signals

    for signal in output:
        log_lines = []
        runner = signal.get("runner")
        market_id = signal.get("market_id")
        signal_type = signal.get("signal_type")
        confidence = signal.get("confidence", 0.0)
        tick_pattern = signal.get("tick_pattern", "–")
        drift = signal.get("drift", 0.0)
        tick_range = signal.get("range_low", 0.0), signal.get("range_high", 0.0)
        bracket = signal.get("bracket", "–")
        blueprint = signal.get("blueprint_match", False)
        status = signal.get("status", "pending")

        # Logging line
        if blueprint:
            log_lines.append("📘 Blueprint matched")
        log_lines.append(f"🔁 Tick Pattern: {tick_pattern}")
        log_lines.append(f"🔺 Confidence: {confidence:.2f}")
        if confidence >= 0.75:
            log_lines.append(f"✅ Signal approved @ {signal.get('entry', '–')}")

        # Log entry
        timestamp = datetime.now().strftime("%H:%M:%S")
        st.session_state.signal_log.append((timestamp, runner, log_lines))

        # Table update
        display_conf = f"✅ {confidence:.2f}" if confidence >= 0.75 else (
            f"⚠️ {confidence:.2f}" if confidence >= 0.65 else f"🟡 {confidence:.2f}"
        )
        display_status = "✅" if status == "approved" else ("⚠️" if status == "pending" else "🟡")

        st.session_state.signal_table.insert(0, {
            "Time": timestamp,
            "Runner": runner,
            "Market ID": market_id,
            "Type": signal_type,
            "Confidence": display_conf,
            "Tick Pattern": tick_pattern,
            "Drift %": f"{drift:.1f}%",
            "Tick Range": f"{tick_range[0]}–{tick_range[1]}",
            "Bracket": bracket,
            "Blueprint?": "✅" if blueprint else "–",
            "Status": display_status
        })

    # Limit display to most recent 15
    st.session_state.signal_table = st.session_state.signal_table[:15]

# -------------------------
# 🔁 Trigger Evaluation
# -------------------------
if run_once:
    run_signal_evaluation()

if auto_refresh:
    while True:
        run_signal_evaluation()
        time.sleep(10)
        st.experimental_rerun()

# -------------------------
# 🧠 Evaluation Summary Table
# -------------------------
st.markdown("### 📊 Most Recent Signal Evaluations")
if st.session_state.signal_table:
    df = pd.DataFrame(st.session_state.signal_table)
    st.dataframe(df, use_container_width=True)
else:
    st.info("No signals evaluated yet. Run the engine to see updates.")

# -------------------------
# 📡 Signal Log Panel
# -------------------------
st.markdown("### 📡 Signal Evaluation Log")
with st.expander("📡 View Live Evaluation Log"):
    for timestamp, runner, lines in reversed(st.session_state.signal_log[-40:]):
        st.markdown(f"**[{timestamp}] {runner}**")
        for line in lines:
            st.markdown(f"- {line}")


