# ✅ Logic overrides from upgrade packages
from upgrade.upgrade_20250522 import (
    place_basic_lay_bet,
    place_ladder_lay_bet,
    place_scalp_trade,
    place_greenup_exit,
    get_market_book,
    evaluate_signal,
    wrap_run_monitor
)

import logging
import time
import threading
import os
import json
import requests
from datetime import datetime, timedelta
from signal_monitor import signal_queue
from daily_config import APP_KEY

# ✅ Inject upgraded logic globally
globals()['place_basic_lay_bet'] = place_basic_lay_bet
globals()['place_ladder_lay_bet'] = place_ladder_lay_bet
globals()['place_scalp_trade'] = place_scalp_trade
globals()['place_greenup_exit'] = place_greenup_exit
globals()['get_market_book'] = get_market_book
globals()['evaluate_signal'] = evaluate_signal
globals()['wrap_run_monitor'] = wrap_run_monitor

# ✅ Passive monitor to confirm the tool remains active

def log_system_initialization():
    messages = [
        "✅ Market Monitor Initialized",
        "✅ Signal Monitor Active",
        "✅ Risk Manager Engaged",
        "✅ Budget Manager Online",
        "✅ Bot Queues Live",
        "✅ Thread Launch Confirmed"
    ]
    for msg in messages:
        logging.info(msg)

# ✅ Active upgraded signal fetcher thread
def upgrade_monitor():
    logging.warning("🐛 DEBUG: upgrade_monitor (v2) running via upgrade_import_patch")
    log_system_initialization()
    session_token = os.environ.get("SESSION_TOKEN") or "HARDCODED-TEMP-TOKEN"
    url = "https://api.betfair.com/exchange/betting/json-rpc/v1"
    try:
        response = requests.post(
            url,
            headers={
                "X-Application": APP_KEY,
                "X-Authentication": session_token,
                "Content-Type": "application/json"
            },
            data=json.dumps([
                {
                    "jsonrpc": "2.0",
                    "method": "SportsAPING/v1.0/listMarketCatalogue",
                    "params": {
                        "filter": {
                            "eventTypeIds": ["7"],
                            "marketStartTime": {
                                "from": datetime.utcnow().strftime("%Y-%m-%dT00:00:00Z"),
                                "to": (datetime.utcnow() + timedelta(days=1)).strftime("%Y-%m-%dT00:00:00Z")
                            }
                        },
                        "maxResults": "50"
                    },
                    "id": 1
                }
            ])
        )
        markets = response.json()[0].get("result", []) if response.status_code == 200 else []
    except Exception as e:
        logging.error(f"❌ [UpgradeMonitor] Market fetch error: {e}")
        markets = []

    while True:
        try:
            wrap_run_monitor(signal_queue, session_token, markets)
            logging.info("🔁 wrap_run_monitor() executed in upgraded import patch")
        except Exception as e:
            logging.error(f"🛑 wrap_run_monitor failure: {e}")
        time.sleep(60)

# ✅ Launch upgraded monitor + idle loop
threading.Thread(target=upgrade_monitor, daemon=True).start()
threading.Thread(target=lambda: logging.info("⏰ [Loop] System idle... waiting for incoming signals.") or time.sleep(60), daemon=True).start()
