import requests
import json
import time
from datetime import datetime, timedelta

BETFAIR_ENDPOINT = "https://api.betfair.com/exchange/betting/rest/v1.0/"

def sanitize_headers(headers):
    sanitized_headers = {}
    for key, value in headers.items():
        sanitized_headers[key] = value.encode('latin-1', 'ignore').decode('latin-1')
    return sanitized_headers

def fetch_markets(headers):
    payload = {
        "filter": {
            "eventTypeIds": ["7"],
            "marketCountries": ["GB", "IE"],
            "marketTypeCodes": ["WIN"],
            "marketStartTime": {
                "from": datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
                "to": (datetime.utcnow() + timedelta(hours=24)).strftime("%Y-%m-%dT%H:%M:%SZ")
            }
        },
        "maxResults": "20",
        "marketProjection": ["EVENT", "RUNNER_METADATA", "MARKET_START_TIME"],
        "sort": "FIRST_TO_START"
    }

    response = requests.post(
        BETFAIR_ENDPOINT + "listMarketCatalogue/",
        headers=headers,
        data=json.dumps(payload)
    ).json()

    return response

def place_scalp_bet(headers, market_id, selection_id, stake, lay_odds):
    lay_payload = {
        "marketId": market_id,
        "instructions": [{
            "selectionId": selection_id,
            "side": "LAY",
            "orderType": "LIMIT",
            "limitOrder": {"size": stake, "price": lay_odds, "persistenceType": "PERSIST"}
        }]
    }
    lay_response = requests.post(BETFAIR_ENDPOINT + "placeOrders/", headers=headers, data=json.dumps(lay_payload)).json()

    lay_bet_id = lay_response['instructionReports'][0].get('betId')

    matched = False
    for attempt in range(10):
        status_payload = {"betIds": [lay_bet_id]}
        bet_status = requests.post(BETFAIR_ENDPOINT + "listCurrentOrders/", headers=headers, data=json.dumps(status_payload)).json()

        if bet_status['currentOrders'][0]['sizeMatched'] >= 0.01:
            matched = True
            break
        print("⏳ Waiting for lay bet to match...")
        time.sleep(2)

    if not matched:
        print("⚠️ Lay bet not matched. Cancelling lay bet.")
        cancel_payload = {"marketId": market_id, "instructions": [{"betId": lay_bet_id}]}
        requests.post(BETFAIR_ENDPOINT + "cancelOrders/", headers=headers, data=json.dumps(cancel_payload))
        return lay_response, {"status": "Cancelled, Lay unmatched"}

    return lay_response, {"status": "Lay matched"}

def run_scalping_engine(headers, active_bets, test_mode=True, num_scalps=9, stake=2):
    try:
        headers = sanitize_headers(headers)
        markets = fetch_markets(headers)
        if markets:
            print(f"✅ Horses loaded successfully for {len(markets)} races.")
            for mkt in markets[:3]:
                print(f"DEBUG MARKET: {mkt['event']['name']} - MarketID: {mkt['marketId']}")
        else:
            print("❌ No horses loaded.")
            return

        for i, market in enumerate(markets[:3]):
            print(f"DEBUG LOOP: Entered scalping loop for Race {i+1}")
            runner = market['runners'][0]
            market_id = market['marketId']
            selection_id = runner['selectionId']
            lay_odds = 2.0

            print(f"DEBUG SCALPING ODDS: MarketID={market_id}, SelectionID={selection_id}, LayOdds={lay_odds}")

            lay_response, status = place_scalp_bet(headers, market_id, selection_id, stake, lay_odds)

            print(f"🔴 Lay Response: {lay_response}")
            print(f"✅ Status: {status}")

            time.sleep(2)

    except Exception as e:
        print(f"\n🚨 ERROR detected during scalping:\n{e}\n")
        return  # Immediately return to terminal prompt after error.

