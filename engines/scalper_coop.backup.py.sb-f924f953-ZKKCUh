                filtered = [m for m in all_markets if len(m.get("runners", [])) >= 7][:5]

                if not filtered:
                    print("📭 No suitable test races found.")
                    continue

                print("🧪 Test Mode – Choose a market to simulate live execution:")
                for i, m in enumerate(filtered, 1):
                    print(f"{i}. {m['event']['venue']} – {m['marketName']} @ {m['marketStartTime']}")

                choice = input("🔢 Select a test market by number: ").strip()
