                print(f"🔍 Test market selected: {market['event']['venue']} – {market['marketName']}")

                randcarb_session(market)
                continue

            elif user_input == "q":
                print("👋 Co-op session ended.")
                return

            else:
                print("⏳ Retrying in 60 seconds...")
                time.sleep(60)
                continue
        else:
            from datetime import timezone
            from utils.api_tools import fetch_live_odds
            from upgrade_import_patch import get_session_token

            for market in filtered:
                session_token = get_session_token()
                try:
                    start_time = datetime.fromisoformat(market['marketStartTime'].replace("Z", "+00:00"))
                    now = datetime.now(timezone.utc)
                    minutes_to_off = int((start_time - now).total_seconds() / 60)
