# -----------------------------
# 📊 Odds History Analysis – Trend/Volatility/Quality Assessment
# -----------------------------
def evaluate_odds_history(market_id, selection_id, window=10):
    import sqlite3, os
    import statistics
    from datetime import datetime

    db_path = os.path.join(os.path.dirname(__file__), "odds_history.db")
    try:
        with sqlite3.connect(db_path) as conn:
            cursor = conn.cursor()
            cursor.execute("""
                SELECT lay, back, timestamp FROM odds_snapshots
                WHERE marketId = ? AND selectionId = ?
                ORDER BY timestamp DESC LIMIT ?
            """, (market_id, selection_id, window))
            rows = cursor.fetchall()

            if len(rows) < 3:
                return {
                    "volatility_trend": "insufficient_data",
                    "drift_consistency": 0.0,
                    "slope": 0.0,
                    "quality_score": 0
                }

            lays = [r[0] for r in rows if isinstance(r[0], (int, float))]
            if not lays or len(lays) < 3:
                return {
                    "volatility_trend": "bad_data",
                    "drift_consistency": 0.0,
                    "slope": 0.0,
                    "quality_score": 0
                }

            slope = (lays[0] - lays[-1]) / len(lays)
            diffs = [abs(lays[i] - lays[i-1]) for i in range(1, len(lays))]
            volatility = statistics.stdev(lays) if len(lays) >= 2 else 0.0

            quality_score = 70 + min(abs(slope)*10, 15) - min(volatility*5, 10)
            quality_score = max(0, min(100, round(quality_score)))

            trend = "stable" if volatility < 0.05 else "choppy"

            return {
                "volatility_trend": trend,
                "drift_consistency": round(1 - (volatility / max(0.01, abs(slope + 0.01))), 2),
                "slope": round(slope, 4),
                "quality_score": quality_score
            }
    except Exception as e:
        print(f"⚠️ Error in evaluate_odds_history: {e}")
        return {
            "volatility_trend": "error",
            "drift_consistency": 0.0,
            "slope": 0.0,
            "quality_score": 0
        }

