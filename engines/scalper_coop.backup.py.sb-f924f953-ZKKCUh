from datetime import datetime, timezone

def store_anchor_odds(market):
    import sqlite3
    import os
    from utils.api_tools import fetch_live_odds

    db_path = os.path.join(os.path.dirname(__file__), "early_anchor_odds.db")
    os.makedirs(os.path.dirname(db_path), exist_ok=True)

    market_id = market["marketId"]
    runners = market.get("runners", [])
    now = datetime.now(timezone.utc)

    with sqlite3.connect(db_path) as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS anchor_odds (
                marketId TEXT,
                selectionId INTEGER,
                anchor REAL,
                timestamp TEXT,
                PRIMARY KEY (marketId, selectionId)
            )
        """)
        for r in runners:
            selection_id = r["selectionId"]
            odds_data = fetch_live_odds(None, market_id, selection_id)
            if not odds_data or "lay" not in odds_data:
                continue
            anchor = odds_data["lay"]
            try:
                conn.execute("""
                    INSERT OR IGNORE INTO anchor_odds (marketId, selectionId, anchor, timestamp)
                    VALUES (?, ?, ?, ?)
                """, (market_id, selection_id, anchor, now.isoformat()))
            except Exception as e:
                print(f"❌ Anchor insert failed for {selection_id}: {e}")

# -----------------------------
# 📦 fetch_anchor_odds – Load anchor odds for a specific runner
# -----------------------------
def fetch_anchor_odds(market_id, selection_id):
    import sqlite3
    import os
    db_path = os.path.join(os.path.dirname(__file__), "early_anchor_odds.db")
    try:
        with sqlite3.connect(db_path) as conn:
            cursor = conn.cursor()
            cursor.execute("""
                SELECT anchor FROM anchor_odds
                WHERE marketId = ? AND selectionId = ?
            """, (market_id, selection_id))
            row = cursor.fetchone()
            return row[0] if row else None
    except Exception as e:
        print(f"⚠️ Anchor fetch failed for {selection_id}: {e}")
        return None

