# 🧠 analyze_market_signal – Real-time tracking version for manual market
# -----------------------------
def analyze_market_signal(market, get_anchor, selection_id, current_odds, anchor, drift):
    import time
    import logging
    from scalper_coop import evaluate_odds_history
    from utils.api_tools import fetch_live_odds
    from price_math import get_tick_size, calculate_tick_distance
    from rules.head_trader_rules import rule_allows_signal
    from scalping_engine import analyze_market_range, determine_scalp_direction, should_enter_scalp
    from volatility_check import real_time_volatility_check

    market_id = market.get("marketId")
    runner = next((r for r in market.get("runners", []) if r["selectionId"] == selection_id), None)
    if not runner:
        return None

    logging.info(f"🔍 Tracking manual market {market_id} for {runner['runnerName']}...")

    while True:
        odds_data = fetch_live_odds(None, market_id, selection_id)
        if not odds_data:
            time.sleep(5)
            continue

        lay_odds = odds_data.get("lay")
        back_odds = odds_data.get("back")
        if not lay_odds or not back_odds:
            time.sleep(5)
            continue

        profile = analyze_market_range({
            "selectionId": selection_id,
            "ex": {
                "availableToLay": [{"price": lay_odds}],
                "availableToBack": [{"price": back_odds}]
            }
        })
        if not profile:
            time.sleep(5)
            continue

        direction = determine_scalp_direction(anchor, lay_odds)
        profile["direction"] = direction

        last_price = lay_odds if direction == "lay_to_back" else back_odds
        if not should_enter_scalp(profile, last_price):
            time.sleep(5)
            continue

        strategy_name = "scalp_lay_signal_entry" if direction == "lay_to_back" else "scalp_lay_signal_exit"
        bet_type = "SCALP"
        time_signal = "time_10"
        bot_name = "OGHeadTrader"

        if not rule_allows_signal("Scalping", last_price, bot_name=bot_name, time_signal=time_signal):
            time.sleep(5)
            continue

        volatility_data = real_time_volatility_check(market_id, selection_id, [lay_odds, back_odds])
        avg_vol = volatility_data.get("avg_volatility") if volatility_data else 0.0
        volatile = volatility_data.get("volatile") if volatility_data else False

        tick_drift = calculate_tick_distance(anchor, last_price)
        confidence = round(0.75 + min(tick_drift * 0.01, 0.1), 2)

        quality = evaluate_odds_history(market_id, selection_id)
        quality_score = quality.get("quality_score", 0)

        signal = {
            "marketId": market_id,
            "selectionId": selection_id,
            "runnerName": runner["runnerName"],
            "odds": last_price,
            "scalp_direction": direction,
            "strategy_name": strategy_name,
            "bet_type": bet_type,
            "confidence": confidence,
            "time_signal": time_signal,
            "anchor_odds": anchor,
            "spread": profile["spread"],
            "tick_size": profile["tick_size"],
            "avg_volatility": avg_vol,
            "volatile": volatile,
            "quality_score": quality_score,
            "status": "approved" if confidence >= 0.85 else "awaiting_user"
        }

