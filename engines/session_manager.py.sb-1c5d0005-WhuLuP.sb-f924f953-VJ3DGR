# Place a persistent lay bet (Pre-off logic)
def place_pre_off_lay_bet(runner, odds, stake, market_id, headers):
    lay_payload = {
        "marketId": market_id,
        "instructions": [{
            "selectionId": runner,
            "side": "LAY",
            "orderType": "LIMIT",
            "limitOrder": {"size": stake, "price": odds, "persistenceType": "PERSIST"}
        }]
    }

    lay_response = requests.post(BETFAIR_ENDPOINT + "placeOrders/", headers=headers, json=lay_payload).json()
    print("🔍 Betfair Response:", lay_response)
    if lay_response.get('status') == 'SUCCESS':
        report = lay_response['instructionReports'][0]
        print(f"✅ Pre-off Lay Bet Placed: Runner {runner}, Odds {odds}, Stake {stake}, Status: {report.get('status')}, Bet ID: {report.get('betId')}")
    else:
        print(f"🚫 Failed Pre-off Lay Bet: Runner {runner}, Error: {lay_response.get('errorCode')}")

# Enhanced continuous odds monitoring and placement (Fill-and-Fill logic with market check)
def place_in_play_lay_bet(runner, initial_odds, stake, market_id, headers, odds_increment=0.05, max_odds=15.0, retry_interval=3):
    current_odds = initial_odds
    matched = False

    while current_odds <= max_odds and not matched:
        adjusted_odds = round(current_odds + odds_increment, 2)

        lay_payload = {
            "marketId": market_id,
            "instructions": [{
                "selectionId": runner,
                "side": "LAY",
                "orderType": "LIMIT",
                "limitOrder": {"size": stake, "price": adjusted_odds, "persistenceType": "FILL_OR_KILL"}
            }]
        }

        lay_response = requests.post(BETFAIR_ENDPOINT + "placeOrders/", headers=headers, json=lay_payload).json()
        print("🔍 Betfair Response:", lay_response)

        if lay_response.get('status') == 'SUCCESS':
            report = lay_response['instructionReports'][0]
            if report.get('status') == 'SUCCESS':
                matched = True
                print(f"✅ Lay Bet Matched: Runner {runner}, Odds {adjusted_odds}, Stake {stake}, Bet ID {report.get('betId')}")
            else:
                print(f"⏳ Unmatched, retrying at higher odds ({adjusted_odds})")
        else:
            error_detail = lay_response.get('errorCode', 'No error detail provided')
            print(f"🚫 Lay Bet Error at Odds {adjusted_odds}: {error_detail}")
            break  # Critical error, break loop

        current_odds += odds_increment
        time.sleep(retry_interval)

    if not matched:
        print(f"⚠️ Could not match bet within odds range up to {max_odds}.")

