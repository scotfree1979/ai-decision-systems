# ✅ api_tools.py – Shared API Functions (Updated with Enhanced MarketBook Request)

import json
import requests
import logging
import os
import time
from datetime import datetime, timedelta

# -----------------------------
# ✅ LIVE ODDS FETCH (Updated to match Gruss-style request)
# -----------------------------

def fetch_live_odds(session_token, market_id, selection_id):
    url = "https://api.betfair.com/exchange/betting/json-rpc/v1"
    headers = {
        "X-Application": "CZHojduNWa3kxWIn",
        "X-Authentication": session_token,
        "Content-Type": "application/json"
    }
    payload = json.dumps([
        {
            "jsonrpc": "2.0",
            "method": "SportsAPING/v1.0/listMarketBook",
            "params": {
                "marketIds": [market_id],
                "priceProjection": {
                    "priceData": ["EX_BEST_OFFERS", "EX_ALL_OFFERS", "EX_TRADED"],
                    "virtualise": True
                },
                "orderProjection": "ALL",
                "matchProjection": "ROLLED_UP_BY_PRICE"
            },
            "id": 1
        }
    ])

    try:
        response = requests.post(url, headers=headers, data=payload)
        if response.status_code != 200:
            logging.error(f"❌ API error {response.status_code}: {response.text}")
            return None

        json_data = response.json()
        if not isinstance(json_data, list) or not json_data:
            logging.error(f"❌ Invalid Betfair response format: {json_data}")
            return None

        market_book = json_data[0]
        runners = market_book.get("runners", [])
        if not runners:
            logging.warning(f"⚠️ No runners returned for market {market_id}. Market may be closed or malformed.")
            return None

        for runner in runners:
            if runner.get("selectionId") == selection_id and runner.get("status") == "ACTIVE":
                lay = runner.get("ex", {}).get("availableToLay", [])
                back = runner.get("ex", {}).get("availableToBack", [])
                lay_price = lay[0].get("price") if lay else None
                back_price = back[0].get("price") if back else None
                return {"lay": lay_price, "back": back_price}

        logging.warning(f"⚠️ Runner {selection_id} not found in market {market_id}. Available: {[r.get('selectionId') for r in runners]}")
        return None

    except Exception as e:
        logging.error(f"❌ Failed to fetch odds for market {market_id}, selection {selection_id}: {e}")
        return None


# -----------------------------
# ✅ STANDALONE TEST TOOL
# -----------------------------

def test_fetch_live_odds():
    print("\n🔧 Starting standalone fetch test...")
    session_token = os.environ.get("SESSION_TOKEN") or input("🔐 Enter your Betfair session token: ")
    os.environ["SESSION_TOKEN"] = session_token
    time.sleep(2)

    headers = {
        "X-Application": "CZHojduNWa3kxWIn",
        "X-Authentication": session_token,
        "Content-Type": "application/json"
    }

    print("🔄 Sending keep-alive to Betfair...")
    try:
        response = requests.post(
            "https://identitysso.betfair.com/api/keepAlive",
            headers=headers
        )
        if response.status_code == 200:
            print("✅ Keep-alive successful.")
        else:
            print(f"❌ Keep-alive failed: {response.status_code} {response.text}")
            return
    except Exception as e:
        print(f"❌ Exception during keep-alive: {e}")
        return

    time.sleep(3)

    print("📡 Fetching next 1 upcoming WIN market...")
    list_market_payload = json.dumps([
        {
            "jsonrpc": "2.0",
            "method": "SportsAPING/v1.0/listMarketCatalogue",
            "params": {
                "filter": {
                    "eventTypeIds": ["7"],
                    "marketCountries": ["GB", "IE"],
                    "marketTypeCodes": ["WIN"],
                    "marketStartTime": {
                        "from": datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
                    }
                },
                "marketProjection": ["RUNNER_DESCRIPTION"],
                "sort": "FIRST_TO_START",
                "maxResults": "1"
            },
            "id": 1
        }
    ])

    try:
        r = requests.post("https://api.betfair.com/exchange/betting/json-rpc/v1", headers=headers, data=list_market_payload)
        data = r.json()
        if not isinstance(data, list) or not data or "result" not in data[0]:
            print(f"❌ Invalid market response: {data}")
            return

        markets = data[0]["result"]

        if not markets:
            print("❌ No markets returned.")
            return

        market = markets[0]
        market_id = market["marketId"]
        runners = market.get("runners", [])
        if not runners:
            print(f"⚠️ Market {market_id} returned no runners.")
            return

        print(f"🕒 Starting 2-minute loop for odds snapshot...")
        start_time = time.time()
        while time.time() - start_time < 120:
            for runner in runners:
                selection_id = runner["selectionId"]
                runner_name = runner.get("runnerName", "Unnamed")
                odds = fetch_live_odds(session_token, market_id, selection_id)
                if odds:
                    print(f"📌 {runner_name} | Back: {odds['back']} | Lay: {odds['lay']}")
                else:
                    print(f"❌ Odds not available for {runner_name}")
            print("⏱ Waiting 10 seconds...")
            time.sleep(10)

    except Exception as e:
        print(f"❌ Could not fetch market catalogue: {e}")


if __name__ == "__main__":
    test_fetch_live_odds()
