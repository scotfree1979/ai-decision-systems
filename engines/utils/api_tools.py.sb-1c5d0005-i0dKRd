def fetch_live_odds(session_token, marketId, selectionId):
    url = "https://api.betfair.com/exchange/betting/json-rpc/v1"
    headers = {
        "X-Application": "CZHojduNWa3kxWIn",
        "X-Authentication": session_token,
        "Content-Type": "application/json"
    }
    payload = json.dumps([
        {
            "jsonrpc": "2.0",
            "method": "SportsAPING/v1.0/listMarketBook",
            "params": {
                "marketIds": [marketId],
                "priceProjection": {
                    "priceData": ["EX_BEST_OFFERS"],
                    "virtualise": True
                }
            },
            "id": 1
        }
    ])

    try:
        response = requests.post(url, headers=headers, data=payload)
        if response.status_code != 200:
            logging.error(f"❌ API error {response.status_code}: {response.text}")
            return None

        json_data = response.json()
        if not isinstance(json_data, list) or not json_data:
            logging.error(f"❌ Invalid Betfair response format: {json_data}")
            return None

        market_book = json_data[0].get("result", [])[0] if json_data[0].get("result") else {}
        runners = market_book.get("runners", [])
        if not runners:
            logging.warning(f"⚠️ No runners returned for market {marketId}. Market may be closed or malformed.")
            return None

        for runner in runners:
            if runner.get("selectionId") == selectionId:
                lay = runner.get("ex", {}).get("availableToLay", [])
                back = runner.get("ex", {}).get("availableToBack", [])
                lay_price = lay[0].get("price") if lay else None
                back_price = back[0].get("price") if back else None
                return {"lay": lay_price, "back": back_price}

        logging.warning(f"⚠️ Runner {selectionId} not found in market {marketId}. Available: {[r.get('selectionId') for r in runners]}")
        return None

    except Exception as e:
        logging.error(f"❌ Failed to fetch odds for market {marketId}, selection {selectionId}: {e}")
        return None

