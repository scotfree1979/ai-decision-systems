# ✅ Utility Checks

def rule_allows_signal(strategy, odds, bot_name, time_signal):
    if strategy == "Scalping" and odds < MIN_BACK_ODDS_FOR_SCALP:
        return False
    if strategy == "Ladder Lays" and odds > MAX_LAY_ODDS_FOR_LADDER:
        return False
    if time_signal not in ACTIVE_TIME_WINDOWS:
        return False
    if bot_name in MAX_LIABILITY_PER_BOT and MAX_LIABILITY_PER_BOT[bot_name] < odds * 2:
        return False
    return True
