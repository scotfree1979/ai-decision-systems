def detect_signal(anchor_odds, current_odds):
    try:
        change = ((1/current_odds) - (1/anchor_odds)) / (1/anchor_odds) * 100
        movement = None
        strategy = None

        if change <= -7.5:
            movement = "fire"
            strategy = "Market Steamer Signal"
        elif change >= 7.5:
            movement = "ice"
            strategy = "Market Drifter Signal"
        elif -1.0 <= change <= 1.0:
            movement = "pin"
            strategy = "Volume Surge Signal"
        elif abs(change) > 5:
            movement = "snap"
            strategy = "Market Inefficiency Signal"

        if movement and strategy:
            return {
                "movement": movement,
                "strategy": strategy,
                "confidence": round(abs(change) / 10, 2),
                "raw_change": round(change, 2)
            }
        else:
            return None
    except Exception as e:
        logging.error(f"❌ Signal detection failed | anchor: {anchor_odds}, current: {current_odds} | Error: {e}")
        return None

