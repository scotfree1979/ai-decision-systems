def get_market_book(session_token, market_id):
    headers = {
        'X-Authentication': session_token,
        'Content-Type': 'application/json'
    }
    payload = [{
        "jsonrpc": "2.0",
        "method": "SportsAPING/v1.0/listMarketBook",
        "params": {
            "marketIds": [market_id],
            "priceProjection": {"priceData": ["EX_BEST_OFFERS"]}
        },
        "id": 1
    }]
    response = requests.post("https://api.betfair.com/exchange/betting/json-rpc/v1", headers=headers, data=json.dumps(payload)).json()
    return response[0]['result'][0] if 'result' in response[0] else None


