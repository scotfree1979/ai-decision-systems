def wrap_run_monitor(signal_queue, session_token, markets):
    if not markets:
        logging.warning("⚠️ [Upgrade] No markets passed to wrap_run_monitor.")
        return

    valid_markets = [
        m for m in markets
        if m.get('marketType') == 'WIN'
        and len(m.get('runners', [])) >= 7
        and m.get('event', {}).get('countryCode') in ['GB', 'IE']
        and m.get('event', {}).get('openDate', '').startswith(datetime.datetime.utcnow().strftime('%Y-%m-%d'))
        and m.get('marketStartTime', '').startswith(datetime.datetime.utcnow().strftime('%Y-%m-%d'))
        and not any(bad in m.get('marketName', '') for bad in ['Distance', 'Tote', 'Odds'])
    ]

    if not valid_markets:
        logging.warning("⚠️ [Upgrade] No valid WIN markets with 7+ runners found.")
        return

# ULTIMATE PATCH – PART 2: LOOP & MARKET EXTRACTION
    for market in valid_markets:
        time.sleep(1)
        signal_market_id = market['marketId']
        signal_selection_id = market['runners'][0]['selectionId']

# ULTIMATE PATCH – PART 3: GET ODDS
        book = get_market_book(session_token, signal_market_id)
        best_odds = None
        for runner in book['runners']:
            if runner['selectionId'] == signal_selection_id and runner['ex']['availableToLay']:
                best_odds = runner['ex']['availableToLay'][0]['price']
                break
        if not best_odds:
            logging.warning("⚠️ No lay odds available. Fallback to 3.0.")
            best_odds = 3.0

# ULTIMATE PATCH – PART 4: SIGNAL BUILD & DISPATCH
        signal = {
            'type': 'heartbeat',
            'signal_type': 'Market Drifter Signal',
            'marketId': signal_market_id,
            'selectionId': signal_selection_id,
            'strategy_name': 'Basic Lay',
            'stake': 5.0,
            'odds': best_odds,
            'bot_name': 'OGHeadTrader',
            'session_token': session_token,
            'timestamp': datetime.datetime.utcnow().isoformat(),
            'source': 'upgrade.wrap_run_monitor',
            'detail': 'heartbeat',
            'time_session': 'anytime',
            'market_name': market.get('marketName'),
            'event_name': market.get('event', {}).get('name')
        }

        signal_queue.put(signal)
        logging.info(f"⏱ [Upgrade Monitor] Locked signal emitted: {signal}")
