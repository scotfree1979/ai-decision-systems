def scalp_tick_offset(session_token, market_id, sid, entry_odds, direction):
    tick = calculate_tick(entry_odds)
    if direction == 'lay_to_back':
        hedge_odds = round_to_valid_odds(entry_odds + 2 * tick)
        hedge_side = 'BACK'
    elif direction == 'back_to_lay':
        hedge_odds = round_to_valid_odds(entry_odds - 2 * tick)
        hedge_side = 'LAY'
    else:
        logging.warning(f"⚠️ [ScalpLogic] Unknown direction: {direction}")
        return
    logging.info(f"🎯 [ScalpTickOffset] Opposite {hedge_side} set @ {hedge_odds} for {sid}")
    place_bet(session_token, market_id, sid, 0.01, hedge_odds, hedge_side)


