scalp_state = {}

def place_scalp_trade(session_token, market_id, selection_id, entry_odds, direction, total_stake=20.0):
    import time
    from bet_core import check_bet_matched

    tick = calculate_tick(entry_odds)
    matched = 0.0
    penny_size = 0.01
    max_attempts = int(total_stake / penny_size)

    if selection_id not in scalp_state:
        scalp_state[selection_id] = {
            "active": True,
            "matched_lay": 0.0,
            "matched_back": 0.0,
            "loss": 0.0,
            "failures": 0,
            "direction": direction
        }
    elif scalp_state[selection_id]["failures"] >= 4 or scalp_state[selection_id]["loss"] > 40:
        logging.info(f"🔒 [SmartScalp] Skipping {selection_id} due to failure count or loss cap.")
        return

    scalp_state[selection_id]["active"] = True
    scalp_state[selection_id]["direction"] = direction
    logging.info(f"🧠 [SmartScalp] Starting scalp on {selection_id} @ {entry_odds} for £{total_stake} ({direction})")

    for i in range(max_attempts):
        customer_order_ref = f"SCALP-{selection_id}-{i}"
        place_bet(session_token, market_id, selection_id, penny_size, entry_odds, "LAY" if direction == "lay_to_back" else "BACK")
        update_bet_in_db(customer_order_ref, {
            "stake": penny_size,
            "odds": entry_odds,
            "bet_type": "scalp_entry",
            "status": "placed"
        })
        time.sleep(1)
        matched += penny_size  # simulated until live match check wired in

        if direction == "lay_to_back":
            hedge_odds = round_to_valid_odds(entry_odds + 2 * tick)
            hedge_side = "BACK"
        else:
            hedge_odds = round_to_valid_odds(entry_odds - 2 * tick)
            hedge_side = "LAY"

        logging.info(f"🪙 [SmartScalp] Matched £{matched:.2f}. Hedge: {hedge_side} £{matched:.2f} @ {hedge_odds}")
        hedge_ref = f"SCALP-HEDGE-{selection_id}-{i}"
        place_bet(session_token, market_id, selection_id, matched, hedge_odds, hedge_side)
        update_bet_in_db(hedge_ref, {
            "stake": matched,
            "odds": hedge_odds,
            "bet_type": "scalp_hedge",
            "status": "placed"
        })

        if matched >= total_stake:
            scalp_state[selection_id]["active"] = False
            logging.info("✅ [SmartScalp] Full stake matched and mirrored. Exiting.")
            break

    if matched < total_stake:
        scalp_state[selection_id]["failures"] += 1
        scalp_state[selection_id]["loss"] += total_stake * 0.5
        logging.warning(f"💥 [SmartScalp] Stop-loss triggered on {selection_id}. Loss recorded. Failures: {scalp_state[selection_id]['failures']}")
        scalp_state[selection_id]["active"] = False

