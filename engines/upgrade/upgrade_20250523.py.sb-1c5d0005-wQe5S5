def normalize_market_time(market_start):
    try:
        return datetime.strptime(market_start, "%Y-%m-%dT%H:%M:%S.%fZ")
    except ValueError:
        return datetime.strptime(market_start, "%Y-%m-%dT%H:%M:%SZ")

def upgrade_monitor():
    print("🐛 DEBUG: upgrade_monitor() called from upgrade_20250523.py")
    log_system_initialization()
    session_token = os.environ.get("SESSION_TOKEN", "NO_TOKEN")
    logging.info(f"📌 [DEBUG] signal_queue memory ID (upgrade_monitor): {id(signal_queue)}")

    while True:
        try:
            markets = []

            print("🚀 Sending request to Betfair API...")
            response = requests.post(
                "https://api.betfair.com/exchange/betting/json-rpc/v1",
                headers={
                    "X-Application": "CZHojduNWa3kxWIn",
                    "X-Authentication": session_token,
                    "Content-Type": "application/json"
                },
                data=json.dumps([{
                    "jsonrpc": "2.0",
                    "method": "SportsAPING/v1.0/listMarketCatalogue",
                    "params": {
                        "filter": {
                            "eventTypeIds": ["7"],
                            "marketCountries": ["GB", "IE"],
                            **({"marketTypeCodes": ["WIN"]} if USE_MARKET_TYPE_FILTER else {}),
                            "marketStartTime": {
                                "from": datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
                                "to": (datetime.utcnow() + timedelta(days=1)).strftime("%Y-%m-%dT%H:%M:%SZ")
                            }
                        },
                        "marketProjection": ["RUNNER_DESCRIPTION", "MARKET_START_TIME"],
                        "maxResults": "200"
                    },
                    "id": 1
                }])
            )

            raw_markets = response.json()[0].get("result", []) if response.status_code == 200 else []
            print(f"📦 Raw markets fetched: {len(raw_markets)}")

            for m in raw_markets:
                try:
                    start_time_raw = m.get('marketStartTime') or m.get('marketStartTimeUtc')
                    if not start_time_raw:
                        raise KeyError("marketStartTime missing")

                    market_time = normalize_market_time(start_time_raw)
                    seconds_to_off = (market_time - datetime.utcnow()).total_seconds()
                    if seconds_to_off > 4800:
                        if len(m.get('runners', [])) <= 7:
                            print(f"⛔ Skipped (<=7 runners): {m['marketName']}")
                            continue
                        print(f"✅ Market accepted: {m['marketName']} | Off in {int(seconds_to_off / 60)} min")
                        markets.append(m)
                except Exception as e:
                    print(f"⚠️ Skipped market due to bad startTime: {m.get('marketName', 'unknown')} | Error: {e}")

            print(f"🎯 Filter complete: {len(markets)} markets ready")
            for market in markets:
                market_id = market['marketId']
                for runner in market['runners']:
                    selection_id = runner['selectionId']
                    signal = {
                        "marketId": market_id,
                        "selectionId": selection_id,
                        "timestamp": datetime.utcnow().isoformat(),
                        "status": "pending"
                    }
                                        signal_queue.put(signal)
                    print(f"📤 Signal created + queued | Market: {market['marketName']} | Runner: {selection_id}")

            logging.info(f"🧮 Total signals in queue after creation: {signal_queue.qsize()}")

        except Exception as e:
            print(f"🛑 Unhandled exception during upgrade_monitor: {e}")
            traceback.print_exc()

        print("🔄 [Upgrade] Run Monitor Cycle Complete")
        time.sleep(60)

def queue_monitor():
    logging.info("🧪 [QueueMonitor] Thread active. Waiting for signals...")
    logging.info(f"📌 [DEBUG] signal_queue memory ID (queue_monitor): {id(signal_queue)}")

    while True:
        try:
            signal = signal_queue.get(timeout=5)
            logging.info(f"📥 [QueueMonitor] Signal received from queue: {signal}")

            process_signal(signal)
            logging.info("🧠 [QueueMonitor] Evaluating signal...")
            if evaluate_signal(signal):
                logging.info("✅ [QueueMonitor] Signal approved by Risk Manager")
                if signal.get('stake', 0) <= 800.0:
                    logging.info("💰 [QueueMonitor] Budget check passed, routing to bot...")
                    bot = signal.get('bot_name', 'OGHeadTrader')
                    bot_signal_queues[bot].put(signal)
                    logging.info(f"📦 [QueueMonitor] Signal routed to {bot}")
                else:
                    logging.info("🔒 [QueueMonitor] Budget check failed")
            else:
                logging.info("🚫 [QueueMonitor] Risk check failed")

        except Empty:
            continue
        except Exception as e:
            logging.error(f"❌ [QueueMonitor] Error while processing signal: {e}")
            traceback.print_exc()

if __name__ == "__main__":
    launch_protocol()
    threading.Thread(target=queue_monitor, name="queue_monitor", daemon=True).start()
    threading.Thread(target=upgrade_monitor, name="upgrade_monitor", daemon=True).start()
    threading.Thread(target=HeadTraderBot().run, name="bot_threads", daemon=True).start()
