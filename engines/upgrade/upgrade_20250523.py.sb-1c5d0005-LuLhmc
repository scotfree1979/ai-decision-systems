# Extension of upgrade_20250523 with time session logic and signal deduplication

from datetime import datetime, timedelta
import sqlite3
import logging

DB_PATH = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db"

# Time session windows (in seconds)
TIME_WINDOWS = {
    80: (4680, 4920),
    60: (3480, 3720),
    40: (2280, 2520),
    20: (1080, 1320),
    10: (480, 720),
    5:  (180, 420),
    0:  (0, 120)
}

def get_time_session(delta_seconds):
    for session, (min_s, max_s) in TIME_WINDOWS.items():
        if min_s <= delta_seconds <= max_s:
            return session
    return None

def signal_exists(market_id, selection_id, strategy, time_session):
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()
        cursor.execute("""
            SELECT 1 FROM signals
            WHERE marketId=? AND selectionId=? AND strategy_name=? AND time_session=?
            LIMIT 1
        """, (market_id, selection_id, strategy, time_session))
        exists = cursor.fetchone() is not None
        conn.close()
        return exists
    except Exception as e:
        logging.error(f"❌ [Timing Upgrade] DB deduplication check failed: {e}")
        return False

def normalize_market_time(market_start):
    try:
        return datetime.strptime(market_start, "%Y-%m-%dT%H:%M:%S.%fZ")
    except ValueError:
        return datetime.strptime(market_start, "%Y-%m-%dT%H:%M:%SZ")

# ✅ Overriding wrap_run_monitor from upgrade

def ensure_signals_table():
    try:
        conn = sqlite3.connect(DB_PATH)
        cur = conn.cursor()
        cur.execute("""
            CREATE TABLE IF NOT EXISTS signals (
                marketId TEXT,
                selectionId INTEGER,
                strategy_name TEXT,
                time_session INTEGER,
                stake REAL,
                confidence REAL,
                status TEXT,
                timestamp TEXT
            )
        """)
        conn.commit()
        conn.close()
        logging.info("🧱 signals table ready")
    except Exception as e:
        logging.error(f"❌ Could not ensure signals table: {e}")

def wrap_run_monitor(signal_queue, session_token, markets):
    ensure_signals_table()
    from upgrade_import_patch import head_trader, risk_manager, budget_manager
    from upgrade.upgrade_20250522 import place_basic_lay_bet
    from upgrade_import_patch import head_trader
    from upgrade.upgrade_20250522 import create_signal  # assumed import
    count = 0

    for market in markets:
        market_id = market['marketId']
        try:
            market_time = normalize_market_time(market['marketStartTime'])
        except Exception as e:
            logging.warning(f"⏳ Invalid marketStartTime for {market_id}: {e}")
            continue

        for runner in market['runners']:
            selection_id = runner['selectionId']
            seconds_to_off = (market_time - datetime.utcnow()).total_seconds()
            session = get_time_session(seconds_to_off)
            if session is None:
                continue

            for strategy_name in ['Green-Up', 'Basic Lay']:  # use actual strategies
                if signal_exists(market_id, selection_id, strategy_name, session):
                    continue

                signal = {
                    'marketId': market_id,
                    'selectionId': selection_id,
                    'strategy_name': strategy_name,
                    'time_session': session,
                    'timestamp': datetime.utcnow().isoformat(),
                    'stake': 5.0,
                    'confidence': 1.0,
                    'status': 'pending'
                }

                logging.info(f"📤 [Queued] {strategy_name} signal → queue_monitor | T-{session}min | Runner: {selection_id}")
                signal = head_trader.adjust_risk_weights(signal)
                try:
                    # Risk evaluation
                    if not risk_manager.evaluate_signal(signal):
                        logging.warning(f"🛑 [Risk Reject] {strategy_name} | Runner: {selection_id} | Reason: evaluation failed")
                        continue

                    # Budget approval
                    if not budget_manager.evaluate_budget(signal):
                        logging.warning(f"💸 [Budget Reject] {strategy_name} | stake: £{signal['stake']:.2f} | confidence: {signal['confidence']:.2f}")
                        continue

                    # Place bet (simulated for now)
                    place_basic_lay_bet(signal)
                    signal['status'] = 'placed'
                    logging.info(f"✅ [Bet Placed] {strategy_name} | stake: £{signal['stake']:.2f} | market: {market_id} | runner: {selection_id}")
                except Exception as bet_err:
                    logging.error(f"❌ [Bet Error] {strategy_name} | Runner: {selection_id} | Error: {bet_err}")

                signal_queue.put(signal)
                logging.info(f"🔁 [Signal Lifecycle] Created → Enriched → Queued | stake: £{signal['stake']:.2f} | confidence: {signal['confidence']:.2f}")
                count += 1
                logging.info(f"🟢 New signal created | {market_id} | Runner {selection_id} | {strategy_name} | T-{session}min")

        # Store signal diagnostics into optimizer_logs or signal_diagnostics table (if needed)
    try:
        conn = sqlite3.connect(DB_PATH)
        cur = conn.cursor()
        cur.execute("""
            CREATE TABLE IF NOT EXISTS signal_diagnostics (
                marketId TEXT,
                selectionId INTEGER,
                strategy_name TEXT,
                time_session INTEGER,
                stake REAL,
                confidence REAL,
                status TEXT,
                placed_at TEXT,
                profile_applied_at TEXT
            )
        """)
        conn.commit()
        for s in list(signal_queue.queue):
            cur.execute("""
                INSERT INTO signal_diagnostics (
                    marketId, selectionId, strategy_name, time_session, stake, confidence, status, placed_at, profile_applied_at
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (
                s['marketId'],
                s['selectionId'],
                s['strategy_name'],
                s['time_session'],
                s['stake'],
                s['confidence'],
                s.get('status', 'unknown'),
                datetime.utcnow().isoformat(),
                datetime.utcnow().isoformat()
            ))
        conn.commit()
        conn.close()
        logging.info(f"🧠 Signal diagnostics stored: {len(signal_queue.queue)} entries")
    except Exception as db_log_err:
        logging.error(f"❌ Failed to write signal diagnostics: {db_log_err}")

    logging.info(f"✅ wrap_run_monitor: {count} signals created this cycle")
