# 🔐 Helper: Append 'E' or 'B' to customerOrderRef

def append_stage(ref, tag):
    if ref.endswith(tag):
        return ref
    if len(ref + f"_{tag}") <= 32:
        return f"{ref}_{tag}"
    parts = ref.split("_")
    if len(parts) >= 3:
        parts[2] = parts[2][-3:]
        trimmed = "_".join(parts)
        return f"{trimmed}_{tag}"
    return f"{ref[:32 - len(tag) - 1]}_{tag}"

# 🚨 Step 1: Risk Manager – Basic Rule: Stake > 20 = Reject

def risk_manager():
    print("🧠 Thread started: Risk Manager")
    logging.info("🛡️ risk_manager() launched")
    while True:
        try:
            with sqlite3.connect(DB_PATH) as conn:
                cursor = conn.cursor()
                cursor.execute("SELECT * FROM bets WHERE status = 'fully_enriched'")
                rows = cursor.fetchall()

                for row in rows:
                    stake = row[2]
                    customerOrderRef = row[33]

                    if stake is not None and stake > 20:
                        logging.warning(f"❌ Rejected by Risk Manager: {customerOrderRef} (Stake {stake})")
                        cursor.execute("UPDATE bets SET status = 'rejected_risk' WHERE customerOrderRef = ?", (customerOrderRef,))
                        continue

                    new_ref = append_stage(customerOrderRef, "E")
                    cursor.execute("UPDATE bets SET status = 'risk_approved', customerOrderRef = ? WHERE customerOrderRef = ?", (new_ref, customerOrderRef))
                    logging.info(f"✅ Assessed risk and passed to Budget Manager: {new_ref}")

                conn.commit()
