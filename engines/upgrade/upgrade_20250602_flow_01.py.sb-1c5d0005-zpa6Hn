def run_monitor():
    global SNAPSHOT_DATA
    print("✅ RUN_MONITOR: STARTING")
    try:
        from utils.api_tools import fetch_live_odds
        print("✅ RUN_MONITOR: IMPORTED fetch_live_odds")
    except Exception as e:
        print("❌ RUN_MONITOR: IMPORT FAILED", e)
    import time
    import logging
    import sqlite3
    import json
    from datetime import datetime, timezone
    from config_paths import DB_PATH, SESSION_TOKEN
    from utils.api_tools import fetch_live_odds

    logging.info("🕒 [Thread] run_monitor launched")

    while True:
        try:
            logging.info("🔁 [Monitor] Entered main loop")
            now = datetime.now(timezone.utc)
            logging.info(f"🕒 [Clock Tick] Current UTC time: {now.strftime('%Y-%m-%d %H:%M:%S')} UTC")

            with sqlite3.connect(DB_PATH) as conn:
                cursor = conn.cursor()
                cursor.execute("SELECT * FROM bets WHERE status IN ('pending', 'awaiting_signal')")
                rows = cursor.fetchall()
                logging.info(f"📆 [DB] Retrieved {len(rows)} runner rows to evaluate")

                for row in rows:
                    marketId = row[0]
                    selectionId = row[1]
                    runner_name = row[15] or "Unknown"
                    start_time = SNAPSHOT_DATA.get(marketId, {}).get("start_time")

                    if not start_time:
                        raw_time = row[35]
                        try:
                            start_time = datetime.fromisoformat(raw_time.replace("Z", "+00:00"))
                            SNAPSHOT_DATA[marketId] = {"start_time": start_time}
                        except:
                            logging.warning(f"⚠️ Could not parse fallback start_time for {marketId}")
                            continue

                    minutes_to_off = int((start_time - now).total_seconds() / 60)
                    if minutes_to_off == 999:
                        logging.warning(f"⚠️ No snapshot clock for {marketId}, skipping.")
                        continue

                    if minutes_to_off > 85:
                        logging.info(f"⏳ [Upcoming] {runner_name} – {int(minutes_to_off)} mins to off. Resetting signal if needed.")
                        logging.info(f"✅ [RunMonitor Clock Confirmed] {runner_name} sees {int(minutes_to_off)} mins to off from start_time snapshot.")
                        cursor.execute("""
                            UPDATE bets SET time_signal = 'upcoming'
                            WHERE marketId = ? AND selectionId = ?
                        """, (marketId, selectionId))
                        continue

                    if minutes_to_off < -60:
                        logging.info(f"🚑 [Missed] {runner_name} – Race started more than 60 mins ago.")
                        cursor.execute("""
                            UPDATE bets SET status = 'missed', time_signal = 'missed'
                            WHERE marketId = ? AND selectionId = ? AND status = 'pending'
                        """, (marketId, selectionId))
                        continue

                    event_name = row[25] or marketId
                    logging.info(f"⏱️ [Runner Clock] {runner_name} – Event: {event_name} – Off at {start_time.strftime('%H:%M')} UTC – T-{int(minutes_to_off)} mins")

                    for time_mark, signal_tag in zip([80, 60, 40, 20, 10, 5, 0],
                                                    ["time_80", "time_60", "time_40", "time_20", "time_10", "time_5", "time_0"]):
                        gap = 20 if time_mark >= 20 else 5
                        if abs(minutes_to_off - time_mark) > gap:
                            continue

                        customer_order_ref = f"{marketId[-5:]}_{selectionId}_{time_mark}"[:32]
                        cursor.execute("SELECT 1 FROM bets WHERE customerOrderRef = ?", (customer_order_ref,))
                        exists = cursor.fetchone()

                        odds_data = fetch_live_odds(marketId=marketId, selectionId=selectionId, session_token=SESSION_TOKEN)
                        odds = odds_data["lay"] if odds_data else None
                        if odds is None:
                            logging.warning(f"🕓 [Missed Odds] {runner_name} – T-{minutes_to_off} mins – odds unavailable, skipping signal update.")
                            continue

                        if row[20] == 'awaiting_signal' and row[19] == 'time_20':
                            odds_field = {
                                10: "odds_check_2",
                                5: "odds_check_1"
                            }.get(time_mark)

                            if odds_field:
                                cursor.execute(f"""
                                    UPDATE bets SET {odds_field} = ?, odds = ?
                                    WHERE marketId = ? AND selectionId = ? AND time_signal = 'time_20'
                                """, (odds, odds, marketId, selectionId))

                            if time_mark == 0:
                                cursor.execute("""
                                    UPDATE bets SET odds = ?
                                    WHERE marketId = ? AND selectionId = ? AND time_signal = 'time_20'
                                """, (odds, marketId, selectionId))

                        if time_mark in [80, 60, 40, 20] and not exists:
                            odds_field = {
                                80: "odds_check_6",
                                60: "odds_check_5",
                                40: "odds_check_4",
                                20: "odds_check_3"
                            }[time_mark]
                            try:
                                cursor.execute(f"""
                                    UPDATE bets SET 
                                        odds = ?, 
                                        {odds_field} = ?, 
                                        time_signal = ?, 
                                        timestamp = ?, 
                                        status = CASE WHEN ? = 20 THEN 'awaiting_signal' ELSE status END
                                    WHERE marketId = ? AND selectionId = ? AND status = 'pending'
                                """, (odds, odds, signal_tag, datetime.utcnow().isoformat(), time_mark, marketId, selectionId))

                                if time_mark == 80:
                                    cursor.execute("""
                                        UPDATE bets SET anchor_odd = ?
                                        WHERE marketId = ? AND selectionId = ? AND anchor_odd IS NULL
                                    """, (odds, marketId, selectionId))
                                    logging.info(f"📌 Anchor odds locked for {runner_name}: {odds}")

                                logging.info(f"🔁 Updated {signal_tag} row for {runner_name} @ {odds}")
                            except Exception:
                                logging.exception(f"❌ Failed to update odds at {signal_tag} for {runner_name}:")

                        if time_mark in [10, 5, 0] and not exists:
                            try:
                                cursor.execute("""
                                    SELECT * FROM bets WHERE marketId = ? AND selectionId = ? AND time_signal = 'time_20'
                                """, (marketId, selectionId))
                                base_row = cursor.fetchone()

                                if base_row:
                                    odds_field = {
                                        10: "odds_check_2",
                                        5: "odds_check_1"
                                    }.get(time_mark)

                                    cursor.execute("""
                                        INSERT INTO bets (
                                            marketId, selectionId, horse_name, time_signal, customerOrderRef,
                                            timestamp, date, status, odds, anchor_odd, marketStartTime, meta_json
                                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                                    """, (
                                        marketId, selectionId, base_row[15], signal_tag, customer_order_ref,
                                        datetime.utcnow().isoformat(), datetime.utcnow().strftime("%Y-%m-%d"),
                                        "awaiting_signal", odds, base_row[28], base_row[35], base_row[36]
                                    ))

                                    if odds_field:
                                        cursor.execute(f"""
                                            UPDATE bets SET {odds_field} = ? 
                                            WHERE customerOrderRef = ?
                                        """, (odds, customer_order_ref))

                                    if time_mark == 0:
                                        cursor.execute("""
                                            UPDATE bets SET odds = ?
                                            WHERE customerOrderRef = ?
                                        """, (odds, customer_order_ref))

                                    logging.info(f"🚨 Duplicated {signal_tag} row for {runner_name} from time_20")
                            except Exception:
                                logging.exception(f"❌ Failed to duplicate signal row {signal_tag} for {runner_name}:")

                conn.commit()

        except Exception:
            logging.exception("❌ run_monitor exception:")
        time.sleep(60)

