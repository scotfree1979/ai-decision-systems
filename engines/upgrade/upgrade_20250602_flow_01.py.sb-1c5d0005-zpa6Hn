# -----------------------------
# ✅ BET SETTLEMENT LOOP – Final Step After Bet Placement
# -----------------------------
def bet_settlement():
    logging.info("🧠 [Finalizer] Bet settlement loop launched")
    while True:
        try:
            with sqlite3.connect(DB_PATH) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    SELECT * FROM bets
                    WHERE status = 'bet_placed' AND result IS NULL
                """)
                rows = cursor.fetchall()

                now = datetime.now(timezone.utc)

                # 🧠 Group rows by marketId so we can calculate P&L per market based on winner
                from collections import defaultdict
                market_groups = defaultdict(list)
                for row in rows:
                    market_groups[row[0]].append(row)  # group by marketId

                for marketId, market_rows in market_groups.items():
                    # 👑 Find the winner based on odds = 1.01
                    winner_selection_id = None
                    for r in market_rows:
                        if r[3] == 1.01:
                            winner_selection_id = r[1]  # selectionId
                            break

                    if not winner_selection_id:
                        logging.warning(f"❓ No clear winner found in market {marketId}, skipping")
                        continue

                    for row in market_rows:
                        customerOrderRef = row[33]
                        matched_liability = row[7] or 0
                        unmatched_liability = row[8] or 0
                        stake = row[2] or 0
                        selection_id = row[1]
                        market_start = row[35]

                        try:
                            market_dt = datetime.fromisoformat(market_start.replace("Z", "+00:00"))
                            minutes_after_off = (now - market_dt).total_seconds() / 60
                            if minutes_after_off > 60:
                                logging.warning(f"🕓 Missed P&L window: {customerOrderRef} (>{int(minutes_after_off)} min after off)")
                                cursor.execute("""
                                    UPDATE bets SET
                                        result = 'missed',
                                        pnl = ?,
                                        status = 'settled',
                                        timestamp = ?
                                    WHERE customerOrderRef = ?
                                """, (
                                    -matched_liability,
                                    now.isoformat(),
                                    customerOrderRef
                                ))
                                continue
                        except Exception as t_err:
                            logging.warning(f"⚠️ Could not parse marketStartTime for {customerOrderRef}: {t_err}")
                            continue

                        # 🧾 Calculate P&L for lay bets only (system is lay-focused for now)
                        result = "won" if selection_id != winner_selection_id else "lost"
                        pnl = stake if result == "won" else -matched_liability

                        # 📊 Log outcome to the learning system
                        signal = {
                            "marketId": row[0],
                            "selectionId": selection_id,
                            "customerOrderRef": customerOrderRef,
                            "bet_type": row[4],
                            "bot_name": row[18],
                            "stake": stake,
                            "strategy_name": row[16],
                            "signal_type": row[17]
                        }

                        feedback = {
                            "status": result,
                            "pnl": pnl,
                            "matched_liability": matched_liability,
                            "unmatched_liability": unmatched_liability
                        }

                        # 🧠 Logs feedback into long-term memory for review, dashboarding, and rule evolution
                        log_outcome_feedback(signal, feedback)

                        cursor.execute("""
                            UPDATE bets SET
                                result = ?,
                                pnl = ?,
                                status = 'settled',
                                timestamp = ?
                            WHERE customerOrderRef = ?
                        """, (
                            result,
                            pnl,
                            now.isoformat(),
                            customerOrderRef
                        ))
                        logging.info(f"🏁 Settled: {customerOrderRef} → Result: {result}, PNL: {pnl}")

                conn.commit()
        except Exception as e:
            logging.error(f"❌ [Finalizer] Error during settlement: {e}")
        time.sleep(30)

