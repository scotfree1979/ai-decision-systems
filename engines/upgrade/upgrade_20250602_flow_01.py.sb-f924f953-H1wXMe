"""
🧠 SYSTEM NOTES – DO NOT REMOVE

This file assumes that `get_markets()` has already run, meaning:
- All runners are pre-populated into the `bets` table at the start of the day.
- Each runner has a full metadata row (including event/race/horse names, odds placeholders, meta_json, etc).

run_monitor() does the following:

1. It runs every 60 seconds to track real-time clock-to-off calculations.
2. For each runner, it updates the correct `time_signal`, `status`, odds and odds_check_X fields.
3. No new rows are created before time_10.
4. At time_10, time_5, and time_0:
   - The respective earlier row is duplicated (time_10 from time_20, time_5 from time_10, time_0 from time_5)
   - All fields are copied
   - A new `customerOrderRef` is assigned (basic stub like MKTID_SELECTIONID_10)
   - Status remains 'awaiting_signal'
   - odds_check_2 is set at time_10
   - odds_check_1 is set at time_5
   - odds is updated again at time_0 with final snapshot
5. The current lay price is saved into meta_json under `volatility_checks.signal_tag`

🔁 These duplicate rows are REQUIRED for downstream systems like MarketMonitorSignals.

🛘 DO NOT use customerOrderRef as a lookup condition here.
✅ DO use marketId + selectionId as the only criteria for fetching or updating runner rows.
✅ customerOrderRef in duplicated rows can be overwritten later downstream.
✅ This file never inserts any row until time_10 (i.e., duplication point).
✅ anchor_odd is only set at time_80 – it should always be set regardless of null.
✅ All data is always updated in-place unless explicitly duplicating from prior time signal.
✅ Status should update to 'upcoming' between 90 and 85 minutes before the race.
"""

from database_hijack_monitor import enqueue_write

def run_monitor():
    global SNAPSHOT_DATA
    print("✅ RUN_MONITOR: STARTING")
    try:
        from utils.api_tools import fetch_live_odds
        print("✅ RUN_MONITOR: IMPORTED fetch_live_odds")
    except Exception as e:
        print("❌ RUN_MONITOR: IMPORT FAILED", e)

    import time
    import logging
    import sqlite3
    import json
    from datetime import datetime, timezone
    from config_paths import DB_PATH, SESSION_TOKEN
    from utils.api_tools import fetch_live_odds

    logging.info("🕒 [Thread] run_monitor launched")

    while True:
        try:
            logging.info("🔁 [Monitor] Entered main loop")
            now = datetime.now(timezone.utc)
            logging.info(f"🕒 [Clock Tick] Current UTC time: {now.strftime('%Y-%m-%d %H:%M:%S')} UTC")

            with sqlite3.connect(DB_PATH) as conn:
                conn.row_factory = sqlite3.Row
                cursor = conn.cursor()
                cursor.execute("SELECT * FROM bets WHERE status IN ('pending', 'upcoming', 'awaiting_signal')")
                rows = cursor.fetchall()
                logging.info(f"📆 [DB] Retrieved {len(rows)} runner rows to evaluate")

            for row in rows:
                marketId = row["marketId"]
                selectionId = row["selectionId"]
                runner_name = row["horse_name"] or "Unknown"
                start_time = SNAPSHOT_DATA.get(marketId, {}).get("start_time")

                if not start_time:
                    raw_time = row["marketStartTime"]
                    try:
                        start_time = datetime.fromisoformat(raw_time.replace("Z", "+00:00"))
                        SNAPSHOT_DATA[marketId] = {"start_time": start_time}
                    except:
                        logging.warning(f"⚠️ Could not parse fallback start_time for {marketId}")
                        continue

                minutes_to_off = int((start_time - now).total_seconds() / 60)
                if minutes_to_off == 999:
                    logging.warning(f"⚠️ No snapshot clock for {marketId}, skipping.")
                    continue

                # ✅ Update status to match clock window
                correct_status = "upcoming" if 85 < minutes_to_off <= 90 else "pending" if minutes_to_off > 90 else None
                if correct_status and row["status"] != correct_status:
                    enqueue_write("""
                        UPDATE bets SET status = ?
                        WHERE marketId = ? AND selectionId = ?
                    """, (correct_status, marketId, selectionId))

                if minutes_to_off > 90:
                    continue

                logging.info(f"⏱️ [Runner Clock] {runner_name} → T-{int(minutes_to_off)} mins")

                for time_mark, signal_tag in zip([80, 60, 40, 20, 10, 5, 0],
                                                 ["time_80", "time_60", "time_40", "time_20", "time_10", "time_5", "time_0"]):
                    gap = 20 if time_mark >= 20 else 5
                    if abs(minutes_to_off - time_mark) > gap:
                        continue

                    customer_order_ref = f"{marketId[-5:]}_{selectionId}_{time_mark}"[:32]
                    odds_data = fetch_live_odds(marketId=marketId, selectionId=selectionId, session_token=SESSION_TOKEN)
                    odds = odds_data["lay"] if odds_data else None
                    if odds is None:
                        logging.warning(f"🕓 [Missed Odds] {runner_name} – T-{minutes_to_off} mins – odds unavailable.")
                        continue

                    if time_mark in [80, 60, 40, 20]:
                        odds_field = {
                            80: "odds_check_6",
                            60: "odds_check_5",
                            40: "odds_check_4",
                            20: "odds_check_3"
                        }[time_mark]

                        update_status = row["status"]  # No change unless explicitly at time_20

                        enqueue_write(f"""
                            UPDATE bets SET 
                                odds = ?, 
                                {odds_field} = ?, 
                                time_signal = ?, 
                                timestamp = ?, 
                                status = ?
                            WHERE marketId = ? AND selectionId = ?
                        """, (odds, odds, signal_tag, datetime.utcnow().isoformat(), update_status, marketId, selectionId))

                        if time_mark == 80:
                            enqueue_write("""
                                UPDATE bets SET anchor_odd = ?
                                WHERE marketId = ? AND selectionId = ?
                            """, (odds, marketId, selectionId))

                        logging.info(f"📌 [Hijacked] Signal written: {signal_tag} → {runner_name} @ {odds}")

                    if time_mark in [10, 5, 0]:
                        base_time = {10: "time_20", 5: "time_10", 0: "time_5"}[time_mark]
                        try:
                            with sqlite3.connect(DB_PATH) as conn:
                                conn.row_factory = sqlite3.Row
                                cursor = conn.cursor()
                                cursor.execute(f"""
                                    SELECT * FROM bets WHERE marketId = ? AND selectionId = ? AND time_signal = ?
                                """, (marketId, selectionId, base_time))
                                base_row = cursor.fetchone()

                            if not base_row:
                                logging.warning(f"⚠️ [Duplication Skipped] No {base_time} row found for {runner_name} at {signal_tag}")
                                continue

                            columns = base_row.keys()
                            insert_dict = {col: base_row[col] for col in columns}

                            meta_data = {}
                            try:
                                meta_data = json.loads(insert_dict.get("meta_json") or "{}")
                            except:
                                pass

                            if "volatility_checks" not in meta_data:
                                meta_data["volatility_checks"] = {}
                            meta_data["volatility_checks"][signal_tag] = odds
                            insert_dict["meta_json"] = json.dumps(meta_data)

                            insert_dict.update({
                                "time_signal": signal_tag,
                                "customerOrderRef": customer_order_ref,
                                "timestamp": datetime.utcnow().isoformat(),
                                "status": "awaiting_signal",
                                "bot_name": None,
                                "matched_liability": None,
                                "unmatched_liability": None,
                                "liability": None,
                                "pnl": None,
                                "betfair_bet_id": None,
                                "bet_settled": None,
                                "can_accept_liability": None,
                                "strategy_name": None,
                                "signal_type": None,
                                "stake": None,
                                "bet_type": None,
                                "placed_at": None,
                                "odds": odds
                            })

                            if time_mark == 10:
                                insert_dict["odds_check_2"] = odds
                            elif time_mark == 5:
                                insert_dict["odds_check_1"] = odds

                            insert_cols = ", ".join(insert_dict.keys())
                            placeholders = ", ".join(["?" for _ in insert_dict])
                            enqueue_write(f"""
                                INSERT INTO bets ({insert_cols}) VALUES ({placeholders})
                            """, list(insert_dict.values()))

                            logging.info(f"🚨 [Hijacked] Duplicated {signal_tag} → {runner_name}")

                        except Exception:
                            logging.exception(f"❌ Failed to duplicate signal row {signal_tag} for {runner_name}:")

        except Exception:
            logging.exception("❌ run_monitor exception:")
        run_monitor_ready.set()
        time.sleep(60)

# ────────────────────────────────────────────────────────────────────────────────
# Helper Unique CustomerOrderRef Builder
# ────────────────────────────────────────────────────────────────────────────────

_letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
_suffix_index = 0  # ensure global is initialized only once

def _next_suffix():
    global _suffix_index
    import sqlite3
    from config_paths import DB_PATH

    if _suffix_index == 0:
        with sqlite3.connect(DB_PATH) as conn:
            conn.row_factory = sqlite3.Row
            refs = conn.execute(
                "SELECT customerOrderRef FROM bets WHERE customerOrderRef LIKE '__%'"
            ).fetchall()
            max_found = 0
            for row in refs:
                try:
                    prefix = row["customerOrderRef"].split("_")[0]
                    a, b, num = prefix[0], prefix[1], prefix[2:]
                    base = (ord(a) - 65) * 26 * 1000 + (ord(b) - 65) * 1000 + int(num)
                    max_found = max(max_found, base)
                except:
                    continue
            _suffix_index = max_found + 1

    code = _suffix_index
    _suffix_index += 1

    a_index = (code // 1000) // 26
    b_index = (code // 1000) % 26

    # 🔐 SAFETY CHECK
    if a_index >= len(_letters) or b_index >= len(_letters):
        raise ValueError("💥 _next_suffix() exhausted code space — increase letter base or reset")

    return f"{_letters[a_index]}{_letters[b_index]}{code % 1000:03}"


