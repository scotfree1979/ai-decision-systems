                               marketStartTime, meta_json, test_mode
                        FROM bets WHERE customerOrderRef = ?
                        """,
                        (d["stake"], d["bet_type"], d["placed_at"], bot, dup_ref, d["base_ref"])
                    )
                    logging.info("📄 [SignalMonitor] Duplication made → %s as %s", bot, dup_ref)

                enqueue_write(
                    "UPDATE bets SET status='fully_enriched' WHERE customerOrderRef = ?",
                    (d["base_ref"],)
                )
                pending_duplications.remove(d)

