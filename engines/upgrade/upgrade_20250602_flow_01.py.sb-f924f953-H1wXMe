def signal_monitor():
    import sqlite3, logging, time
    from datetime import datetime
    from config_paths import DB_PATH
    from database_hijack_monitor import enqueue_write
    from upgrade_import_patch import signal_monitor_ready, risk_system_ready

    logging.info("🔮 signal_monitor() starting – 10 seconds grace period …")
    time.sleep(10)

    first_pass = True
    pending_duplications = []

    while True:
        try:
            logging.info("📬 [SignalMonitor] Checking for base-eligible rows...")
            with sqlite3.connect(DB_PATH, timeout=10) as conn:
                conn.row_factory = sqlite3.Row
                rows = conn.execute(
                    "SELECT rowid, * FROM bets WHERE status = 'signal_assigned'"
                ).fetchall()

            logging.info("📊 [SignalMonitor] Found %d rows with status='signal_assigned'", len(rows))

            now = datetime.utcnow().isoformat()

            for r in rows:
                if not r["odds_check_6"]:
                    logging.info("⏭️ [SignalMonitor] Skipping row: %s/%s – missing odds_check_6", r["marketId"], r["selectionId"])
                    continue

                m_id = r["marketId"]
                sel_id = r["selectionId"]
                strategy = (r["strategy_name"] or "").strip().lower()
                rule = SIGNAL_RULES.get(strategy)
                if not rule:
                    continue

                stake_cfg = rule["stake"]
                stake = stake_cfg.get(r["time_signal"]) if isinstance(stake_cfg, dict) else stake_cfg
                bots = rule["bots"][:1] if rule.get("limit") == 1 else rule["bots"]

                base_suffix = _next_suffix()
                base_ref = f"{base_suffix}_{bots[0][:3].upper()}"
                logging.info("📅 [SignalMonitor] Signal assigned row → %s", base_ref)

                enqueue_write(
                    """
                    UPDATE bets SET
                        stake = ?,
                        bet_type = ?,
                        placed_at = ?,
                        customerOrderRef = ?,
                        bot_name = ?,
                        status = ?
                    WHERE rowid = ?
                    """,
                    (stake, rule["bet_type"], now, base_ref, bots[0], 'processed', r["rowid"])
                )

                pending_duplications.append({
                    "base_ref": base_ref,
                    "stake": stake,
                    "bot_list": bots[1:],
                    "bet_type": rule["bet_type"],
                    "placed_at": now
                })

            for d in pending_duplications[:]:
                with sqlite3.connect(DB_PATH, timeout=10) as conn:
                    conn.row_factory = sqlite3.Row
                    result = conn.execute(
                        "SELECT * FROM bets WHERE customerOrderRef = ? AND status = 'processed'",
                        (d["base_ref"],)
                    ).fetchone()

                if not result:
                    logging.info("⏳ [SignalMonitor] Waiting to duplicate %s — base not ready yet", d["base_ref"])
                    continue

                for bot in d["bot_list"]:
                    dup_suffix = _next_suffix()
                    dup_ref = f"{dup_suffix}_{bot[:3].upper()}"
                    logging.info("🔁 [SignalMonitor] Duplicating %s → %s", d["base_ref"], dup_ref)

                    enqueue_write(
                        """
                        INSERT OR IGNORE INTO bets (
                            marketId, selectionId, stake, odds, bet_type, placed_at, status,
                            matched_liability, unmatched_liability, pnl, liability, result,
                            timestamp, matched_timestamp, betfair_bet_id, horse_name,
