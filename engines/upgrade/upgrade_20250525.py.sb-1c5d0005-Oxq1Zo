def run_monitor():
    logging.info("🧭 Starting run_monitor() – tracking all countdowns")
    now = get_simulated_now()
    logging.info(f"🕓 Current system clock (UTC): {now.strftime('%H:%M')}")
    session_token = os.environ.get("SESSION_TOKEN", "NO_TOKEN")

    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT * FROM bets WHERE time_signal IS NULL OR time_signal = 'time_80'")
        rows = cursor.fetchall()

        for row in rows:
            market_id = row[0]
            selection_id = row[1]
            runner_name = row[15] if row[15] else "Unknown"
            market_start = datetime.fromisoformat(row[35].replace("Z", "+00:00"))
            minutes_to_off = (market_start - now).total_seconds() / 60

            # 🧹 Skip races older than 5 mins past post time
            if minutes_to_off < -5:
                cursor.execute("""
                    UPDATE bets SET status = 'ended', time_signal = 'ended' 
                    WHERE marketId = ? AND selectionId = ?
                """, (market_id, selection_id))
                continue

            # ✅ Skip rows too early to process
            if minutes_to_off > 85 and row[20] != 'time_80':
                cursor.execute("""
                    UPDATE bets SET time_signal = NULL 
                    WHERE marketId = ? AND selectionId = ?
                """, (market_id, selection_id))
                continue

            location_label = f"{runner_name} – Off at {market_start.strftime('%H:%M')} UTC (Betfair) – Internal Clock: {int(minutes_to_off)} min to off"
            logging.info(location_label)

            for time_mark, signal_tag in zip([80, 60, 40, 20, 10, 5, 0],
                                             ["time_80", "time_60", "time_40", "time_20", "time_10", "time_5", "time_0"]):
                if abs(minutes_to_off - time_mark) > 2:
                    continue

                logging.debug(f"⏱️ Matched session window for {runner_name} at {signal_tag} (±2min)")
                customer_order_ref = f"{market_id[-5:]}_{selection_id}_{time_mark}"[:32]
                cursor.execute("SELECT 1 FROM bets WHERE customerOrderRef = ?", (customer_order_ref,))
                exists = cursor.fetchone()

                latest_odds = fetch_live_odds(session_token, market_id, selection_id)
                logging.debug(f"💡 Latest odds for {runner_name}: {latest_odds}")
                if latest_odds is None:
                    logging.warning(f"⚠️ Skipping {runner_name} due to missing odds.")
                    continue

                if time_mark in [80, 60, 40]:
                    if not exists:
                        try:
                            cursor.execute("""
                                INSERT INTO bets (
                                    marketId, selectionId, horse_name, time_signal, customerOrderRef, timestamp,
                                    date, status, odds, anchor_odd, marketStartTime
                                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                            """, (
                                market_id, selection_id, runner_name, signal_tag, customer_order_ref,
                                datetime.utcnow().isoformat(), datetime.utcnow().strftime("%Y-%m-%d"),
                                "pending", latest_odds, latest_odds, market_start.isoformat()
                            ))
                            logging.info(f"➕ Inserted {signal_tag} row for {runner_name} @ {latest_odds}")
                        except Exception as e:
                            logging.error(f"❌ Failed to insert {signal_tag} for {runner_name}: {e}")
                    else:
                        try:
                            odds_field = {
                                80: "odds_check_6",
                                60: "odds_check_5",
                                40: "odds_check_4"
                            }[time_mark]
                            cursor.execute(f"""
                                UPDATE bets SET odds = ?, anchor_odd = ?, {odds_field} = ?, timestamp = ?, time_signal = ?
                                WHERE customerOrderRef = ?
                            """, (latest_odds, latest_odds, latest_odds, datetime.utcnow().isoformat(), signal_tag, customer_order_ref))
                            logging.info(f"🔁 Updated {signal_tag} row for {runner_name} @ {latest_odds}")
                        except Exception as e:
                            logging.error(f"❌ Failed to update odds at {signal_tag} for {runner_name}: {e}")

                if time_mark in [20, 10, 5, 0] and not exists:
                    try:
                        cursor.execute("""
                            INSERT INTO bets (
                                marketId, selectionId, horse_name, time_signal, customerOrderRef,
                                timestamp, date, status, odds, anchor_odd, marketStartTime
                            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                        """, (
                            market_id, selection_id, runner_name, signal_tag, customer_order_ref,
                            datetime.utcnow().isoformat(), datetime.utcnow().strftime("%Y-%m-%d"),
                            "awaiting_signal", latest_odds, latest_odds, market_start.isoformat()
                        ))
                        logging.info(f"🧨 Triggered {signal_tag} for {runner_name} @ {latest_odds}")
                    except Exception as e:
                        logging.error(f"❌ Failed to trigger signal row {signal_tag} for {runner_name}: {e}")

        conn.commit()

