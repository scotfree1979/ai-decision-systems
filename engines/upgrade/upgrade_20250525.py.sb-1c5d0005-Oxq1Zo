# 🔒 IMPORTANT:
# We assume marketStartTime is always present.
# If it is NULL or fails to parse in run_monitor or backfill, that runner is skipped.
# This ensures automation continues without stalling on incomplete market metadata.


def get_simulated_now():
    if not TEST_MODE:
        try:
            response = requests.get("http://worldtimeapi.org/api/timezone/Etc/UTC", timeout=2)
            if response.status_code == 200:
                external = response.json().get("utc_datetime")
                if external:
                    return datetime.fromisoformat(external.replace("Z", "+00:00"))
        except Exception as e:
            logging.warning(f"⚠️ External UTC fallback failed, reverting to system clock: {e}")
        return datetime.utcnow().replace(tzinfo=timezone.utc)
    elapsed_real = (datetime.utcnow() - TEST_START_TIME).total_seconds()
    simulated_minutes = (elapsed_real / (SIMULATED_DURATION_MIN * 60)) * SIMULATED_TOTAL_MINUTES
    return (TEST_START_TIME + timedelta(minutes=simulated_minutes)).replace(tzinfo=timezone.utc)

