def validate_bets_table():
    logging.info("🧱 Validating bets table structure...")
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS bets (
                marketId TEXT,
                selectionId INTEGER,
                horse_name TEXT,
                customerOrderRef TEXT,
                timestamp TEXT,
                date TEXT,
                status TEXT,
                event_name TEXT,
                race_name TEXT,
                marketStartTime TEXT,
                odds_check_6 REAL,
                odds_check_1 REAL,
                anchor_odd REAL,
                time_80 TEXT,
                time_60 TEXT,
                time_40 TEXT,
                time_20 TEXT,
                time_10 TEXT,
                time_5 TEXT,
                time_0 TEXT,
                odds REAL,
                strategy_name TEXT,
                signal_type TEXT,
                bot_name TEXT,
                bet_type TEXT,
                PRIMARY KEY (marketId, selectionId, customerOrderRef)
            )
        """)
        conn.commit()

