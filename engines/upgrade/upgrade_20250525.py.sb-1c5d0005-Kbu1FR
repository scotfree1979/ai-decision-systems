def log_runners_to_db(markets):
    logging.info("📥 Caching market + runner metadata (no bets inserted)...")
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS runner_cache (
                marketId TEXT,
                selectionId INTEGER,
                runnerName TEXT,
                marketStartTime TEXT,
                eventName TEXT,
                raceName TEXT,
                marketName TEXT,
                UNIQUE(marketId, selectionId)
            )
        """)

        for market in markets:
            for runner in market.get("runners", []):
                try:
                    cursor.execute("""
                        INSERT OR IGNORE INTO runner_cache (
                            marketId, selectionId, runnerName, marketStartTime,
                            eventName, raceName, marketName
                        ) VALUES (?, ?, ?, ?, ?, ?, ?)
                    """, (
                        market["marketId"],
                        runner["selectionId"],
                        runner["runnerName"],
                        market["marketStartTime"],
                        market["event"]["name"],
                        market["marketName"],
                        market["marketName"]
                    ))
                except Exception as e:
                    logging.error(f"❌ Failed to insert runner metadata: {e}")

        conn.commit()
        logging.info("✅ Runner metadata cached.")

