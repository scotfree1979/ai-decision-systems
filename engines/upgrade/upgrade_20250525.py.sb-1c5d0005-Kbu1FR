# -----------------------------
# ✅ SIGNAL DETECTOR (market_monitor_signals)
# -----------------------------

def market_monitor_signals():
    logging.info("📡 Running market_monitor_signals() to detect new signals")
    now = get_simulated_now()

    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()

        cursor.execute("""
            SELECT * FROM bets
            WHERE status = 'awaiting_signal'
        """)
        rows = cursor.fetchall()

        for row in rows:
            market_id = row[0]
            selection_id = row[1]
            runner_name = row[15]
            time_signal = row[20]
            customer_ref = row[33]
            anchor_odd = row[26]
            odds_check_1 = row[27]
            odds_check_2 = row[28]
            odds_check_3 = row[29]

            # Determine current odds snapshot based on time window
            if time_signal == "time_20":
                current_odds = odds_check_3
            elif time_signal == "time_10":
                current_odds = odds_check_2
            elif time_signal == "time_5":
                current_odds = odds_check_1
            elif time_signal == "time_0":
                current_odds = anchor_odd
            else:
                continue

            # Safety check
            if anchor_odd is None or current_odds is None:
                logging.info(f"⏩ Skipping {runner_name} – odds incomplete")
                continue

            signal_type = detect_signal(anchor_odd, current_odds)
            if not signal_type:
                continue

            # Check for prior identical signal (same type, time_signal, runner) within 45s
            cursor.execute("""
                SELECT timestamp FROM bets
                WHERE marketId = ? AND selectionId = ? AND signal_type = ? AND time_signal = ?
                ORDER BY timestamp DESC LIMIT 1
            """, (market_id, selection_id, signal_type, time_signal))

            recent = cursor.fetchone()
            if recent:
                last_ts = datetime.fromisoformat(recent[0].replace("Z", "+00:00"))
                diff = (now - last_ts).total_seconds()
                if diff < 45:
                    logging.info(f"🔁 Skipping duplicate signal for {runner_name} ({signal_type}) – triggered {int(diff)}s ago")
                    continue

            # Duplicate row with new customerOrderRef and mark signal_type
            new_ref = f"{customer_ref[:28]}_{signal_type[:3].upper()}"
            try:
                cursor.execute("""
                    INSERT INTO bets (
                        marketId, selectionId, stake, odds, bet_type, placed_at, status,
                        matched_liability, unmatched_liability, pnl, liability, result,
                        timestamp, matched_timestamp, betfair_bet_id, horse_name,
                        strategy_name, signal_type, bot_name, date, time_signal,
                        can_accept_liability, time_session, race_name, market_name, event_name,
                        anchor_odd, odds_check_1, odds_check_2, odds_check_3, odds_check_4,
                        odds_check_5, odds_check_6, customerOrderRef, bet_settled,
                        marketStartTime, meta_json, test_mode
                    )
                    SELECT
                        marketId, selectionId, stake, odds, bet_type, placed_at, 'signal_assigned',
                        matched_liability, unmatched_liability, pnl, liability, result,
                        ?, matched_timestamp, betfair_bet_id, horse_name,
                        NULL, ?, NULL, date, time_signal,
                        can_accept_liability, time_session, race_name, market_name, event_name,
                        anchor_odd, odds_check_1, odds_check_2, odds_check_3, odds_check_4,
                        odds_check_5, odds_check_6, ?, bet_settled,
                        marketStartTime, meta_json, test_mode
                    FROM bets WHERE customerOrderRef = ?
                """, (now.isoformat(), signal_type, new_ref, customer_ref))

                logging.info(f"📌 Signal Created: {signal_type} for {runner_name} ({new_ref})")
            except Exception as e:
                logging.error(f"❌ Failed to assign signal for {runner_name}: {e}")

        conn.commit()

