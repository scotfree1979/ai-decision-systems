def run_monitor():
    logging.info("🧭 Starting run_monitor() – tracking all countdowns")
    now = get_simulated_now()
    session_token = os.environ.get("SESSION_TOKEN", "NO_TOKEN")

    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT * FROM runner_cache")
        runners = cursor.fetchall()

        for runner in runners:
            market_id = runner[0]
            selection_id = runner[1]
            runner_name = runner[2]
            market_start = datetime.fromisoformat(runner[3].replace("Z", "+00:00"))
            minutes_to_off = (market_start - now).total_seconds() / 60

            for time_mark, signal_tag in zip([80, 60, 40, 20, 10, 5, 0],
                                             ["time_80", "time_60", "time_40", "time_20", "time_10", "time_5", "time_0"]):
                if not in_session_window(minutes_to_off, time_mark):
                    continue

                customer_order_ref = f"{market_id[-5:]}_{selection_id}_{time_mark}"[:32]
                cursor.execute("SELECT 1 FROM bets WHERE customerOrderRef = ?", (customer_order_ref,))
                exists = cursor.fetchone()

                latest_odds = fetch_live_odds(session_token, market_id, selection_id)
                if latest_odds is None:
                    continue

                # Update-only for 80, 60, 40 (single base row)
                if time_mark in [80, 60, 40]:
                    if not exists:
                        try:
                            cursor.execute("""
                                INSERT INTO bets (
                                    marketId, selectionId, horse_name, time_signal, customerOrderRef, timestamp,
                                    date, status, odds, anchor_odd, marketStartTime
                                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                            """, (
                                market_id, selection_id, runner_name, signal_tag, customer_order_ref,
                                datetime.utcnow().isoformat(), datetime.utcnow().strftime("%Y-%m-%d"),
                                "pending", latest_odds, latest_odds, runner[3]
                            ))
                            logging.info(f"➕ Inserted {signal_tag} row for {runner_name} @ {latest_odds}")
                        except Exception as e:
                            logging.error(f"❌ Failed to insert {signal_tag} for {runner_name}: {e}")
                    else:
                        try:
                            odds_field = {
                                80: "odds_check_6",
                                60: "odds_check_5",
                                40: "odds_check_4"
                            }[time_mark]
                            cursor.execute(f"""
                                UPDATE bets SET odds = ?, anchor_odd = ?, {odds_field} = ?, timestamp = ?
                                WHERE customerOrderRef = ?
                            """, (latest_odds, latest_odds, latest_odds, datetime.utcnow().isoformat(), customer_order_ref))
                            logging.info(f"🔁 Updated {signal_tag} row for {runner_name} @ {latest_odds}")
                        except Exception as e:
                            logging.error(f"❌ Failed to update odds at {signal_tag} for {runner_name}: {e}")

                # Starting at 20 minutes, insert a new row for signal triggering
                if time_mark in [20, 10, 5, 0] and not exists:
                    try:
                        cursor.execute("""
                            INSERT INTO bets (
                                marketId, selectionId, horse_name, time_signal, customerOrderRef,
                                timestamp, date, status, odds, anchor_odd, marketStartTime
                            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                        """, (
                            market_id, selection_id, runner_name, signal_tag, customer_order_ref,
                            datetime.utcnow().isoformat(), datetime.utcnow().strftime("%Y-%m-%d"),
                            "awaiting_signal", latest_odds, latest_odds, runner[3]
                        ))
                        logging.info(f"🧨 Triggered {signal_tag} for {runner_name} @ {latest_odds}")
                    except Exception as e:
                        logging.error(f"❌ Failed to trigger signal row {signal_tag} for {runner_name}: {e}")

        conn.commit()

