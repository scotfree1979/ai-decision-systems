def launch_protocol():
    with signal_queue.mutex:
        signal_queue.queue.clear()
    for q in bot_signal_queues.values():
        with q.mutex:
            q.queue.clear()
    logging.info("✅ System boot sequence complete.")

def queue_monitor():
    import time
    import queue
    while True:
        try:
            signal = signal_queue.get(timeout=1)
            process_signal(signal)
        except queue.Empty:
            continue

