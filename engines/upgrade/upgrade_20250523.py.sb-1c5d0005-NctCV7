import os
import sys
import logging
from datetime import datetime, timedelta
from queue import Queue
import threading
import time
import requests
import json

sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    force=True
)

signal_queue = Queue()
TOTAL_PNL = 0

bot_signal_queues = {
    "OGHeadTrader": Queue(),
    "OGPreoff": Queue(),
    "OGInPlay": Queue()
}

USE_MARKET_TYPE_FILTER = True
USE_RUNNER_COUNT_FILTER = False

def launch_protocol():
    with signal_queue.mutex:
        signal_queue.queue.clear()
    for q in bot_signal_queues.values():
        with q.mutex:
            q.queue.clear()
    logging.info("✅ System boot sequence complete.")

def log_system_initialization():
    for msg in [
        "✅ Market Monitor Initialized",
        "✅ Signal Monitor Active",
        "✅ Risk Manager Engaged",
        "✅ Budget Manager Online",
        "✅ Bot Queues Live",
        "✅ Thread Launch Confirmed"]:
        logging.info(msg)

def create_signal(market_id, selection_id, strategy_name, time_session):
    return {
        "marketId": market_id,
        "selectionId": selection_id,
        "strategy_name": strategy_name,
        "time_session": time_session,
        "timestamp": datetime.utcnow().isoformat(),
        "stake": 5.0,
        "confidence": 1.0,
        "status": "pending"
    }

def normalize_market_time(market_start):
    try:
        return datetime.strptime(market_start, "%Y-%m-%dT%H:%M:%S.%fZ")
    except ValueError:
        return datetime.strptime(market_start, "%Y-%m-%dT%H:%M:%SZ")

def upgrade_monitor():
    print("🐛 DEBUG: upgrade_monitor() called from upgrade_20250523.py")
    log_system_initialization()
    session_token = os.environ.get("SESSION_TOKEN", "NO_TOKEN")

    while True:
        try:
            from upgrade.upgrade_20250522 import wrap_run_monitor
            markets = []

            print("🚀 Sending request to Betfair API...")
            response = requests.post(
                "https://api.betfair.com/exchange/betting/json-rpc/v1",
                headers={
                    "X-Application": "CZHojduNWa3kxWIn",
                    "X-Authentication": session_token,
                    "Content-Type": "application/json"
                },
                data=json.dumps([
                    {
                        "jsonrpc": "2.0",
                        "method": "SportsAPING/v1.0/listMarketCatalogue",
                        "params": {
                            "filter": {
                                "eventTypeIds": ["7"],
                                "marketCountries": ["GB", "IE"],
                                **({"marketTypeCodes": ["WIN"]} if USE_MARKET_TYPE_FILTER else {}),
                                "marketStartTime": {
                                    "from": datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
                                    "to": (datetime.utcnow() + timedelta(days=1)).strftime("%Y-%m-%dT%H:%M:%SZ")
                                }
                            },
                            "marketProjection": ["RUNNER_DESCRIPTION", "MARKET_START_TIME"],
                            "maxResults": "200"
                        },
                        "id": 1
                    }
                ])
            )

            raw_markets = response.json()[0].get("result", []) if response.status_code == 200 else []
            print(f"📦 Raw markets fetched: {len(raw_markets)}")

            for m in raw_markets:
                try:
                    start_time_raw = m.get('marketStartTime') or m.get('marketStartTimeUtc')
                    if not start_time_raw:
                        raise KeyError("marketStartTime missing")

                    market_time = normalize_market_time(start_time_raw)
                    seconds_to_off = (market_time - datetime.utcnow()).total_seconds()
                    if seconds_to_off > 4800:
                        if len(m.get('runners', [])) <= 7:
                            print(f"⛔ Skipped (<=7 runners): {m['marketName']}")
                            continue
                        print(f"✅ Market accepted: {m['marketName']} | Off in {int(seconds_to_off / 60)} min")
                        markets.append(m)
                except Exception as e:
                    print(f"⚠️ Skipped market due to bad startTime: {m.get('marketName', 'unknown')} | Error: {e}")

            print(f"🎯 Filter complete: {len(markets)} markets ready")
            if not markets:
                print("⚠️ No markets met the criteria after filtering. Skipping wrap_run_monitor.")
            else:
                for market in markets:
                    market_id = market['marketId']
                    market_time = normalize_market_time(market['marketStartTime'])
                    for runner in market['runners']:
                        selection_id = runner['selectionId']
                        signal = create_signal(
                            market_id=market_id,
                            selection_id=selection_id,
                            strategy_name="Green-Up",
                            time_session=999
                        )
                        signal["marketId"] = market_id
                        signal["selectionId"] = selection_id
                        signal["timestamp"] = datetime.utcnow().isoformat()
                        signal["stake"] = 5.0
                        signal["confidence"] = 1.0
                        signal["status"] = "pending"
                        signal_queue.put(signal)
                        print(f"📤 Signal created | Market: {market['marketName']} | Runner: {selection_id}")

                wrap_run_monitor(signal_queue, session_token, markets)
                print("🔁 wrap_run_monitor() completed successfully")

        except Exception as e:
            print(f"🛑 Unhandled exception during upgrade_monitor: {e}")
            print("🧠 Please consult AI for assistance with this error stack.")

        print("🔄 [Upgrade] Run Monitor Cycle Complete")
        if datetime.utcnow().hour < 5:
            print("🌍 [Filter] Returning to GB/IE-only filtering tomorrow.")
            break

        time.sleep(60)
