# 4️⃣ Run Monitor for Time-Based Enrichment
# -----------------------------
def run_monitor(time_step):
    """
    Enrich runners by capturing odds snapshots and updating time fields.
    Anchor odds are updated at every step, replaced by the current odds.
    Odds checks are filled progressively: 6 → 5 → 4 → ... → 1
    """
    logging.info(f"🔄 Enriching runners at step {time_step}...")
    now = get_simulated_now()
    buffer = timedelta(minutes=2)

    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT * FROM bets WHERE marketStartTime IS NOT NULL")
        rows = cursor.fetchall()
        columns = [description[0] for description in cursor.description]

        for row in rows:
            record = dict(zip(columns, row))

            if record.get(f"time_{time_step}") is not None:
                continue  # Already enriched at this step

            market_time = datetime.fromisoformat(record['marketStartTime'])
            minutes_to_off = (market_time - now).total_seconds() / 60

            if abs(minutes_to_off - time_step) > 2:
                continue

            # Fetch live odds using get_market_book
            try:
                market_book = get_market_book(record['marketId'])
                runner_book = next((r for r in market_book if r['selectionId'] == record['selectionId']), None)
                current_odds = runner_book['lastPriceTraded'] if runner_book else None

                if current_odds is None:
                    logging.warning(f"⚠️ No odds found for {record['customerOrderRef']} – skipping")
                    continue
            except Exception as e:
                logging.error(f"❌ Failed to fetch market odds: {e}")
                continue

            odds_check_field = f"odds_check_{min(6, time_step // 10)}" if time_step >= 10 else "odds_check_1"

            # Update anchor_odd and odds_check_x dynamically
            try:
                cursor.execute(f"""
                    UPDATE bets
                    SET time_{time_step} = ?,
                        {odds_check_field} = ?,
                        anchor_odd = ?,
                        odds = ?
                    WHERE marketId = ? AND selectionId = ? AND customerOrderRef = ?
                """, (
                    now.isoformat(),
                    current_odds,
                    current_odds,
                    current_odds,
                    record['marketId'],
                    record['selectionId'],
                    record['customerOrderRef']
                ))
                logging.info(f"📈 Odds updated for {record['customerOrderRef']} at step {time_step}")
            except Exception as e:
                logging.error(f"❌ Odds enrichment failed: {e}")

        conn.commit()

    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT * FROM bets WHERE marketStartTime IS NOT NULL")
        rows = cursor.fetchall()
        columns = [description[0] for description in cursor.description]

        for row in rows:
            record = dict(zip(columns, row))

            if record.get(f"time_{time_step}") is not None:
                continue  # Already enriched at this step

            market_time = datetime.fromisoformat(record['marketStartTime'])
            minutes_to_off = (market_time - now).total_seconds() / 60

            if abs(minutes_to_off - time_step) > 2:
                continue  # Outside valid enrichment window

            # Inject into signal queue and enrich
            signal = record.copy()
            signal_queue.put(signal)
            enriched_signal = process_signal(signal)
            evaluated_signal = evaluate_signal(enriched_signal)

            if evaluated_signal.get("place_bet"):
                # Duplicate and insert new row for placed bet
                new_ref = f"{record['customerOrderRef']}_T{time_step}"
                bet_time = datetime.utcnow().isoformat()

                try:
                    cursor.execute("""
                        INSERT OR IGNORE INTO bets (
                            marketId, selectionId, horse_name, customerOrderRef, timestamp, date,
                            status, event_name, race_name, marketStartTime,
                            odds_check_6, odds_check_1, anchor_odd,
                            time_80, time_60, time_40, time_20, time_10, time_5, time_0
                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """, (
                        record['marketId'],
                        record['selectionId'],
                        record['horse_name'],
                        new_ref,
                        bet_time,
                        record['date'],
                        "placed",
                        record['event_name'],
                        record['race_name'],
                        record['marketStartTime'],
                        enriched_signal.get('odds_check_6'),
                        enriched_signal.get('odds_check_1'),
                        enriched_signal.get('anchor_odd'),
                        bet_time if time_step == 80 else None,
                        bet_time if time_step == 60 else None,
                        bet_time if time_step == 40 else None,
                        bet_time if time_step == 20 else None,
                        bet_time if time_step == 10 else None,
                        bet_time if time_step == 5 else None,
                        bet_time if time_step == 0 else None
                    ))
                    logging.info(f"✅ Bet placed and row duplicated: {new_ref}")
                except Exception as e:
                    logging.error(f"❌ Failed to insert placed bet row: {e}")

            else:
                # Update original row’s time field only
                try:
                    cursor.execute(f"""
                        UPDATE bets SET time_{time_step} = ?
                        WHERE marketId = ? AND selectionId = ? AND customerOrderRef = ?
                    """, (
                        datetime.utcnow().isoformat(),
                        record['marketId'],
                        record['selectionId'],
                        record['customerOrderRef']
                    ))
                    logging.info(f"🕒 Time step {time_step} updated for {record['customerOrderRef']}")
                except Exception as e:
                    logging.error(f"❌ Failed to update time_{time_step}: {e}")

        conn.commit()

