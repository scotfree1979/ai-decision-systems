# ULTIMATE PATCH – PART 1: SETUP & VALID MARKET FILTER
import logging
import json
import requests
import time
import datetime
from bet_core import place_bet, calculate_tick, round_to_valid_odds, green_up
def get_market_book(session_token, market_id):
    headers = {
        'X-Authentication': session_token,
        'Content-Type': 'application/json'
    }
    payload = [{
        "jsonrpc": "2.0",
        "method": "SportsAPING/v1.0/listMarketBook",
        "params": {
            "marketIds": [market_id],
            "priceProjection": {"priceData": ["EX_BEST_OFFERS"]}
        },
        "id": 1
    }]
    response = requests.post("https://api.betfair.com/exchange/betting/json-rpc/v1", headers=headers, data=json.dumps(payload)).json()
    return response[0]['result'][0] if 'result' in response[0] else None


def place_basic_lay_bet(signal):
    session_token = signal['session_token']
    market_id = signal['marketId']
    selection_id = signal['selectionId']
    odds = signal['odds']
    stake = signal['stake']
    customer_order_ref = signal.get('customerOrderRef', f"BASIC-{selection_id}-{int(time.time())}")

    logging.info(f"💸 [BasicLay] Laying {selection_id} @ {odds} (£{stake})")
    place_bet(session_token, market_id, selection_id, stake, odds, "LAY", customer_order_ref)

def place_ladder_lay_bet(signal):
    session_token = signal['session_token']
    market_id = signal['marketId']
    selection_id = signal['selectionId']
    base_odds = signal['odds']
    total_stake = signal['stake']
    anchor_stake = total_stake / 5
    tick = calculate_tick(base_odds)
    customer_order_ref = signal.get('customerOrderRef', f"LADDER-{selection_id}-{int(time.time())}")

    logging.info(f"🪜 [LadderLay] Anchor @ {base_odds} for £{anchor_stake}")
    place_bet(session_token, market_id, selection_id, anchor_stake, base_odds, "LAY", customer_order_ref)

    for i in range(1, 5):
        ladder_odds = round_to_valid_odds(base_odds - i * tick)
        place_bet(session_token, market_id, selection_id, anchor_stake, ladder_odds, "LAY", f"LADDER-{selection_id}-LEG{i}")

def place_scalp_trade(signal, direction='lay_to_back'):
    session_token = signal['session_token']
    market_id = signal['marketId']
    selection_id = signal['selectionId']
    entry_odds = signal['odds']
    total_stake = signal.get('stake', 20.0)
    tick = calculate_tick(entry_odds)

    if direction == 'lay_to_back':
        hedge_odds = round_to_valid_odds(entry_odds + 2 * tick)
        hedge_side = 'BACK'
    else:
        hedge_odds = round_to_valid_odds(entry_odds - 2 * tick)
        hedge_side = 'LAY'

    for i in range(int(total_stake / 0.01)):
        place_bet(session_token, market_id, selection_id, 0.01, entry_odds, "LAY" if direction == 'lay_to_back' else "BACK")
        place_bet(session_token, market_id, selection_id, 0.01, hedge_odds, hedge_side)

def place_greenup_exit(signal):
    session_token = signal['session_token']
    market_id = signal['marketId']
    green_up(session_token, market_id, target_profit=1.0)

