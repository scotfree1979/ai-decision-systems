def signal_monitor():
    import sqlite3, logging, time, re
    from datetime import datetime
    from config_paths import DB_PATH
    from database_hijack_monitor import enqueue_write
    from upgrade_import_patch import signal_monitor_ready, risk_system_ready

    def generate_unique_suffix():
        global _suffix_index
        code = _suffix_index
        _suffix_index += 1
        prefix = _letters[(code // 1000) // 26] + _letters[(code // 1000) % 26]
        return f"{prefix}{code % 1000:03}"

    logging.info("🔮 signal_monitor() started → waiting 10 s for other threads…")
    time.sleep(10)

    first_pass = True
    while True:
        try:
            # 1️⃣ fetch candidate rows
            with sqlite3.connect(DB_PATH) as conn:
                rows = conn.execute(
                    "SELECT * FROM bets WHERE status IN ('signal_assigned','processing') AND time_signal IN ('time_20','time_10','time_5','time_0')"
                ).fetchall()

            if not rows:
                logging.info("📬 No candidate rows this cycle")
                time.sleep(20)
                continue

            # 2️⃣ build ladder‑candidate map (for time_20 ladder rules)
            ladder_map = {}
            for r in rows:
                ladder_map.setdefault(r[0], []).append((r[1], r[3]))  # marketId → [(selectionId, odds)]
            for mid, lst in ladder_map.items():
                ladder_map[mid] = {sid for sid, _ in sorted(lst, key=lambda x: x[1])[:6]}

            # 3️⃣ process each row
            for r in rows:
                strategy = (r[16] or "").strip().lower()
                rule = SIGNAL_RULES.get(strategy)
                if not rule:
                    logging.warning("⚠️ unknown strategy: %s", strategy)
                    continue

                time_signal = r[20]
                if time_signal not in rule["times"]:
                    continue

                m_id, sel_id = r[0], r[1]
                if rule.get("bet_type") == "LADDER" and time_signal == "time_20" and sel_id not in ladder_map.get(m_id, set()):
                    continue

                base_stake = rule["stake"]
                stake = base_stake.get(time_signal) if isinstance(base_stake, dict) else base_stake

                # -- Handle each configured bot --
                for idx, bot_name in enumerate(rule["bots"]):
                    unique_ref = generate_unique_suffix() + f"_{bot_name[:3].upper()}"
                    now_iso = datetime.utcnow().isoformat()

                    if idx == 0:
                        # 🔹 Update the original row (signal_assigned → processing) + new ref
                        with sqlite3.connect(DB_PATH) as conn:
                            conn.execute(
                                "UPDATE bets SET status='processing', stake=?, bet_type=?, timestamp=?, strategy_name=?, bot_name=?, customerOrderRef=? WHERE marketId=? AND selectionId=? AND status='signal_assigned'",
                                (stake, rule["bet_type"], now_iso, strategy, bot_name, unique_ref, m_id, sel_id)
                            )
                            conn.commit()
                    else:
                        # 🔹 Duplicate from the processing row for additional bots
                        enqueue_write(
                            """
                            INSERT OR IGNORE INTO bets (
                                marketId, selectionId, stake, odds, bet_type, placed_at, status,
                                matched_liability, unmatched_liability, pnl, liability, result,
                                timestamp, matched_timestamp, betfair_bet_id, horse_name,
                                strategy_name, signal_type, bot_name, date, time_signal,
                                can_accept_liability, time_session, race_name, market_name, event_name,
                                anchor_odd, odds_check_1, odds_check_2, odds_check_3, odds_check_4,
                                odds_check_5, odds_check_6, customerOrderRef, bet_settled,
                                marketStartTime, meta_json, test_mode
                            )
                            SELECT marketId, selectionId, ?, odds, ?, placed_at, 'fully_enriched',
                                   matched_liability, unmatched_liability, pnl, liability, result,
                                   ?, matched_timestamp, betfair_bet_id, horse_name,
                                   ?, signal_type, ?, date, time_signal,
                                   can_accept_liability, time_session, race_name, market_name, event_name,
                                   anchor_odd, odds_check_1, odds_check_2, odds_check_3, odds_check_4,
                                   odds_check_5, odds_check_6, ?, bet_settled,
                                   marketStartTime, meta_json, test_mode
                            FROM bets WHERE marketId=? AND selectionId=? AND status='processing'
                            """,
                            (stake, rule["bet_type"], now_iso, strategy, bot_name, unique_ref, m_id, sel_id)
                        )

                # 4️⃣ After all bots processed, flip the base row to fully_enriched
                with sqlite3.connect(DB_PATH) as conn:
                    conn.execute(
                        "UPDATE bets SET status='fully_enriched' WHERE marketId=? AND selectionId=? AND status='processing'",
                        (m_id, sel_id)
                    )
                    conn.commit()

        except Exception as err:
            logging.error("❌ signal_monitor loop error: %s", err)

        if first_pass:
            signal_monitor_ready.set(); risk_system_ready.set(); first_pass=False
        time.sleep(20)

