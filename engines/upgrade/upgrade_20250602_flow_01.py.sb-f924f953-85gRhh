"""
🧠 SYSTEM NOTES – DO NOT REMOVE

This file assumes that `get_markets()` has already run, meaning:
- All runners are pre-populated into the `bets` table at the start of the day.
- Each runner has a full metadata row (including event/race/horse names, odds placeholders, meta_json, etc).

run_monitor() does the following:

1. It runs every 60 seconds to track real-time clock-to-off calculations.
2. For each runner, it updates the correct `time_signal`, `status`, odds and odds_check_X fields.
3. No new rows are created before time_10.
4. At time_10, time_5, and time_0:
   - The time_20 row is duplicated
   - All fields are copied
   - A new `customerOrderRef` is assigned (basic stub like MKTID_SELECTIONID_10)
   - Status remains 'awaiting_signal'

⚠️ These duplicate rows are REQUIRED for downstream systems like MarketMonitorSignals.

🚫 DO NOT use customerOrderRef as a lookup condition here.
✅ DO use marketId + selectionId as the only criteria for fetching or updating runner rows.
✅ customerOrderRef in duplicated rows can be overwritten later downstream.
✅ This file never inserts any row until time_10 (i.e., duplication point).
✅ anchor_odd is only set at time_80 if not already set.
✅ All data is always updated in-place unless explicitly duplicating from time_20.

"""

from database_hijack_monitor import enqueue_write

def run_monitor():
    global SNAPSHOT_DATA
    print("✅ RUN_MONITOR: STARTING")
    try:
        from utils.api_tools import fetch_live_odds
        print("✅ RUN_MONITOR: IMPORTED fetch_live_odds")
    except Exception as e:
        print("❌ RUN_MONITOR: IMPORT FAILED", e)

    import time
    import logging
    import sqlite3
    import json
    from datetime import datetime, timezone
    from config_paths import DB_PATH, SESSION_TOKEN
    from utils.api_tools import fetch_live_odds

    logging.info("🕒 [Thread] run_monitor launched")

    while True:
        try:
            logging.info("🔁 [Monitor] Entered main loop")
            now = datetime.now(timezone.utc)
            logging.info(f"🕒 [Clock Tick] Current UTC time: {now.strftime('%Y-%m-%d %H:%M:%S')} UTC")

            with sqlite3.connect(DB_PATH) as conn:
                conn.row_factory = sqlite3.Row
                cursor = conn.cursor()
                cursor.execute("SELECT * FROM bets WHERE status IN ('pending', 'awaiting_signal')")
                rows = cursor.fetchall()
                logging.info(f"📆 [DB] Retrieved {len(rows)} runner rows to evaluate")

            for row in rows:
                marketId = row["marketId"]
                selectionId = row["selectionId"]
                runner_name = row["horse_name"] or "Unknown"
                start_time = SNAPSHOT_DATA.get(marketId, {}).get("start_time")

                if not start_time:
                    raw_time = row["marketStartTime"]
                    try:
                        start_time = datetime.fromisoformat(raw_time.replace("Z", "+00:00"))
                        SNAPSHOT_DATA[marketId] = {"start_time": start_time}
                    except:
                        logging.warning(f"⚠️ Could not parse fallback start_time for {marketId}")
                        continue

                minutes_to_off = int((start_time - now).total_seconds() / 60)
                if minutes_to_off == 999:
                    logging.warning(f"⚠️ No snapshot clock for {marketId}, skipping.")
                    continue

                if minutes_to_off > 85:
                    enqueue_write("""
                        UPDATE bets SET time_signal = 'upcoming'
                        WHERE marketId = ? AND selectionId = ?
                    """, (marketId, selectionId))
                    continue

                logging.info(f"⏱️ [Runner Clock] {runner_name} → T-{int(minutes_to_off)} mins")

                for time_mark, signal_tag in zip([80, 60, 40, 20, 10, 5, 0],
                                                 ["time_80", "time_60", "time_40", "time_20", "time_10", "time_5", "time_0"]):
                    gap = 20 if time_mark >= 20 else 5
                    if abs(minutes_to_off - time_mark) > gap:
                        continue

                    customer_order_ref = f"{marketId[-5:]}_{selectionId}_{time_mark}"[:32]
                    odds_data = fetch_live_odds(marketId=marketId, selectionId=selectionId, session_token=SESSION_TOKEN)
                    odds = odds_data["lay"] if odds_data else None
                    if odds is None:
                        logging.warning(f"🕓 [Missed Odds] {runner_name} – T-{minutes_to_off} mins – odds unavailable.")
                        continue

                    if time_mark in [80, 60, 40, 20]:
                        odds_field = {
                            80: "odds_check_6",
                            60: "odds_check_5",
                            40: "odds_check_4",
                            20: "odds_check_3"
                        }[time_mark]

                        update_status = 'awaiting_signal' if time_mark == 20 else row["status"]

                        enqueue_write(f"""
                            UPDATE bets SET 
                                odds = ?, 
                                {odds_field} = ?, 
                                time_signal = ?, 
                                timestamp = ?, 
                                status = ?
                            WHERE marketId = ? AND selectionId = ?
                        """, (odds, odds, signal_tag, datetime.utcnow().isoformat(), update_status, marketId, selectionId))

                        if time_mark == 80:
                            enqueue_write("""
                                UPDATE bets SET anchor_odd = ?
                                WHERE marketId = ? AND selectionId = ? AND anchor_odd IS NULL
                            """, (odds, marketId, selectionId))

                        logging.info(f"📌 [Hijacked] Signal written: {signal_tag} → {runner_name} @ {odds}")

                    if time_mark in [10, 5, 0]:
                        try:
                            with sqlite3.connect(DB_PATH) as conn:
                                conn.row_factory = sqlite3.Row
                                cursor = conn.cursor()
                                cursor.execute("""
                                    SELECT * FROM bets WHERE marketId = ? AND selectionId = ? AND time_signal = 'time_20'
                                """, (marketId, selectionId))
                                base_row = cursor.fetchone()

                            if not base_row:
                                continue

                            columns = base_row.keys()
                            values = [base_row[col] for col in columns]
                            insert_values = values.copy()

                            insert_dict = dict(zip(columns, insert_values))
                            insert_dict["time_signal"] = signal_tag
                            insert_dict["customerOrderRef"] = customer_order_ref
                            insert_dict["timestamp"] = datetime.utcnow().isoformat()

                            insert_cols = ", ".join(insert_dict.keys())
                            placeholders = ", ".join(["?" for _ in insert_dict])
                            enqueue_write(f"""
                                INSERT INTO bets ({insert_cols}) VALUES ({placeholders})
                            """, list(insert_dict.values()))

                            logging.info(f"🚨 [Hijacked] Duplicated {signal_tag} → {runner_name}")

                        except Exception:
                            logging.exception(f"❌ Failed to duplicate signal row {signal_tag} for {runner_name}:")

        except Exception:
            logging.exception("❌ run_monitor exception:")
        run_monitor_ready.set()
        time.sleep(60)

