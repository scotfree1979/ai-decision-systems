import os
import sys
import logging
from datetime import datetime, timedelta
from random import choice, randint
from queue import Queue

sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

signal_queue = Queue()

race_runners = [8, 10, 15, 9, 18, 12, 14, 10, 11, 13]  # Extended to 10 races

TOTAL_PNL = 0

def generate_test_markets():
    base_time = datetime.utcnow()
    markets = []
    runner_id = 1000
    for i in range(10):  # Now generate 10 test races
        race_time = base_time + timedelta(minutes=15 * i)
        market_id = f"1.TEST{i+1}"
        runners = [{"selectionId": runner_id + j} for j in range(race_runners[i % len(race_runners)])]
        market = {
            "marketId": market_id,
            "marketName": f"WIN R{i+1}",
            "marketStatus": "OPEN",
            "marketStartTime": race_time.isoformat(),
            "event": {
                "countryCode": "GB",
                "name": f"Test Race {i+1}",
                "openDate": race_time.isoformat()
            },
            "runners": runners
        }
        runner_id += race_runners[i % len(race_runners)]
        markets.append(market)
    return markets


strategy_combos = [
    ("Basic Lay", "20min"),
    ("Ladder Lays", "20min"),
    ("Scalping (Lay to Back)", "10min"),
    ("Scalping (Back to Lay)", "10min"),
    ("Basic Lay", "10min"),
    ("Ladder Lays", "10min"),
    ("Scalping (Lay to Back)", "5min"),
    ("Scalping (Back to Lay)", "5min"),
    ("Basic Lay", "5min"),
    ("Ladder Lays", "5min"),
    ("Green-Up", "5min"),
    ("In-Play", "inplay"),
    ("Scalping (Lay to Back)", "20min"),
    ("Scalping (Back to Lay)", "20min"),
    ("In-Play", "inplay"),
    ("Green-Up", "5min")
]

def process_signal(signal):
    return signal

def update_matched_bets(signal):
    signal.update({
        "matched_timestamp": datetime.utcnow().isoformat()
    })
    status = signal['status'].upper()
    strategy = signal['strategy_name']
    selection_id = signal['selectionId']
    odds = signal['odds']
    matched = signal['matched_liability']
    unmatched = signal['unmatched_liability']
    logging.info(f"📥 [{status}] {strategy} | {selection_id} | Odds: {odds} | Matched: £{matched:.2f} | Unmatched: £{unmatched:.2f}")

def bet_worker(signal):
    odds = signal.get("odds", 0)
    stake = signal.get("stake", 0)
    liability = round((odds - 1) * stake, 2)
    selection_id = signal.get("selectionId")
    strategy = signal.get("strategy_name")
    race = signal.get("marketId")

    if odds > 20 or liability > 40:
        logging.warning(f"❌ Rejected | Market: {race} | Selection: {selection_id} | Reason: {'Odds > 20' if odds > 20 else 'Liability > 40'}")
        return 0

    matched = choice([True, False, False])
    if matched:
        signal["matched_liability"] = liability
        signal["unmatched_liability"] = 0
        signal["status"] = "placed"
        profit = round(stake, 2)
    else:
        signal["matched_liability"] = 0
        signal["unmatched_liability"] = liability
        signal["status"] = "retry"
        profit = 0

    update_matched_bets(signal)
    return profit

def launch_protocol():
    with signal_queue.mutex:
        signal_queue.queue.clear()
    logging.info("✅ System boot sequence complete.")

def run_test_mode():
    global TOTAL_PNL
    logging.info("🧪 TEST MODE — Simulating 10 race markets with full strategy set...")
    test_markets = generate_test_markets()
    valid_markets = [m for m in test_markets if m["marketStatus"] == "OPEN"]

    for i, market in enumerate(valid_markets):
        market_id = market["marketId"]
        runners = market["runners"]
        race_name = market["event"]["name"]

        race_pnl = 0
        print(f"\nRACE {i+1} – {race_name}")

        for idx, (strategy, timing) in enumerate(strategy_combos):
            runner = runners[idx % len(runners)]
            selection_id = runner["selectionId"]
            fire = choice([True, False])
            ice = choice([True, False])

            odds = round(2.0 + (idx % 6) * 0.5, 2)
            liability = round((odds - 1) * 5.0, 2)

            signal = {
                "marketId": market_id,
                "selectionId": selection_id,
                "odds": odds,
                "stake": 5.0,
                "strategy_name": strategy,
                "bot_name": "OGHeadTrader" if timing != "inplay" else "OGInPlay",
                "session_token": "TEST_TOKEN",
                "time_session": timing,
                "signal_type": f"{timing} signal",
                "original_signal_type": "upgrade_test",
                "timestamp": datetime.utcnow().isoformat(),
                "source": "upgrade_test",
                "detail": f"test sim {timing}",
                "customerOrderRef": f"TEST-{selection_id}-{strategy[:3].upper()}",
                "market_name": market["marketName"],
                "event_name": race_name,
                "meta": {"fire": fire, "ice": ice},
                "horse": f"TestHorse_{selection_id}"
            }

            print(f"🐎 {selection_id} | {strategy:<25} | Fire: {'🔥' if fire else ' '} | Ice: {'❄️' if ice else ' '} | Odds: {odds} | Stake: £5 | Liab: £{liability:.2f}")

            processed = process_signal(signal)
            if processed:
                race_pnl += bet_worker(processed)

        TOTAL_PNL += race_pnl
        print(f"\n🟩 GREEN-UP | Race {i+1} Complete")
        print(f"💰 Race {i+1} PnL: £{race_pnl:.2f}")
        print(f"🏇 RACE {i+1} STARTED | 🏁 FINISHED")

    print(f"\n====================")
    print(f"🏁 TOTAL TEST PnL across 10 races: £{TOTAL_PNL:.2f}")
    print(f"📊 Average PnL per race: £{(TOTAL_PNL/10):.2f}")
    logging.info("🧪 Test run complete.")

if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format='%(message)s')
    run_test_mode()
