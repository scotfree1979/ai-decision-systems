# ✅ upgrade_head_trader.py – Enhanced HeadTrader Controller with Master Upgrade
import logging
import sqlite3
import json
from datetime import datetime, timedelta
from learning_optimizer import LearningOptimizer
from rules.head_trader_rules import *

DB_PATH = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db"

# ✅ Core function for receiving performance signals from Learning Optimizer
def handle_strategy_feedback(feedback):
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()

        cursor.execute("""
            CREATE TABLE IF NOT EXISTS strategy_feedback (
                strategy_name TEXT,
                win_rate REAL,
                timestamp TEXT
            )
        """)
        conn.commit()

        for strategy, stats in feedback.items():
            win_rate = stats.get("win_rate", 0.0)
            cursor.execute("""
                INSERT INTO strategy_feedback (strategy_name, win_rate, timestamp)
                VALUES (?, ?, ?)
            """, (strategy, win_rate, datetime.utcnow().isoformat()))

        conn.commit()
        conn.close()
        logging.info("✅ [HeadTrader] Strategy feedback recorded.")

    except Exception as e:
        logging.error(f"❌ [HeadTrader] Failed to handle feedback: {e}")

# ✅ Extended function to generate performance summaries over time
def generate_report(period):
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()

        now = datetime.utcnow()
        if period == "day":
            since = now - timedelta(days=1)
        elif period == "week":
            since = now - timedelta(weeks=1)
        elif period == "month":
            since = now - timedelta(days=30)
        elif period == "quarter":
            since = now - timedelta(days=90)
        elif period == "6_months":
            since = now - timedelta(days=180)
        elif period == "year":
            since = now - timedelta(days=365)
        else:
            logging.warning(f"⚠️ Invalid report period: {period}")
            return

        cursor.execute("""
            SELECT strategy_name, status, odds FROM bets
            WHERE placed_at >= ?
        """, (since.isoformat(),))
        rows = cursor.fetchall()

        total = len(rows)
        win_count = sum(1 for r in rows if r[1] == "won")
        total_odds = sum(r[2] or 0 for r in rows if r[2])

        strat_perf = {}
        for strategy, status, odds in rows:
            if strategy not in strat_perf:
                strat_perf[strategy] = {"wins": 0, "bets": 0}
            strat_perf[strategy]["bets"] += 1
            if status == "won":
                strat_perf[strategy]["wins"] += 1

        performance = {
            k: round(v["wins"] / v["bets"], 2) for k, v in strat_perf.items()
        }

        cursor.execute("""
            CREATE TABLE IF NOT EXISTS strategy_reports (
                period TEXT,
                run_at TEXT,
                total_bets INTEGER,
                win_rate REAL,
                average_odds REAL,
                strategy_performance TEXT
            )
        """)
        conn.commit()

        cursor.execute("""
            INSERT INTO strategy_reports (period, run_at, total_bets, win_rate, average_odds, strategy_performance)
            VALUES (?, ?, ?, ?, ?, ?)
        """, (
            period,
            now.isoformat(),
            total,
            round(win_count / total, 2) if total else 0.0,
            round(total_odds / total, 2) if total else 0.0,
            json.dumps(performance)
        ))
        conn.commit()
        conn.close()

        logging.info(f"📊 [HeadTrader] Generated {period} report with {total} rows")
    except Exception as e:
        logging.error(f"❌ [HeadTrader] Report generation failed: {e}")

# ✅ Bot Order Routing

def issue_bot_order(bot_name, action, reason):
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS bot_orders (
                bot_name TEXT,
                action TEXT,
                reason TEXT,
                timestamp TEXT
            )
        """)
        conn.commit()

        cursor.execute("""
            INSERT INTO bot_orders (bot_name, action, reason, timestamp)
            VALUES (?, ?, ?, ?)
        """, (bot_name, action, reason, datetime.utcnow().isoformat()))
        conn.commit()
        conn.close()
        logging.info(f"📡 [HeadTrader] Order sent to {bot_name}: {action} | {reason}")
    except Exception as e:
        logging.error(f"❌ [HeadTrader] Failed to issue bot order: {e}")

# ✅ Watchdog Monitor (Detect Stale Bots or Failures)
def run_watchdog():
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()
        cursor.execute("""
            SELECT bot_name, MAX(timestamp) FROM bets
            WHERE placed_at >= datetime('now', '-6 hours')
            GROUP BY bot_name
        """)
        rows = cursor.fetchall()

        for bot_name, last_seen in rows:
            if not last_seen:
                continue
            time_diff = datetime.utcnow() - datetime.fromisoformat(last_seen)
            if time_diff > timedelta(minutes=60):
                issue_bot_order(bot_name, "pause", "Inactive for 60+ minutes")

        logging.info("🛡️ [Watchdog] Checked all bots for activity health.")
    except Exception as e:
        logging.error(f"❌ [Watchdog] Failed to run: {e}")

# ✅ Combined function to run both optimizer and report syncs
def UpgradeHeadTrader():
    logging.info("📊 [HeadTrader] Starting optimization sync...")
    optimizer = LearningOptimizer()
    optimizer.run()
    feedback = optimizer.stats.get("strategy_performance", {})
    if feedback:
        handle_strategy_feedback(feedback)
        for strategy, stats in feedback.items():
            win_rate = stats.get("win_rate", 0.0)
            if win_rate < 0.15:
                issue_bot_order(strategy, "pause", f"Low win rate on {strategy}")
    else:
        logging.info("ℹ️ [HeadTrader] No feedback generated.")

    for period in ["day", "week", "month"]:
        generate_report(period)

    run_watchdog()

# ✅ Example usage
if __name__ == "__main__":
    UpgradeHeadTrader()
