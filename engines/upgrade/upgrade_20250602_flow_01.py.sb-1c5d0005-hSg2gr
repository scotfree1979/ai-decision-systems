# ✅ Upgrade 20250602 – Part 2a: Insert Bets From Markets
# -----------------------------
# ✅ IMPLEMENTED: Adds each runner into bets table with 38-field awareness
# - Defaults: status = 'pending', test_mode = '0'

def insert_bets_from_markets(markets):
    logging.info("📥 Inserting runners into bets table...")
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        for market in markets:
            for runner in market.get("runners", []):
                try:
                    cursor.execute("""
                        INSERT OR IGNORE INTO bets (
                            marketId, selectionId, horse_name, status, test_mode, marketStartTime
                        ) VALUES (?, ?, ?, ?, ?, ?)
                    """, (
                        market["marketId"],
                        runner["selectionId"],
                        runner["runnerName"],
                        "pending",
                        "0",
                        market["marketStartTime"]
                    ))
                except Exception as e:
                    logging.error(f"❌ Failed to insert runner row: {e}")
        conn.commit()
        logging.info("✅ Runner rows inserted.")

# -----------------------------
# ✅ Upgrade 20250602 – Part 2b: Run Monitor Clock Rows
# -----------------------------
# ✅ IMPLEMENTED: Internal countdown, odds tracking, row duplication at time_10/5/0
# - Fully aligned with SVES structure
# - One row per runner initially; duplicates only at key triggers

import sqlite3
import time
import logging
from datetime import datetime
import json
from config_paths import DB_PATH
from utils.api_tools import fetch_live_odds


def run_monitor():
    logging.info("🕒 RunMonitor activated. Waiting for pending runners...")
    CLOCKS = {}

    while True:
        try:
            with sqlite3.connect(DB_PATH) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    SELECT DISTINCT marketId, marketStartTime, meta_json FROM bets
                    WHERE status = 'pending' AND time_signal IS NULL
                """)
                rows = cursor.fetchall()

            if not rows:
                time.sleep(30)
                continue

            for market_id, market_start_time, meta_json in rows:
                if market_id in CLOCKS:
                    continue

                try:
                    if market_start_time:
                        target = datetime.strptime(market_start_time, "%Y-%m-%dT%H:%M:%S.%fZ")
                    else:
                        meta = json.loads(meta_json or '{}')
                        target = datetime.strptime(meta.get("race_start"), "%Y-%m-%dT%H:%M:%S.%fZ")
                except Exception as e:
                    logging.warning(f"⚠️ Time parse failed for {market_id}: {e}")
                    continue

                CLOCKS[market_id] = target
                logging.info(f"⏱ {market_id} clock synced for {target.strftime('%H:%M:%S')} UTC")

            time.sleep(60)
            now = datetime.utcnow()

            for market_id in list(CLOCKS.keys()):
                mins_left = int((CLOCKS[market_id] - now).total_seconds() / 60)

                if mins_left in [80, 60, 40, 20, 10, 5, 0]:
                    with sqlite3.connect(DB_PATH) as conn:
                        cursor = conn.cursor()
                        cursor.execute("""
                            SELECT marketId, selectionId, horse_name FROM bets
                            WHERE marketId = ? AND time_signal IS NULL
                        """, (market_id,))
                        runners = cursor.fetchall()

                        for marketId, selectionId, horse_name in runners:
                            odds = fetch_live_odds(marketId, selectionId)
                            ref = f"{marketId[-5:]}_{selectionId}_SVES_time_{mins_left}"[:32]

                            if mins_left in [10, 5, 0]:
                                try:
                                    cursor.execute("""
                                        INSERT INTO bets (
                                            marketId, selectionId, horse_name, time_signal,
                                            customerOrderRef, timestamp, date, status,
                                            odds, anchor_odd, test_mode
                                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                                    """, (
                                        marketId, selectionId, horse_name,
                                        f"time_{mins_left}", ref,
                                        datetime.utcnow().isoformat(),
                                        datetime.utcnow().strftime("%Y-%m-%d"),
                                        "awaiting_signal", odds, odds, "0"
                                    ))
                                    logging.info(f"🧨 {horse_name} duplicated for time_{mins_left} @ {odds}")
                                except Exception as e:
                                    logging.warning(f"❌ Duplication failed at time_{mins_left}: {e}")

                            else:
                                try:
                                    odds_check = {
                                        80: "odds_check_6",
                                        60: "odds_check_5",
                                        40: "odds_check_4",
                                        20: "odds_check_3"
                                    }[mins_left]
                                    cursor.execute(f"""
                                        UPDATE bets SET odds = ?, anchor_odd = ?, {odds_check} = ?,
                                        time_signal = ?, timestamp = ?
                                        WHERE marketId = ? AND selectionId = ? AND time_signal IS NULL
                                    """, (odds, odds, odds, f"time_{mins_left}",
                                          datetime.utcnow().isoformat(), marketId, selectionId))
                                    logging.info(f"🔁 Updated {horse_name} for time_{mins_left} @ {odds}")
                                except Exception as e:
                                    logging.warning(f"⚠️ Update failed at {mins_left}: {e}")

                if mins_left < -80:
                    CLOCKS.pop(market_id)
                    logging.info(f"🏁 Clock expired for {market_id}. Removed from loop.")

        except Exception as e:
            logging.error(f"❌ RunMonitor critical error: {e}")
            time.sleep(60)

