# ✅ Upgrade 20250602 – Part 1: Validate Bets Table (38-Field Schema Fix)
# -----------------------------
# ✅ IMPLEMENTED: Ensures the bets table includes all required fields
# - Drops and rebuilds table if schema mismatch detected

import sqlite3
import logging
from config_paths import DB_PATH

REQUIRED_COLUMNS = {
    "marketId", "selectionId", "stake", "odds", "bet_type", "placed_at", "status",
    "matched_liability", "unmatched_liability", "pnl", "liability", "result", "timestamp",
    "matched_timestamp", "betfair_bet_id", "horse_name", "strategy_name", "signal_type",
    "bot_name", "date", "time_signal", "can_accept_liability", "time_session", "race_name",
    "market_name", "event_name", "anchor_odd", "odds_check_1", "odds_check_2", "odds_check_3",
    "odds_check_4", "odds_check_5", "odds_check_6", "customerOrderRef", "bet_settled",
    "marketStartTime", "meta_json", "test_mode"
}

def validate_bets_table():
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("PRAGMA table_info(bets)")
        columns = {row[1] for row in cursor.fetchall()}

        if columns != REQUIRED_COLUMNS:
            logging.warning("⚠️ Schema mismatch detected. Rebuilding bets table...")
            cursor.execute("DROP TABLE IF EXISTS bets")
            cursor.execute("""
                CREATE TABLE bets (
                    marketId TEXT,
                    selectionId INTEGER,
                    stake REAL,
                    odds REAL,
                    bet_type TEXT,
                    placed_at TEXT,
                    status TEXT,
                    matched_liability REAL,
                    unmatched_liability REAL,
                    pnl REAL,
                    liability REAL,
                    result TEXT,
                    timestamp TEXT,
                    matched_timestamp TEXT,
                    betfair_bet_id TEXT,
                    horse_name TEXT,
                    strategy_name TEXT,
                    signal_type TEXT,
                    bot_name TEXT,
                    date TEXT,
                    time_signal TEXT,
                    can_accept_liability TEXT,
                    time_session TEXT,
                    race_name TEXT,
                    market_name TEXT,
                    event_name TEXT,
                    anchor_odd REAL,
                    odds_check_1 REAL,
                    odds_check_2 REAL,
                    odds_check_3 REAL,
                    odds_check_4 REAL,
                    odds_check_5 REAL,
                    odds_check_6 REAL,
                    customerOrderRef TEXT PRIMARY KEY,
                    bet_settled TEXT,
                    marketStartTime TEXT,
                    meta_json TEXT,
                    test_mode TEXT
                )
            """)
            conn.commit()
            logging.info("✅ Bets table rebuilt with correct schema.")
        else:
            logging.info("✅ Bets table already has correct schema.")
