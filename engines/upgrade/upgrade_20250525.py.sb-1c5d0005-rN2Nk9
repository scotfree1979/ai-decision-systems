def fetch_market_data():
    logging.info("📡 Fetching live WIN markets with 7+ runners...")
    session_token = os.environ.get("SESSION_TOKEN", "NO_TOKEN")
    try:
        response = requests.post(
            url="https://api.betfair.com/exchange/betting/json-rpc/v1",
            headers={
                "X-Application": "CZHojduNWa3kxWIn",
                "X-Authentication": session_token,
                "Content-Type": "application/json"
            },
            data=json.dumps([
                {
                    "jsonrpc": "2.0",
                    "method": "SportsAPING/v1.0/listMarketCatalogue",
                    "params": {
                        "filter": {
                            "eventTypeIds": ["7"],
                            "marketCountries": ["GB", "IE"],
                            "marketTypeCodes": ["WIN"],
                            "marketStartTime": {
                                "from": datetime.utcnow().strftime("%Y-%m-%dT00:00:00Z"),
                                "to": (datetime.utcnow() + timedelta(days=1)).strftime("%Y-%m-%dT00:00:00Z")
                            }
                        },
                        "marketProjection": ["RUNNER_DESCRIPTION", "MARKET_START_TIME", "EVENT"],
                        "sort": "FIRST_TO_START",
                        "maxResults": "30"
                    },
                    "id": 1
                }
            ])
        )
        markets = response.json()[0].get("result", []) if response.status_code == 200 else []
        valid = [m for m in markets if len(m.get("runners", [])) >= 7]
        logging.info(f"🎯 Filter complete: {len(valid)} markets ready")
        return valid

    except Exception as e:
        logging.error(f"❌ Error fetching markets: {e}")
        return []

def fetch_markets():
    if TEST_MODE:
        logging.info("🧪 TEST MODE ACTIVE – Dummy Data Injected – Need Data")
        return []
    else:
        return fetch_market_data()

# -----------------------------
# ⏱️ SHARED UTILITY FOR TIME SESSION MATCHING
# -----------------------------
def in_session_window(minutes_to_off, target):
    return (target - 2) <= minutes_to_off <= (target + 2)


# -----------------------------
# 🧭 RUN MONITOR – SESSION LOGIC FOR MULTI-WINDOW (80, 60, 40, 20, 10, 5, 0)
# -----------------------------
# -----------------------------
def run_monitor():
    logging.info("🧭 Running session window match for all supported time slots")
    now = get_simulated_now()
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()

        # Get all unique markets from the DB
        cursor.execute("SELECT DISTINCT marketId FROM bets")
        market_ids = [row[0] for row in cursor.fetchall()]

        for market_id in market_ids:
            cursor.execute("""
                SELECT * FROM bets
                WHERE marketId = ? AND time_signal = 'time_80'
            """, (market_id,))
            rows = cursor.fetchall()
            if not rows:
                continue

            # Assume top 4 by selectionId for now (can be replaced with price rank later)
            top_runners = sorted(rows, key=lambda x: x[1])[:4]  # x[1] is selectionId

            for row in top_runners:
                market_start = datetime.fromisoformat(row[10])  # marketStartTime column
                minutes_to_off = (market_start - now).total_seconds() / 60

                for target_time in [60, 40, 20, 10, 5, 0]:
                    if not in_session_window(minutes_to_off, target_time):
                        continue

                    time_label = f"time_{target_time}"

                    cursor.execute("""
                        SELECT 1 FROM bets
                        WHERE marketId = ? AND selectionId = ? AND time_signal = ?
                    """, (row[0], row[1], time_label))
                    if cursor.fetchone():
                        continue

                    customer_order_ref = f"{row[0][-5:]}_{row[1]}_{target_time}"[:32]
                    cursor.execute("""
                        UPDATE bets
                        SET status = 'awaiting_signal'
                        WHERE marketId = ? AND selectionId = ? AND time_signal = 'time_80'
                    """, (row[0], row[1]))
                    timestamp = datetime.utcnow().isoformat()

                    try:
                        cursor.execute("""
                            INSERT INTO bets (
                                marketId, selectionId, horse_name, time_signal, customerOrderRef,
                                timestamp, date, status, event_name, race_name, marketStartTime,
                                odds_check_6, odds_check_1, anchor_odd,
                                odds, strategy_name, signal_type, bot_name, bet_type
                            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                        """, (
                            row[0], row[1], row[2], time_label, customer_order_ref,
                            timestamp, datetime.utcnow().strftime('%Y-%m-%d'), "pending",
                            row[8], row[9], row[10],  # event_name, race_name, marketStartTime
                            None, None, None, None, None, None, None, None
                        ))
                        logging.info(f"➕ Added {time_label} row for {row[2]} in {row[0]}")
                    except Exception as e:
                        logging.error(f"❌ Failed to insert {time_label} row: {e}")
                    # Check if this runner already has a time_10 row
                    cursor.execute("""
                        SELECT 1 FROM bets
                        WHERE marketId = ? AND selectionId = ? AND time_signal = 'time_10'
                    """, (row[0], row[1]))
                    if cursor.fetchone():
                        continue

                    # Create a new time_10 row for this runner
                    customer_order_ref = f"{row[0][-5:]}_{row[1]}_10"[:32]
                    timestamp = datetime.utcnow().isoformat()

                    try:
                        cursor.execute("""
                            INSERT INTO bets (
                                marketId, selectionId, horse_name, time_signal, customerOrderRef,
                                timestamp, date, status, event_name, race_name, marketStartTime,
                                odds_check_6, odds_check_1, anchor_odd,
                                odds, strategy_name, signal_type, bot_name, bet_type
                            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                        """, (
                            row[0], row[1], row[2], "time_10", customer_order_ref,
                            timestamp, datetime.utcnow().strftime('%Y-%m-%d'), "pending",
                            row[8], row[9], row[10],  # event_name, race_name, marketStartTime
                            None, None, None, None, None, None, None, None
                        ))
                        logging.info(f"➕ Added time_10 row for {row[2]} in {row[0]}")
                    except Exception as e:
                        logging.error(f"❌ Failed to insert time_10 row: {e}")

        conn.commit()


