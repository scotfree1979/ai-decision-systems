def log_runners_to_db(markets):
    logging.info("📝 Logging runners to DB with status 'pending'...")
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        for market in markets:
            market_id = market["marketId"]
            race_name = market["marketName"]
            event_name = market["event"]["name"]
            market_start = market["marketStartTime"]

            for runner in market["runners"]:
                selection_id = runner["selectionId"]
                runner_name = runner["runnerName"]
                # customerOrderRef max 32 characters
                customer_order_ref = f"{market_id[-5:]}_{selection_id}_80"
                timestamp = datetime.utcnow().isoformat()

                try:
                    cursor.execute("""
                        INSERT OR IGNORE INTO bets (
                            marketId, selectionId, horse_name, time_signal, customerOrderRef,
                            timestamp, date, status, event_name, race_name, marketStartTime,
                            odds_check_6, odds_check_1, anchor_odd,
                            odds, strategy_name, signal_type, bot_name, bet_type
                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """, (
                        market_id,
                        selection_id,
                        runner_name,
                        "time_80",
                        customer_order_ref[:32],
                        timestamp,
                        datetime.utcnow().strftime('%Y-%m-%d'),
                        "pending",
                        event_name,
                        race_name,
                        market_start,
                        None, None, None,
                        None, None, None, None, None
                    ))
                except Exception as e:
                    logging.error(f"❌ Failed to insert runner {runner_name}: {e}")

        conn.commit()
