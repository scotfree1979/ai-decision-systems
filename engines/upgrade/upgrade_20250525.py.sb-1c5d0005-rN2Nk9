def signal_monitor():
    logging.info("🧠 Enriching and routing signal_assigned records")
    from market_monitor_signals import SIGNAL_BOT_MAPPING  # mapping dict
    now = get_simulated_now()
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()

        cursor.execute("""
            SELECT * FROM bets WHERE status = 'signal_assigned'
        """)
        rows = cursor.fetchall()

        for row in rows:
            market_id, selection_id, horse_name, time_signal, ref = row[0], row[1], row[2], row[3], row[4]
            signal_type = row[16]
            bots = SIGNAL_BOT_MAPPING.get(signal_type, [])

            if not bots:
                logging.warning(f"⚠️ No bot targets found for signal type: {signal_type}")
                continue

            # Determine stake based on time_signal
            stake = 10.0 if time_signal == "time_20" else 20.0 if time_signal == "time_10" else 5.0 if time_signal == "time_0" else None

            for bot in bots:
                new_ref = f"{ref}_{bot[:3].upper()}"[:32]
                try:
                    cursor.execute("""
                        INSERT OR IGNORE INTO bets (
                            marketId, selectionId, horse_name, time_signal, customerOrderRef,
                            timestamp, date, status, event_name, race_name, marketStartTime,
                            odds_check_6, odds_check_1, anchor_odd,
                            odds, strategy_name, signal_type, bot_name, bet_type
                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """, (
                        market_id, selection_id, horse_name, time_signal, new_ref,
                        now.isoformat(), datetime.utcnow().strftime('%Y-%m-%d'), "fully_enriched",
                        row[8], row[9], row[10],
                        row[11], row[12], row[13], row[14],
                        signal_type, signal_type, bot, None
                    ))
                    logging.info(f"✅ Enriched + routed signal for {horse_name} to {bot}: {new_ref}")
                except Exception as e:
                    logging.error(f"❌ Enrichment failed for {ref} → {bot}: {e}")

        conn.commit()


