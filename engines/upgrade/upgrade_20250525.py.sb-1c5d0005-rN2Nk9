def market_monitor_signals():
    logging.info("📡 Running market_monitor_signals for awaiting_signal rows")
    now = get_simulated_now()
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()

        cursor.execute("""
            SELECT * FROM bets
            WHERE status = 'awaiting_signal'
        """)
        rows = cursor.fetchall()

        for row in rows:
            market_id, selection_id, horse_name, time_signal, ref = row[0], row[1], row[2], row[3], row[4]
            signal_type = None

            if time_signal == "time_20":
                signal_type = "Market Drifter Signal"
            elif time_signal == "time_10":
                signal_type = "Scalp Lay Signal"
            elif time_signal == "time_5":
                signal_type = "GreenUp 5-Minute Signal"
            elif time_signal == "time_0":
                signal_type = "InPlay Signal"

            if signal_type:
                try:
                    cursor.execute("""
                        UPDATE bets
                        SET signal_type = ?, status = 'signal_assigned'
                        WHERE marketId = ? AND selectionId = ? AND customerOrderRef = ?
                    """, (signal_type, market_id, selection_id, ref))
                    logging.info(f"📌 Assigned {signal_type} to {horse_name} [{market_id} / {ref}]")
                except Exception as e:
                    logging.error(f"❌ Failed to assign signal_type for {ref}: {e}")

        conn.commit()


