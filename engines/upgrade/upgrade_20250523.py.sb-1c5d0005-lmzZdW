def run_test_mode():
    logging.info("🧪 TEST MODE ENABLED — Injecting simulated markets with mixed fire/ice flags...")
    test_markets = generate_test_markets()
    valid_markets = wrap_run_monitor(test_markets)

    for i, market in enumerate(valid_markets):
        market_id = market["marketId"]
        runners = market["runners"]
        race_name = market["event"]["name"]

        print(f"\n========================= RACE {i+1} – {race_name} =========================")

        for idx, (strategy, timing) in enumerate(strategy_combos):
            runner = runners[idx % len(runners)]
            selection_id = runner["selectionId"]

            fire = choice([True, False])
            ice = choice([True, False])
            if idx == 0:
                fire, ice = True, False
            elif idx == 1:
                fire, ice = False, True
            elif idx == 2:
                fire, ice = True, True
            elif idx == 3:
                fire, ice = True, False
                runner = runners[-1]
                selection_id = runner["selectionId"]

            odds = round(2.0 + (idx % 6) * 0.5, 2)
            liability = round((odds - 1) * 5.0, 2)

            signal = {
                "marketId": market_id,
                "selectionId": selection_id,
                "odds": odds,
                "stake": 5.0,
                "strategy_name": strategy,
                "bot_name": "OGHeadTrader" if timing != "inplay" else "OGInPlay",
                "session_token": "TEST_TOKEN",
                "time_session": timing,
                "signal_type": f"{timing} signal",
                "original_signal_type": "upgrade_test",
                "timestamp": datetime.utcnow().isoformat(),
                "source": "upgrade_test",
                "detail": f"test sim {timing}",
                "customerOrderRef": f"TEST-{selection_id}-{strategy[:3].upper()}",
                "market_name": market["marketName"],
                "event_name": race_name,
                "meta": {"fire": fire, "ice": ice},
                "horse": f"TestHorse_{selection_id}"
            }

            print(f"🐎 Horse {selection_id} | Strat: {strategy:<22} | Fire: {'✅' if fire else '❌'} | Ice: {'✅' if ice else '❌'} | Odds: {odds} | Stake: £5 | Liab: £{liability:.2f}")

            processed = process_signal(signal)
            if processed:
                update_matched_bets(processed)
                bet_worker(processed)

        if any(s[0] == "Green-Up" for s in strategy_combos):
            print(f"\n🟩 GREEN-UP INITIATED FOR RACE {i+1}")
            print("💼 Total Exposure: £XXX.XX | Hedged: £YYY.YY | Residual: £ZZZ.ZZ")
            print("✅ Green-Up Complete | Bets marked safe for off")

        print(f"\n🏇 RACE {i+1} STARTS – In-Play Signals Active")
        print(f"🏁 RACE {i+1} FINISHED – Bets Settled\n")

    logging.info("🧪 All test signals dispatched with real-time visual output.")

if __name__ == "__main__":
