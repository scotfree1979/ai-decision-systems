# 🔁️ Bot ref counter
bot_ref_counter = 1

def risk_manager():
    global bot_ref_counter
    signal_monitor_ready.wait()
    print("🪿 Thread started: Risk Manager")
    logging.info("📜️ risk_manager() launched")
    while True:
        try:
            with sqlite3.connect(DB_PATH) as conn:
                cursor = conn.cursor()
                cursor.execute("SELECT * FROM bets WHERE status = 'fully_enriched'")
                rows = cursor.fetchall()

                for row in rows:
                    customerOrderRef = row[33]
                    if not customerOrderRef:
                        continue

                    suffix = f"b{bot_ref_counter}"
                    bot_ref_counter += 1

                    new_ref = customerOrderRef[:32 - len(suffix)] + suffix
                    enqueue_write(
                        "UPDATE bets SET status = 'risk_approved', customerOrderRef = ? WHERE customerOrderRef = ?",
                        (new_ref, customerOrderRef)
                    )
                    logging.info(f"✅ RiskManager: Ref updated {customerOrderRef} → {new_ref}")

                    time.sleep(0.05)

                conn.commit()
                logging.info(f"✅ Risk Manager processed {len(rows)} row(s)")
        except Exception as e:
            logging.error(f"❌ risk_manager() error: {e}")
        time.sleep(10)

