def signal_monitor():
    import sqlite3, logging, time
    from datetime import datetime
    from config_paths import DB_PATH
    from database_hijack_monitor import enqueue_write
    from upgrade_import_patch import signal_monitor_ready, risk_system_ready

    logging.info("🔮 signal_monitor() starting – 10 seconds grace period …")
    time.sleep(10)

    first_pass = True

    while True:
        try:
            logging.info("📬 [SignalMonitor] Checking for base-eligible rows...")
            with sqlite3.connect(DB_PATH, timeout=10) as conn:
                conn.row_factory = sqlite3.Row
                rows = conn.execute(
                    "SELECT rowid, * FROM bets WHERE status = 'signal_assigned'"
                ).fetchall()

            logging.info("📊 [SignalMonitor] Found %d rows with status='signal_assigned'", len(rows))

            now = datetime.utcnow().isoformat()

            for r in rows:
                m_id = r["marketId"]
                sel_id = r["selectionId"]
                strategy = (r["strategy_name"] or "").strip().lower()
                rule = SIGNAL_RULES.get(strategy)
                if not rule:
                    continue

                stake_cfg = rule["stake"]
                stake = stake_cfg.get(r["time_signal"]) if isinstance(stake_cfg, dict) else stake_cfg
                bots = rule["bots"][:1] if rule.get("limit") == 1 else rule["bots"]

                for bot in bots:
                    dup_suffix = _next_suffix()
                    dup_ref = f"{dup_suffix}_{bot[:3].upper()}"
                    logging.info("🔁 [SignalMonitor] Duplicating rowid=%s → %s", r["rowid"], dup_ref)

                    try:
                        params = (
                            stake,
                            rule["bet_type"],
                            now,  # placed_at
                            now,  # timestamp
                            bot,
                            dup_ref,
                            r["rowid"]
                        )

                        enqueue_write(
                            """
                            INSERT OR IGNORE INTO bets (
                                marketId, selectionId, stake, odds, bet_type, placed_at, status,
                                matched_liability, unmatched_liability, pnl, liability, result,
                                timestamp, matched_timestamp, betfair_bet_id, horse_name,
                                strategy_name, signal_type, bot_name, date, time_signal,
                                can_accept_liability, time_session, race_name, market_name, event_name,
                                anchor_odd, odds_check_1, odds_check_2, odds_check_3, odds_check_4,
                                odds_check_5, odds_check_6, customerOrderRef, bet_settled,
                                marketStartTime, meta_json, test_mode
                            )
                            SELECT marketId, selectionId, ?, odds, ?, ?, 'fully_enriched',
                                   matched_liability, unmatched_liability, pnl, liability, result,
                                   ?, matched_timestamp, betfair_bet_id, horse_name,
                                   strategy_name, signal_type, ?, date, time_signal,
                                   can_accept_liability, time_session, race_name, market_name, event_name,
                                   anchor_odd, odds_check_1, odds_check_2, odds_check_3, odds_check_4,
                                   odds_check_5, odds_check_6, ?, bet_settled,
                                   marketStartTime, meta_json, test_mode
                            FROM bets WHERE rowid = ?
                            """,
                            params
                        )
                        logging.info("📄 [SignalMonitor] Duplication made → %s as %s", bot, dup_ref)
                    except Exception as e:
                        logging.exception(f"❌ INSERT failed for rowid {r['rowid']} → {bot} / {dup_ref}")

                enqueue_write(
                    "UPDATE bets SET test_mode = 1 WHERE rowid = ?",
                    (r["rowid"],)
                )

        except Exception as e:
            logging.exception("❌ signal_monitor loop error:")

        if first_pass:
            signal_monitor_ready.set()
            risk_system_ready.set()
            logging.info("🚀 [SignalMonitor] First pass complete — risk and budget systems can proceed")
            first_pass = False

        time.sleep(20)

