                        "marketStartTime": row[35],
                        "event_name": row[25],
                        "race_name": row[23],
                        "stake": row[2],
                        "test_mode": row[37]
                    }

                    bot_name = row[18]
                    if bot_name in bot_signal_queues:
                        bot_signal_queues[bot_name].put(signal)
                        logging.info(f"📜 Routed to {bot_name} bot queue: {customerOrderRef}")
                    else:
                        logging.warning(f"❌ Bot queue not found for: {bot_name}")

                conn.commit()
                logging.info(f"✅ Budget Manager processed {len(rows)} row(s)")
        except Exception as e:
            logging.error(f"❌ budget_manager() error: {e}")
        time.sleep(10)

