                    logging.warning(f"⚠️ No snapshot clock for {marketId}, skipping.")
                    continue

                # ✅ Update status to match clock window
                correct_status = "upcoming" if 85 < minutes_to_off <= 90 else "pending" if minutes_to_off > 90 else None
                if correct_status and row["status"] != correct_status:
                    enqueue_write("""
                        UPDATE bets SET status = ?
                        WHERE marketId = ? AND selectionId = ?
                    """, (correct_status, marketId, selectionId))

                if minutes_to_off > 90:
                    continue

                logging.info(f"⏱️ [Runner Clock] {runner_name} → T-{int(minutes_to_off)} mins")

                for time_mark, signal_tag in zip([80, 60, 40, 20, 10, 5, 0],
                                     ["time_80", "time_60", "time_40", "time_20", "time_10", "time_5", "time_0"]):
    if minutes_to_off == time_mark:
        customerOrderRef = f"{marketId[-5:]}_{selectionId}_{time_mark}"[:32]
                    odds_data = fetch_live_odds(marketId=marketId, selectionId=selectionId, session_token=get_session_token())
                    odds = odds_data["lay"] if odds_data else None
