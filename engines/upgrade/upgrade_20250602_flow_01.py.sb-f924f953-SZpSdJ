                logging.info(f"📃 Queue Status – Head: {bot_signal_queues['OGHeadTrader'].qsize()}, Preoff: {bot_signal_queues['OGPreoff'].qsize()}, InPlay: {bot_signal_queues['OGInPlay'].qsize()}")

                for row in rows:
                    customerOrderRef = row[33]

                    required_fields = [
                        row[0], row[1], row[15], row[20], row[17], row[16],
                        row[4], row[18], row[33], row[35], row[25], row[23], row[2], row[37]
                    ]
                    if any(field is None for field in required_fields):
                        logging.warning(f"⚠️ Incomplete signal skipped: {customerOrderRef}")
                        continue

                    enqueue_write("UPDATE bets SET status = 'approved' WHERE customerOrderRef = ?", (customerOrderRef,))

                    signal = {
                        "marketId": row[0],
                        "selectionId": row[1],
                        "horse_name": row[15],
                        "time_signal": row[20],
                        "signal_type": row[17],
                        "strategy_name": row[16],
                        "bet_type": row[4],
                        "bot_name": row[18],
                        "customerOrderRef": customerOrderRef,
