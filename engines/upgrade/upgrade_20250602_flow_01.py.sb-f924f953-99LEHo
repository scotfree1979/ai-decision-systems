                    try:
                        import json
                        meta = json.loads(r['meta_json'] or '{}')
                        if 'scalp_direction' in rule:
                            meta['scalp_direction'] = rule['scalp_direction']

                        params = (
                            r["stake"],                   # stake
                            rule["bet_type"],             # bet_type
                            now,                          # placed_at
                            "fully_enriched",             # status
                            now,                          # timestamp
                            bot,                          # bot_name
                            dup_ref,                      # customerOrderRef
                            3,                            # test_mode
                            r["rowid"]                    # row ID
                        )
                        params = params[:35] + (json.dumps(meta),) + params[36:]

                        enqueue_write(
                            """
