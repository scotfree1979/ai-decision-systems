            with sqlite3.connect(DB_PATH, timeout=10) as conn:
                conn.row_factory = sqlite3.Row
                rows = conn.execute("""
                    SELECT rowid, * FROM bets
                    WHERE status = 'signal_assigned'
                    AND test_mode = 2
                    AND datetime(marketStartTime) BETWEEN datetime('now', '-15 minutes') AND datetime('now', '+25 minutes')
                    ORDER BY datetime(marketStartTime) ASC
                """).fetchall()

