                m_id = r["marketId"]
                sel_id = r["selectionId"]
                strategy = (r["strategy_name"] or "").strip().lower()
                rule = SIGNAL_RULES.get(strategy)
                if not rule:
                    continue

                stake_cfg = rule["stake"]
                stake = stake_cfg.get(r["time_signal"]) if isinstance(stake_cfg, dict) else stake_cfg
                bots = rule["bots"][:1] if rule.get("limit") == 1 else rule["bots"]

                for bot in bots:
                    dup_suffix = _next_suffix()
                    dup_ref = f"{dup_suffix}_{bot[:3].upper()}"
