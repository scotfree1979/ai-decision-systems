# ✅ SETTLEMENT SCHEDULE (Minutes After Market Start Time)
SETTLEMENT_INTERVALS = [5, 6, 10, 15, 20, 25, 30, 40, 50, 60]

# ✅ BET SETTLEMENT LOOP

def bet_settlement():
    logging.info("🏁 Bet Settlement Loop Started")
    while True:
        try:
            with sqlite3.connect(DB_PATH) as conn:
                cursor = conn.cursor()

                cursor.execute("""
                    SELECT * FROM bets
                    WHERE status = 'bet_placed' AND marketStartTime IS NOT NULL
                """)
                rows = cursor.fetchall()

                for row in rows:
                    market_id = row[0]
                    selection_id = row[1]
                    customer_order_ref = row[33]
                    market_start = row[35]
                    odds = row[3] or 0
                    stake = row[2] or 0

                    try:
                        market_start_dt = datetime.fromisoformat(market_start.replace("Z", "+00:00"))
                    except:
                        continue

                    minutes_since_off = int((datetime.utcnow() - market_start_dt).total_seconds() / 60)
                    if minutes_since_off < SETTLEMENT_INTERVALS[0]:
                        continue

                    cursor.execute("SELECT result FROM bets WHERE customerOrderRef = ?", (customer_order_ref,))
                    result = cursor.fetchone()
                    if result and result[0] is not None:
                        continue

                    if minutes_since_off in SETTLEMENT_INTERVALS:
                        cursor.execute("""
                            SELECT selectionId, odds FROM bets
                            WHERE marketId = ? AND status = 'bet_placed'
                        """, (market_id,))
                        market_odds = cursor.fetchall()

                        winning_selection = next((sel_id for sel_id, final_odds in market_odds if final_odds == 1.01), None)

                        if winning_selection == selection_id:
                            result_col = "won"
                            pnl = stake
                        else:
                            result_col = "lost"
                            pnl = -stake * (odds - 1)

                        betfair_id = row[14] if row[14] not in (None, "") else 0
                        matched_timestamp = datetime.utcnow().isoformat()

                        cursor.execute("""
                            UPDATE bets SET
                                result = ?,
                                pnl = ?,
                                status = 'settled',
                                betfair_bet_id = ?,
                                matched_timestamp = ?,
                                matched_liability = ?,
                                unmatched_liability = 0
                            WHERE customerOrderRef = ?
                        """, (
                            result_col,
                            round(pnl, 2),
                            betfair_id,
                            matched_timestamp,
                            stake,
                            customer_order_ref
                        ))

                        logging.info(f"✅ Settled {customer_order_ref} – Result: {result_col}, PnL: {round(pnl, 2)}")

                    elif minutes_since_off > SETTLEMENT_INTERVALS[-1]:
                        cursor.execute("""
                            UPDATE bets SET
                                result = 'unknown',
                                pnl = 0,
                                status = 'settled',
                                betfair_bet_id = 0,
                                matched_timestamp = ?,
                                matched_liability = 0,
                                unmatched_liability = 0
                            WHERE customerOrderRef = ?
                        """, (
                            datetime.utcnow().isoformat(),
                            customer_order_ref
                        ))

                        logging.warning(f"⚠️ Forced settlement: No winner found for {customer_order_ref} after 60 mins.")

                conn.commit()
        except Exception as e:
            logging.error(f"❌ bet_settlement loop failed: {e}")

        time.sleep(60)

