                        )
                        logging.info("📄 [SignalMonitor] Duplication made → %s as %s", bot, dup_ref)
                    except Exception as e:
                        logging.exception(f"❌ INSERT failed for rowid {r['rowid']} → {bot} / {dup_ref}")

