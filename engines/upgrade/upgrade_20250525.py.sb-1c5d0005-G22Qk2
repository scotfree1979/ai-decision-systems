def run_monitor():
    logging.info("📜 Starting run_monitor() – tracking all countdowns")
    while True:
        now = get_simulated_now()
        session_token = os.environ.get("SESSION_TOKEN", "NO_TOKEN")
        markets = fetch_market_data()

        if markets:
            with sqlite3.connect(DB_PATH) as conn:
                cursor = conn.cursor()

                if TEST_MODE:
                    cursor.execute("DELETE FROM bets WHERE test_mode = 1")

                for market in markets:
                    market_id = market["marketId"]
                    market_name = market["marketName"]
                    market_start = market["marketStartTime"]
                    event = market["event"]
                    event_name = event["name"]

                    dt = datetime.fromisoformat(market_start.replace("Z", "+00:00"))
                    minutes_to_off = (dt - now).total_seconds() / 60

                    for mode in ([0, 1] if TEST_MODE else [0]):
                        clock_label = "TEST " if mode == 1 else ""
                        logging.info(f"🕒 [Clock] {clock_label}{event_name} | {market_name} → Off at {dt.strftime('%H:%M')} | {int(minutes_to_off)} min to off")

                        for runner in market["runners"]:
                            selection_id = runner["selectionId"]
                            runner_name = runner["runnerName"]

                            if minutes_to_off < -6:
                                cursor.execute("""
                                    UPDATE bets SET status = 'ended'
                                    WHERE marketId = ? AND selectionId = ? AND test_mode = ?
                                """, (market_id, selection_id, mode))
                                logging.info(f"🏁 Marked as ended: {selection_id} in market {market_id}")
                                continue

                            time_signal = "upcoming"
                            try:
                                in_play_resp = requests.post(
                                    url="https://api.betfair.com/exchange/betting/json-rpc/v1",
                                    headers={
                                        "X-Application": APP_KEY,
                                        "X-Authentication": session_token,
                                        "Content-Type": "application/json"
                                    },
                                    data=json.dumps([{
                                        "jsonrpc": "2.0",
                                        "method": "SportsAPING/v1.0/listMarketBook",
                                        "params": {"marketIds": [market_id]},
                                        "id": 1
                                    }])
                                )
                                market_book = in_play_resp.json()[0].get("result", [])[0]
                                if market_book.get("inPlay"):
                                    time_signal = "time_0"
                            except Exception as e:
                                logging.warning(f"⚠️ Could not fetch inPlay status for {market_id}: {e}")

                            for upper, lower, tag in [(80, 60, "time_80"), (60, 40, "time_60"), (40, 20, "time_40"),
                                                      (20, 10, "time_20"), (10, 5, "time_10"), (5, 2, "time_5"), (2, -1, "time_0")]:
                                if lower < minutes_to_off <= upper:
                                    time_signal = tag
                                    break

                            customer_order_ref = f"{market_id[-5:]}_{selection_id}_anchor_test{mode}"[:32]
                            cursor.execute("SELECT 1 FROM bets WHERE customerOrderRef = ?", (customer_order_ref,))
                            exists = cursor.fetchone()

                            if not exists:
                                try:
                                    odds = fetch_live_odds(session_token, market_id, selection_id)
                                    if not odds:
                                        continue
                                    meta_json = json.dumps({"back_odds": odds})
                                    cursor.execute("""
                                        INSERT INTO bets (
                                            marketId, selectionId, horse_name, event_name, market_name, marketStartTime,
                                            status, date, time_signal, test_mode, odds, anchor_odd, customerOrderRef, meta_json
                                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                                    """, (
                                        market_id, selection_id, runner_name, event_name, market_name, market_start,
                                        "pending", now.strftime("%Y-%m-%d"), time_signal, mode,
                                        odds, odds, customer_order_ref, meta_json
                                    ))
                                except Exception as e:
                                    logging.warning(f"⚠️ Failed to insert seed market: {market_id} / {selection_id} | {e}")

                            else:
                                cursor.execute("""
                                    UPDATE bets SET time_signal = ?
                                    WHERE marketId = ? AND selectionId = ? AND test_mode = ?
                                """, (time_signal, market_id, selection_id, mode))
                                logging.info(f"🔄 Updated time_signal to {time_signal} for {selection_id}")

            conn.commit()
            logging.info(f"✅ Seeded {len(markets)} markets into bets table.")

        time.sleep(60)

def start_run_monitor():
    threading.Thread(target=run_monitor, name="RunMonitorLoop", daemon=True).start()
