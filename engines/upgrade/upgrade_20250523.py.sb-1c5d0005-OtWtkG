# ✅ Feature toggles
USE_MARKET_TYPE_FILTER = True    # Only WIN markets if True
USE_RUNNER_COUNT_FILTER = False  # Skip <8 runners if True

from timing_upgrade import normalize_market_time

def upgrade_monitor():
    logging.warning("🐛 DEBUG: upgrade_monitor from upgrade_20250523.py is running")
    log_system_initialization()
    session_token = os.environ.get("SESSION_TOKEN", "NO_TOKEN")

    while True:
        try:
            from upgrade.upgrade_20250522 import wrap_run_monitor
            markets = []

            try:
                logging.info("🚀 Fetching market catalogue from Betfair...")
                response = requests.post(
                    "https://api.betfair.com/exchange/betting/json-rpc/v1",
                    headers={
                        "X-Application": "CZHojduNWa3kxWIn",
                        "X-Authentication": session_token,
                        "Content-Type": "application/json"
                    },
                    data=json.dumps([
                        {
                            "jsonrpc": "2.0",
                            "method": "SportsAPING/v1.0/listMarketCatalogue",
                            "params": {
                                "filter": {
                                    "eventTypeIds": ["7"],
                                    "marketCountries": ["GB", "IE"],
                                    **({"marketTypeCodes": ["WIN"]} if USE_MARKET_TYPE_FILTER else {}),
                                    "marketStartTime": {
                                        "from": datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
                                        "to": (datetime.utcnow() + timedelta(days=1)).strftime("%Y-%m-%dT%H:%M:%SZ")
                                    }
                                },
                                "marketProjection": ["RUNNER_DESCRIPTION"],
                                "maxResults": "200"
                            },
                            "id": 1
                        }
                    ])
                )

                raw_markets = response.json()[0].get("result", []) if response.status_code == 200 else []
                logging.info(f"📆 Total raw_markets fetched: {len(raw_markets)}")

                for m in raw_markets:
                    try:
                        market_time = normalize_market_time(m['marketStartTime'])
                        seconds_to_off = (market_time - datetime.utcnow()).total_seconds()
                        if seconds_to_off > 4800:
                            if USE_RUNNER_COUNT_FILTER and len(m.get('runners', [])) <= 7:
                                logging.info(f"⛔ Skipped (<=7 runners): {m['marketName']}")
                                continue
                            markets.append(m)
                    except Exception as e:
                        logging.warning(f"⚠️ Skipped market due to bad startTime: {m.get('marketName', 'unknown')} | Error: {e}")

                if not markets:
                    logging.warning("⚠️ [Upgrade] No valid WIN markets with 7+ runners found.")
                else:
                    logging.info(f"🧪 wrap_run_monitor() called with {len(markets)} markets")

            except Exception as fetch_err:
                logging.error(f"❌ Failed to fetch market catalogue: {fetch_err}")

            logging.info(f"🎯 [Test Mode] Open market filter applied: {len(markets)} markets fetched")
            wrap_run_monitor(signal_queue, session_token, markets)
            logging.info("🔁 wrap_run_monitor() completed successfully")

        except Exception as e:
            logging.error(f"🛑 Unhandled exception during upgrade_monitor: {e}")
            logging.warning("🧠 Please consult AI for assistance with this error stack.")

        logging.info("🔄 [Upgrade] Run Monitor Cycle Complete")

        if datetime.utcnow().hour < 5:
            logging.info("🌍 [Filter] Returning to GB/IE-only filtering tomorrow.")
            break

        time.sleep(60)
