def fetch_market_data():
    logging.info("📱 Fetching live WIN markets with 7+ runners...")
    session_token = os.environ.get("SESSION_TOKEN", SESSION_TOKEN)

    from_time = datetime.utcnow().replace(hour=0, minute=0, second=0, microsecond=0)
    to_time = from_time + timedelta(hours=23, minutes=59)

    try:
        response = requests.post(
            url="https://api.betfair.com/exchange/betting/json-rpc/v1",
            headers={
                "X-Application": APP_KEY,
                "X-Authentication": session_token,
                "Content-Type": "application/json"
            },
            data=json.dumps([
                {
                    "jsonrpc": "2.0",
                    "method": "SportsAPING/v1.0/listMarketCatalogue",
                    "params": {
                        "filter": {
                            "eventTypeIds": ["7"],
                            "marketCountries": ["GB", "IE"],
                            "marketTypeCodes": ["WIN"],
                            "marketStartTime": {
                                "from": from_time.strftime("%Y-%m-%dT%H:%M:%SZ"),
                                "to": to_time.strftime("%Y-%m-%dT%H:%M:%SZ")
                            }
                        },
                        "marketProjection": ["RUNNER_DESCRIPTION", "MARKET_START_TIME", "EVENT"],
                        "sort": "FIRST_TO_START",
                        "maxResults": "50"
                    },
                    "id": 1
                }
            ])
        )

        markets = response.json()[0].get("result", []) if response.status_code == 200 else []
        filtered = [m for m in markets if len(m.get("runners", [])) >= 7]
        logging.info(f"🎯 Filter complete: {len(filtered)} markets ready")
        return filtered

    except Exception as e:
        logging.error(f"❌ Error fetching markets: {e}")
        return []

def build_ref(meeting_code, distance_code, selection_id, suffix=""):
    return f"{meeting_code}_{distance_code}_{selection_id}{suffix}"

def extract_codes(market_name, event_name):
    meeting_code = event_name[:3].upper()
    distance_code = "".join(part[0] for part in market_name.split() if part[-1] in ["m", "f", "M", "F"]).upper()
    return meeting_code, distance_code

def run_monitor():
    logging.info("📜 Starting run_monitor() – tracking all countdowns")

    while True:
        now = get_simulated_now()
        session_token = os.environ.get("SESSION_TOKEN", SESSION_TOKEN)
        markets = fetch_market_data()

        if markets:
            with sqlite3.connect(DB_PATH) as conn:
                cursor = conn.cursor()
                mode = 1 if TEST_MODE else 0
                if TEST_MODE:
                    cursor.execute("DELETE FROM bets WHERE test_mode = 1")

                for market in markets:
                    market_id = market["marketId"]
                    market_name = market["marketName"]
                    market_start = market["marketStartTime"]
                    event = market["event"]
                    event_name = event["name"]
                    dt = datetime.fromisoformat(market_start.replace("Z", "+00:00"))
                    minutes_to_off = (dt - now).total_seconds() / 60

                    is_off = check_market_off_flag(market_id)
                    if is_off and market_id not in OFF_FLAGS:
                        OFF_FLAGS[market_id] = now
                        logging.info(f"📍 OFF flag detected for market {market_id} at {now.isoformat()}")

                    if market_id in OFF_FLAGS:
                        since = (now - OFF_FLAGS[market_id]).total_seconds() / 60
                        if since > 60:
                            logging.info(f"🛑 Market {market_id} OFF > 60min. Skipping.")
                            continue

                    clock_label = "TEST " if TEST_MODE else ""
                    logging.info(f"🕒 [{clock_label}Clock] {event_name} | {market_name} → Off at {dt.strftime('%H:%M')} | {int(minutes_to_off)} min to off")

                    meeting_code, distance_code = extract_codes(market_name, event_name)

                    for runner in market["runners"]:
                        selection_id = runner["selectionId"]
                        runner_name = runner["runnerName"]

                        if minutes_to_off < -6:
                            cursor.execute("""
                                UPDATE bets SET status = 'ended'
                                WHERE marketId = ? AND selectionId = ? AND test_mode = ?
                            """, (market_id, selection_id, mode))
                            continue

                        time_signal = "upcoming"
                        for upper, lower, tag in [(80, 60, "time_80"), (60, 40, "time_60"), (40, 20, "time_40"), (20, 10, "time_20")]:
                            if lower < minutes_to_off <= upper:
                                time_signal = tag
                                break

                        base_ref = build_ref(meeting_code, distance_code, selection_id)
                        cursor.execute("SELECT * FROM bets WHERE customerOrderRef = ?", (base_ref,))
                        base_row = cursor.fetchone()

                        if not base_row:
                            try:
                                odds = fetch_live_odds(session_token, market_id, selection_id)
                                if not odds or odds.get("lay") is None:
                                    continue
                                meta_json = json.dumps({"back_odds": odds.get("back")})
                                cursor.execute("""
                                    INSERT INTO bets (
                                        marketId, selectionId, horse_name, event_name, market_name, marketStartTime,
                                        status, date, time_signal, test_mode, odds, anchor_odd, odds_check_1, customerOrderRef, meta_json
                                    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                                """, (
                                    market_id, selection_id, runner_name, event_name, market_name, market_start,
                                    "pending", now.strftime("%Y-%m-%d"), time_signal, mode,
                                    odds["lay"], odds["lay"], odds["lay"], base_ref, meta_json
                                ))
                            except Exception:
                                continue
                        else:
                            cursor.execute("""
                                UPDATE bets SET time_signal = ?
                                WHERE marketId = ? AND selectionId = ? AND test_mode = ?
                            """, (time_signal, market_id, selection_id, mode))
                            logging.info(f"🔄 Updated time_signal to {time_signal} for {selection_id}")

                            odds = fetch_live_odds(session_token, market_id, selection_id)
                            if odds and odds.get("lay"):
                                if time_signal == "time_20":
                                    cursor.execute("UPDATE bets SET odds_check_2 = ? WHERE customerOrderRef = ?", (odds["lay"], base_ref))
                                elif time_signal == "time_10":
                                    cursor.execute("UPDATE bets SET odds_check_3 = ? WHERE customerOrderRef = ?", (odds["lay"], base_ref))
                                elif time_signal == "time_5":
                                    cursor.execute("UPDATE bets SET odds_check_4 = ? WHERE customerOrderRef = ?", (odds["lay"], base_ref))
                                elif time_signal == "time_0":
                                    cursor.execute("UPDATE bets SET odds_check_5 = ? WHERE customerOrderRef = ?", (odds["lay"], base_ref))

                            time_order = ["time_20", "time_10", "time_5", "time_0"]
                            current_index = time_order.index(time_signal) if time_signal in time_order else -1

                            for key in time_order:
                                key_index = time_order.index(key)
                                if current_index >= key_index:
                                    suffix = TIME_SUFFIXES[key]
                                    new_ref = build_ref(meeting_code, distance_code, selection_id, suffix)
                                    cursor.execute("SELECT 1 FROM bets WHERE customerOrderRef = ?", (new_ref,))
                                    exists = cursor.fetchone()
                                    if not exists:
                                        cursor.execute("SELECT * FROM bets WHERE customerOrderRef = ?", (base_ref,))
                                        values = cursor.fetchone()
                                        columns = [d[0] for d in cursor.description]
                                        if values:
                                            row = dict(zip(columns, values))
                                            row["customerOrderRef"] = new_ref
                                            row["status"] = "awaiting_signal"
                                            row["time_signal"] = key
                                            row["odds"] = row.get("odds") or row.get("anchor_odd")
                                            cursor.execute(f"""
                                                INSERT INTO bets ({', '.join(row.keys())})
                                                VALUES ({', '.join(['?'] * len(row))})
                                            """, list(row.values()))
                                            logging.info(f"📋 Duplicated row for {key}: {new_ref}")
            conn.commit()
        time.sleep(60)

