def dispatch_bet_by_strategy(signal):
    strategy = signal.get("strategy_name")
    ref = signal.get("customerOrderRef")

    # 🔧 TEMP UNIQUE FIX: Append UUID fragment to ensure uniqueness
    unique_ref = f"{ref}_BET_{str(uuid.uuid4())[:4]}"
    signal["customerOrderRef"] = unique_ref

    if strategy == "ladder":
        logging.info(f"🩜 Routing to ladder strategy for {unique_ref}")
        _dispatch_ladder_bet(signal)

    elif strategy == "scalp":
        logging.info(f"⚡ Routing to scalp strategy for {unique_ref}")
        _dispatch_scalp_bet(signal)

    elif strategy == "greenup":
        logging.info(f"🜩 Routing to greenup strategy via Head Trader (time_5 + pre-off sync) for {unique_ref}")
        _dispatch_greenup(signal)

    elif strategy == "fillkill":
        logging.info(f"🩻 Routing to in-play fill/kill for {unique_ref}")
        _dispatch_fill_kill(signal)

    elif strategy == "basic_lay":
        logging.info(f"🔹 Routing to basic lay bet for {unique_ref}")
        place_bet(
            signal.get("session_token"),
            signal.get("marketId"),
            signal.get("selectionId"),
            signal.get("stake"),
            signal.get("odds"),
            "LAY",
            unique_ref
        )

    else:
        logging.warning(f"⚠️ Unknown strategy_name: {strategy} on signal {unique_ref}")

# -----------------------------
# ✅ LADDER STRATEGY LOGIC
# -----------------------------

def _dispatch_ladder_bet(signal):
    session_token = signal.get("session_token")
    market_id = signal.get("marketId")
    selection_id = signal.get("selectionId")
    odds = signal.get("odds")
    stake = signal.get("stake") or 2.0

    ladder_orders = calculate_ladder_bets(selection_id, odds, stake)
    for bet in ladder_orders:
        place_bet(session_token, market_id, selection_id, bet['stake'], bet['odds'], "LAY", bet['ref'])

# -----------------------------
# ✅ SCALPING STRATEGY ENTRY
# -----------------------------

def _dispatch_scalp_bet(signal):
    try:
        anchor_odd = signal.get("anchor_odd")
        odds_check_3 = signal.get("odds_check_3")

        if anchor_odd and odds_check_3:
            anchor_prob = 1 / float(anchor_odd)
            current_prob = 1 / float(odds_check_3)
            change_pct = ((current_prob - anchor_prob) / anchor_prob) * 100
            direction = "back_to_lay" if change_pct > 0 else "lay_to_back"
        else:
            direction = "lay_to_back"

        signal["scalp_direction"] = direction
        place_lay_strategy(signal, tag="Scalp")
        signal["bet_type"] = "BACK" if direction == "back_to_lay" else "LAY"

    except Exception as e:
        logging.error(f"❌ Scalping execution failed: {e}")

# -----------------------------
# ✅ GREENUP STRATEGY CALL
# -----------------------------

def _dispatch_greenup(signal):
    session_token = signal.get("session_token")
    market_id = signal.get("marketId")
    try:
        green_up(session_token, market_id, target_profit=15.0)
    except Exception as e:
        logging.error(f"❌ GreenUp failed: {e}")

