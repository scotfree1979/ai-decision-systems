import sqlite3
import logging
import json
import time
import threading
from datetime import datetime
from daily_config import TEST_MODE
import os
from utils.time_helpers import get_simulated_now


DB_PATH = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db"

SIGNAL_CODE_MAP = {
    'Market Drifter Signal': 'MDS',
    'Market Steamer Signal': 'MSS',
    'Drifter Recovery Signal': 'DRS',
    'Late Surge Fade Signal': 'LSF',
    'Odds Spike Reversal Signal': 'OSR',
    'Early Value Signal': 'EVS',
    'Favourite Vulnerability Signal': 'FVS',
    'Volume Surge Signal': 'VSS',
    'Market Inefficiency Signal': 'MIS',
    'Multiple Beacon Confirmation Signal': 'MBC',
    'Historical Edge Signal': 'HES',
    'Fast Pace Collapse Signal': 'FPC',
    'Early Leader Stamina Doubt Signal': 'ESD',
    'GreenUp 5-Minute Signal': 'GUP'
}

TIME_SIGNAL_DEFAULTS = {
    'time_20': 'Early Value Signal',
    'time_10': 'Scalp Lay Signal',
    'time_5': 'GreenUp 5-Minute Signal',
    'time_0': 'Late Surge Fade Signal'
}

SIGNAL_TYPES = list(SIGNAL_CODE_MAP.keys())


def detect_signal(anchor_odds, current_odds, volatility_meta, time_signal):
    signals = []
    try:
        change = ((1 / current_odds) - (1 / anchor_odds)) / (1 / anchor_odds) * 100
    except ZeroDivisionError:
        return []

    if time_signal == 'time_20':
        signals.append('Early Value Signal')
    elif time_signal == 'time_10':
        if change >= 7.5:
            signals.append('Market Steamer Signal')
        elif change <= -7.5:
            signals.append('Market Drifter Signal')
    elif time_signal == 'time_5':
        signals.append('GreenUp 5-Minute Signal')
    elif time_signal == 'time_0':
        if change >= 7.5:
            signals.append('Market Steamer Signal')
        elif change <= -7.5:
            signals.append('Market Drifter Signal')

        if current_odds >= anchor_odds + 3:
            signals.append('Odds Spike Reversal Signal')
        if current_odds <= anchor_odds - 2:
            signals.append('Late Surge Fade Signal')
        if anchor_odds * 1.2 >= current_odds > anchor_odds:
            signals.append('Drifter Recovery Signal')

        if volatility_meta.get('volume_spike'):
            signals.append('Volume Surge Signal')
        if volatility_meta.get('odds_discrepancy'):
            signals.append('Market Inefficiency Signal')
        if volatility_meta.get('beacon_combo'):
            signals.append('Multiple Beacon Confirmation Signal')
        if volatility_meta.get('fav_weakening'):
            signals.append('Favourite Vulnerability Signal')
        if volatility_meta.get('early_value'):
            signals.append('Early Value Signal')
        if volatility_meta.get('pace_collapse'):
            signals.append('Fast Pace Collapse Signal')
        if volatility_meta.get('stamina_doubt'):
            signals.append('Early Leader Stamina Doubt Signal')

    return signals


def market_monitor_signals():
    logging.info("🧵 MarketMonitor thread has started.")
    logging.info("🧐 Entered market_monitor_signals function.")
    time.sleep(10)
    logging.info("🔍 Starting market_monitor_signals loop...")

    while True:
        try:
            with sqlite3.connect(DB_PATH) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    SELECT * FROM bets
                    WHERE status = 'awaiting_signal' AND test_mode = ?
                """, (1 if TEST_MODE else 0,))
                rows = cursor.fetchall()
                col_names = [desc[0] for desc in cursor.description]
                inserted = 0

                for row in rows:
                    bet = dict(zip(col_names, row))
                    logging.info(f"🔎 Checking awaiting_signal row: {bet['customerOrderRef']}")

                    try:
                        meta = json.loads(bet['meta_json']) if bet['meta_json'] else {}
                    except Exception:
                        logging.warning(f"⚠️ Malformed meta_json for {bet['customerOrderRef']}")
                        continue

                    anchor = bet.get("odds_check_1") or bet.get("anchor_odd")
                    live_odds = meta.get('current_odds') or bet.get('odds')

                    if not live_odds or float(live_odds) <= 1.01 or not anchor:
                        logging.warning(f"⚠️ Skipped odds check: {bet['customerOrderRef']} → live={live_odds} | anchor={anchor}")
                        continue

                    volatility_meta = meta.get('volatility', {})
                    if not volatility_meta:
                        try:
                            swing = round(((float(anchor) - float(live_odds)) / float(anchor)) * 100, 2)
                            volatility_meta = {
                                "swing_percent": swing,
                                "volatility": (
                                    "HIGH" if abs(swing) > 25 else
                                    "MEDIUM" if abs(swing) > 10 else
                                    "LOW"
                                ),
                                "direction": (
                                    "IN" if swing < 0 else
                                    "OUT" if swing > 0 else
                                    "FLAT"
                                )
                            }
                            meta['volatility'] = volatility_meta
                            cursor.execute(
                                "UPDATE bets SET meta_json=? WHERE customerOrderRef=?",
                                (json.dumps(meta), bet['customerOrderRef'])
                            )
                            conn.commit()
                        except Exception as fallback_err:
                            logging.warning(f"⚠️ Volatility fallback failed for {bet['customerOrderRef']}: {fallback_err}")

                    signal_list = detect_signal(float(anchor), float(live_odds), volatility_meta, bet['time_signal'])

                    # ➕ Fallback Signal if none detected
                    if not signal_list:
                        fallback = TIME_SIGNAL_DEFAULTS.get(bet['time_signal'])
                        if fallback:
                            signal_list.append(fallback)

                    for signal in signal_list:
                        signal_code = SIGNAL_CODE_MAP.get(signal, 'UNK')
                        time_code = bet['time_signal'][-2:] if bet['time_signal'] else "XX"
                        suffix = f"_S{signal_code}{time_code}"
                        base = bet['customerOrderRef'][:32 - len(suffix)]
                        new_ref = f"{base}{suffix}"

                        cursor.execute("SELECT COUNT(*) FROM bets WHERE customerOrderRef = ?", (new_ref,))
                        if cursor.fetchone()[0] > 0:
                            logging.info(f"⚠️ Skipped duplicate signal ref: {new_ref}")
                            continue

                        new_bet = bet.copy()
                        new_bet['status'] = 'signal_assigned'
                        new_bet['signal_type'] = signal
                        new_bet['strategy_name'] = signal
                        new_bet['timestamp'] = datetime.utcnow().isoformat()
                        new_bet['customerOrderRef'] = new_ref
                        new_bet['odds'] = live_odds

                        fields = list(new_bet.keys())
                        values = [new_bet[field] for field in fields]

                        cursor.execute(f"""
                            INSERT INTO bets ({', '.join(fields)})
                            VALUES ({', '.join(['?'] * len(fields))})
                        """, values)
                        inserted += 1
                        logging.info(f"✅ Inserted signal row: {new_ref}")

