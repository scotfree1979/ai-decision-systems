    messages = [
        "✅ Market Monitor Initialized",
        "✅ Signal Monitor Active",
        "✅ Risk Manager Engaged",
        "✅ Budget Manager Online",
        "✅ Bot Queues Live",
        "✅ Thread Launch Confirmed"
    ]
    for msg in messages:
        logging.info(msg)

def normalize_market_time(market_start):
    try:
        return datetime.strptime(market_start, "%Y-%m-%dT%H:%M:%S.%fZ")
    except ValueError:
        return datetime.strptime(market_start, "%Y-%m-%dT%H:%M:%SZ")

def upgrade_monitor():
    print("🐛 DEBUG: upgrade_monitor() called from upgrade_20250523.py")
    log_system_initialization()
    session_token = os.environ.get("SESSION_TOKEN", "NO_TOKEN")

    while True:
        try:
            from upgrade.upgrade_20250522 import wrap_run_monitor
            markets = []

            try:
                print("🚀 Sending request to Betfair API...")
                response = requests.post(
                    "https://api.betfair.com/exchange/betting/json-rpc/v1",
                    headers={
                        "X-Application": "CZHojduNWa3kxWIn",
                        "X-Authentication": session_token,
                        "Content-Type": "application/json"
                    },
                    data=json.dumps([
                        {
                            "jsonrpc": "2.0",
                            "method": "SportsAPING/v1.0/listMarketCatalogue",
                            "params": {
                                "filter": {
                                    "eventTypeIds": ["7"],
                                    "marketCountries": ["GB", "IE"],
                                    **({"marketTypeCodes": ["WIN"]} if USE_MARKET_TYPE_FILTER else {}),
                                    "marketStartTime": {
                                        "from": datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
                                        "to": (datetime.utcnow() + timedelta(days=1)).strftime("%Y-%m-%dT%H:%M:%SZ")
                                    }
                                },
                                "marketProjection": ["RUNNER_DESCRIPTION"],
                                "maxResults": "200"
                            },
                            "id": 1
                        }
                    ])
                )

                raw_markets = response.json()[0].get("result", []) if response.status_code == 200 else []
                print(f"📦 Raw markets fetched: {len(raw_markets)}")

                for m in raw_markets:
                    try:
                        start_time_raw = m.get('marketStartTime') or m.get('marketStartTimeUtc')
                        if not start_time_raw:
                            raise KeyError("marketStartTime missing")

                        market_time = normalize_market_time(start_time_raw)
                        seconds_to_off = (market_time - datetime.utcnow()).total_seconds()
                        if seconds_to_off > 4800:
                            if USE_RUNNER_COUNT_FILTER and len(m.get('runners', [])) <= 7:
                                print(f"⛔ Skipped (<=7 runners): {m['marketName']}")
                                continue
                            print(f"✅ Market accepted: {m['marketName']} | Off in {int(seconds_to_off / 60)} min")
                            markets.append(m)
                    except Exception as e:
                        print(f"⚠️ Skipped market due to bad startTime: {m.get('marketName', 'unknown')} | Error: {e}")

                if not markets:
                    print("⚠️ [Upgrade] No valid WIN markets with 7+ runners found.")
                else:
                    print(f"🧪 wrap_run_monitor() called with {len(markets)} valid markets")

            except Exception as fetch_err:
                print(f"❌ Failed to fetch market catalogue: {fetch_err}")

            print(f"🎯 Filter complete: {len(markets)} markets ready")
            wrap_run_monitor(signal_queue, session_token, markets)
            print("🔁 wrap_run_monitor() completed successfully")

        except Exception as e:
            print(f"🛑 Unhandled exception during upgrade_monitor: {e}")
            print("🧠 Please consult AI for assistance with this error stack.")

        print("🔄 [Upgrade] Run Monitor Cycle Complete")

        if datetime.utcnow().hour < 5:
            print("🌍 [Filter] Returning to GB/IE-only filtering tomorrow.")
            break

        time.sleep(60)
