signal_queue = Queue()
race_runners = [8, 10, 15, 9, 18, 12, 14, 10, 11, 13]
TOTAL_PNL = 0

bot_signal_queues = {
    "OGHeadTrader": Queue(),
    "OGPreoff": Queue(),
    "OGInPlay": Queue()
}

# ✅ Feature toggles
USE_MARKET_TYPE_FILTER = True    # Only WIN markets if True
USE_RUNNER_COUNT_FILTER = False  # Skip <8 runners if True

def launch_protocol():
    with signal_queue.mutex:
        signal_queue.queue.clear()
    for q in bot_signal_queues.values():
        with q.mutex:
            q.queue.clear()
    logging.info("✅ System boot sequence complete.")

