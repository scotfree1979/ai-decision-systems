def _dispatch_ladder_bet(signal):
    session_token = signal.get("session_token")
    market_id = signal.get("marketId")
    selection_id = signal.get("selectionId")
    odds = signal.get("odds")
    stake = signal.get("stake") or 2.0

    ladder_orders = calculate_ladder_bets(selection_id, odds, stake)
    for bet in ladder_orders:
        place_bet(session_token, market_id, selection_id, bet['stake'], bet['odds'], "LAY", bet['ref'])

# -----------------------------
