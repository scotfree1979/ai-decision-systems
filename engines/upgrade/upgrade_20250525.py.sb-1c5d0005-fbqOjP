SIGNAL_TYPES = [
    'Market Drifter Signal', 'Market Steamer Signal', 'Drifter Recovery Signal', 'Late Surge Fade Signal',
    'Odds Spike Reversal Signal', 'Early Value Signal', 'Favourite Vulnerability Signal', 'Volume Surge Signal',
    'Market Inefficiency Signal', 'Multiple Beacon Confirmation Signal', 'Historical Edge Signal',
    'Fast Pace Collapse Signal', 'Early Leader Stamina Doubt Signal'
]

# -----------------------------
# ✅ SIGNAL DETECTION LOGIC
# -----------------------------
def detect_signal(anchor_odds, current_odds, volatility_meta):
    signals = []
    change = ((1 / current_odds) - (1 / anchor_odds)) / (1 / anchor_odds) * 100

    if change >= 7.5:
        signals.append('Market Steamer Signal')
    elif change <= -7.5:
        signals.append('Market Drifter Signal')

    if current_odds >= anchor_odds + 3:
        signals.append('Odds Spike Reversal Signal')
    if current_odds <= anchor_odds - 2:
        signals.append('Late Surge Fade Signal')
    if anchor_odds * 1.2 >= current_odds > anchor_odds:
        signals.append('Drifter Recovery Signal')

    if volatility_meta.get('volume_spike'):
        signals.append('Volume Surge Signal')
    if volatility_meta.get('odds_discrepancy'):
        signals.append('Market Inefficiency Signal')
    if volatility_meta.get('beacon_combo'):
        signals.append('Multiple Beacon Confirmation Signal')
    if volatility_meta.get('fav_weakening'):
        signals.append('Favourite Vulnerability Signal')
    if volatility_meta.get('early_value'):
        signals.append('Early Value Signal')
    if volatility_meta.get('pace_collapse'):
        signals.append('Fast Pace Collapse Signal')
    if volatility_meta.get('stamina_doubt'):
        signals.append('Early Leader Stamina Doubt Signal')

    return signals

# -----------------------------
# ✅ PART 4: market_monitor_signals()
# -----------------------------
def market_monitor_signals():
    time.sleep(10)  # ⏱️ Delay start to ensure database seeding completes first
    while True:
        try:
            with sqlite3.connect(DB_PATH) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    SELECT * FROM bets
                    WHERE status = 'awaiting_signal'
                """)
                rows = cursor.fetchall()
                col_names = [desc[0] for desc in cursor.description]

                inserted = 0
                for row in rows:
                    bet = dict(zip(col_names, row))

                    if not bet['anchor_odd'] or not bet['odds_check_6']:
                        try:
                            meta = json.loads(bet['meta_json']) if bet['meta_json'] else {}
                            bet['anchor_odd'] = bet['anchor_odd'] or meta.get('anchor_odd', 0)
                            bet['odds_check_6'] = bet['odds_check_6'] or meta.get('odds_check_6', 0)
                        except Exception as meta_err:
                            continue

                    live_odds = bet['odds_check_6']
                    if bet.get('test_mode') == '1':
                        try:
                            meta = json.loads(bet['meta_json']) if bet['meta_json'] else {}
                            live_odds = meta.get('live_odds', bet['odds_check_6'])
                        except Exception:
                            pass
                    else:
                        fetched_odds = fetch_live_odds(os.environ.get("SESSION_TOKEN", ""), bet['marketId'], bet['selectionId'])
                        if fetched_odds:
                            live_odds = fetched_odds

                    volatility_meta = real_time_volatility_check(bet['marketId'], bet['selectionId'], live_odds)
                    signal_list = detect_signal(bet['anchor_odd'], live_odds, volatility_meta)
                    if not signal_list:
                        continue

                    for signal in signal_list:
                        signal_code = signal.replace(" ", "")[0:3].upper()
                        time_code = bet['time_signal'][-2:] if bet['time_signal'] else "XX"
                        suffix = f"_S{signal_code}{time_code}"
                        base = bet['customerOrderRef'][:32 - len(suffix)]
                        new_ref = f"{base}{suffix}"

                        cursor.execute("SELECT COUNT(*) FROM bets WHERE customerOrderRef = ?", (new_ref,))
                        if cursor.fetchone()[0] > 0:
                            continue

                        bet['status'] = 'signal_assigned'
                        bet['signal_type'] = signal
                        bet['strategy_name'] = signal
                        bet['timestamp'] = datetime.utcnow().isoformat()
                        bet['customerOrderRef'] = new_ref
                        bet['odds'] = live_odds

                        fields = list(bet.keys())
                        values = [bet[field] for field in fields]

                        cursor.execute(f"""
                            INSERT INTO bets ({', '.join(fields)})
                            VALUES ({', '.join(['?'] * len(fields))})
                        """, values)
                        inserted += 1

                conn.commit()
                if inserted > 0:
                    logging.info(f"🚀 Signal assignment complete. Inserted {inserted} new rows.")

        except Exception as e:
            logging.error(f"❌ Error in market_monitor_signals loop: {e}")
        
        time.sleep(20)  # 🔁 add delay to reduce spam

def start_market_monitor():
    threading.Thread(target=market_monitor_signals, name="MarketMonitor", daemon=True).start()

