###1 TRADE STRUCTURE SETUP
# Group linked trades by signal: Entry, Hedge, Stop + Enhanced Range Logic

def build_trade_group(signal):
    from upgrade_import_patch import get_tick_size

    suffix = signal.get("customerOrderRef", _next_suffix())
    tick_size = get_tick_size(signal["odds"])
    ticks = signal.get("scalp_ticks", 2)

    return {
        "entry": {
            "side": "LAY" if signal["scalp_direction"] == "lay_to_back" else "BACK",
            "odds": signal["odds"],
            "stake": signal["stake"],
            "ref": f"{suffix}_E"
        },
        "hedge": {
            "side": "BACK" if signal["scalp_direction"] == "lay_to_back" else "LAY",
            "ticks": ticks,
            "ref": f"{suffix}_H"
        },
        "stop": {
            "side": "BACK" if signal["scalp_direction"] == "lay_to_back" else "LAY",
            "ticks": ticks * 3,
            "ref": f"{suffix}_S"
        },
        "meta": {
            "group_id": suffix,
            "direction": signal["scalp_direction"],
            "marketId": signal["marketId"],
            "selectionId": signal["selectionId"],
            "tick_size": tick_size
        }
    }


###2 SMART SCALPING LOGIC – Now with Enhanced Directional Entry

def execute_smart_scalp(signal):
    from bet_core import place_bet, check_bet_matched, cancel_bet
    from scalping_engine import analyze_market_range, should_enter_scalp, determine_scalp_direction

    signal["session_token"] = get_session_token()
    signal["scalp_ticks"] = signal.get("scalp_ticks", 2)
    profile = analyze_market_range({"selectionId": signal["selectionId"], "ex": {"availableToBack": [{"price": signal["odds"]}], "availableToLay": [{"price": signal["odds"]}]}})

    if not profile:
        print("❌ No valid profile to run scalping strategy.")
        return

    direction = determine_scalp_direction(profile["anchor"], signal["odds"])
    signal["scalp_direction"] = direction

    if not should_enter_scalp(profile, signal["odds"]):
        print("🟡 Skipping scalp – entry logic not satisfied.")
        return

    group = build_trade_group(signal)
    tick_size = group["meta"]["tick_size"]
    marketId = signal["marketId"]
    selectionId = signal["selectionId"]
    session_token = signal["session_token"]

    # ▶️ Entry
    entry = group["entry"]
    entry_id = place_bet(session_token, marketId, selectionId, entry["stake"], entry["odds"], entry["side"], entry["ref"])
    if not entry_id:
        print("❌ Entry failed")
        return

    for _ in range(10):
        time.sleep(3)
        if check_bet_matched(session_token, entry_id):
            break
    else:
        cancel_bet(session_token, entry_id)
        print("⚠️ Entry unmatched. Cancelled.")
        return

    # ▶️ Hedge
    hedge = group["hedge"]
    hedge_odds = round(entry["odds"] - hedge["ticks"] * tick_size, 2) if entry["side"] == "LAY" else round(entry["odds"] + hedge["ticks"] * tick_size, 2)
    place_bet(session_token, marketId, selectionId, entry["stake"], hedge_odds, hedge["side"], hedge["ref"], persistence_type="PERSIST")

    # ▶️ Stop
    stop = group["stop"]
    stop_odds = round(entry["odds"] + stop["ticks"] * tick_size, 2) if entry["side"] == "LAY" else round(entry["odds"] - stop["ticks"] * tick_size, 2)
    stop_logic_tracker[selectionId] = {
        "odds": stop_odds,
        "side": stop["side"],
        "stake": entry["stake"],
        "ref": stop["ref"],
        "executed": False
    }


