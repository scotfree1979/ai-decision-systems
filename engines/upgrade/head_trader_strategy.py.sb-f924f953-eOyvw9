def intercept_brain_signals():
    from og_brain_logic import brain_memory

    seen_refs = set()

    while True:
        for sig in brain_memory["daily_signals"]:
            if isinstance(sig, dict) and sig.get("status") == "approved" and sig.get("customerOrderRef") not in seen_refs:
                seen_refs.add(sig.get("customerOrderRef"))
                sig["bot_name"] = "brain"
                route_signal_to_head_trader(sig)
        time.sleep(10)


