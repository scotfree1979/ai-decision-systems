import logging
import threading
import time
from datetime import datetime
from learning_optimizer import LearningOptimizer

class UpgradeHeadTrader:
    def __init__(self):
        self.system_watchdogs = {
            "queue_monitor": False,
            "upgrade_monitor": False,
            "bot_threads": False
        }
        self.optimizer = LearningOptimizer()
        self.optimizer_last_check = None
        self.strategy_profile = {}

        self.watchdog_thread = threading.Thread(target=self._watchdog_loop, name="watchdog_loop", daemon=True)
        self.watchdog_thread.start()

    def _watchdog_loop(self):
        while True:
            self.check_thread_health()
            time.sleep(300)

    def check_thread_health(self):
        active = threading.enumerate()
        for name in self.system_watchdogs.keys():
            self.system_watchdogs[name] = any(name in t.name for t in active)
        for k, v in self.system_watchdogs.items():
            status = "✅ RUNNING" if v else "❌ NOT RUNNING"
            logging.warning(f"🧠 [HeadTrader Watchdog] {k} thread status: {status}")

    def run_daily_optimizer(self):
        try:
            self.optimizer.run()
            self.strategy_profile = self.optimizer.stats.get("strategy_performance", {})
            logging.info("🧠 [UpgradeHeadTrader] Strategy profile updated.")
        except Exception as e:
            logging.error(f"❌ [UpgradeHeadTrader] Optimizer failed: {e}")

    def adjust_risk_weights(self, signal):
        strategy = signal.get("strategy_name")
        multiplier = self.strategy_profile.get(strategy, 1.0)
        signal["confidence"] = round(multiplier, 2)
        signal["stake"] = round(signal.get("stake", 5.0) * multiplier, 2)
        return signal

    def filter_strategies(self, signals):
        threshold = 0.2
        allowed = [s for s in signals if self.strategy_profile.get(s.get("strategy_name"), 1.0) >= threshold]
        rejected = [s for s in signals if s not in allowed]
        for r in rejected:
            logging.warning(f"🛑 [UpgradeHeadTrader] Signal rejected due to underperformance: {r.get('strategy_name')}")
        return allowed

    def orchestrate(self, signals):
        logging.info("🧠 [UpgradeHeadTrader] Starting orchestration with enhanced logic...")
        self.run_daily_optimizer()
        filtered = self.filter_strategies(signals)
        enriched = [self.adjust_risk_weights(s) for s in filtered]
        logging.info(f"✅ [UpgradeHeadTrader] {len(enriched)} signals passed strategy filter and were enriched.")
        return enriched

