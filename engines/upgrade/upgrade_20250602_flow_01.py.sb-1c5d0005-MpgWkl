# 🕒 CLOCK-ONLY COUNTDOWN LOOP

def get_time_to_off(start_time):
    from datetime import datetime, timezone
    now = datetime.now(timezone.utc)
    return int((start_time - now).total_seconds() / 60)


def run_clock_only():
    import time
    import logging
    from datetime import datetime

    logging.info("🕒 [Live Clock] Starting countdown loop...")
    while True:
        for marketId, snapshot in SNAPSHOT_DATA.items():
            try:
                start_time = snapshot.get("start_time")
                if not start_time:
                    continue
                minutes_to_off = get_time_to_off(start_time)
                logging.info(f"🕒 [Clock] {marketId}: {minutes_to_off} minutes to off")
            except Exception as e:
                logging.error(f"❌ [Clock Error] {marketId}: {e}")
        time.sleep(60)

