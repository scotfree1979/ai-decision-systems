import requests
import os
from daily_config import APP_KEY, SESSION_TOKEN

def get_racing_post_meta(marketId, selectionId):
    """
    Fetch enriched metadata for a runner from Betfair marketCatalogue.
    Includes fields like jockey, trainer, owner, form, draw, etc.
    """

    try:
        session_token = os.environ.get("SESSION_TOKEN", SESSION_TOKEN)

        headers = {
            "X-Application": APP_KEY,
            "X-Authentication": session_token,
            "Content-Type": "application/json"
        }

        payload = json.dumps([
            {
                "jsonrpc": "2.0",
                "method": "SportsAPING/v1.0/listMarketCatalogue",
                "params": {
                    "filter": {
                        "marketIds": [marketId]
                    },
                    "marketProjection": ["RUNNER_METADATA"],
                    "maxResults": "1"
                },
                "id": 1
            }
        ])

        response = requests.post(
            "https://api.betfair.com/exchange/betting/json-rpc/v1",
            headers=headers,
            data=payload
        )

        if response.status_code != 200:
            return {"source": "fallback", "jockey": "John Doe", "trainer": "Jane Smith"}

        market_catalogue = response.json()[0].get("result", [])
        if not market_catalogue:
            return {"source": "fallback", "jockey": "John Doe", "trainer": "Jane Smith"}

        runners = market_catalogue[0].get("runners", [])
        for runner in runners:
            if str(runner.get("selectionId")) == str(selectionId):
                metadata = runner.get("metadata", {})
                return {
                    "source": "betfair",
                    "jockey": metadata.get("JOCKEY_NAME", "Unknown"),
                    "trainer": metadata.get("TRAINER_NAME", "Unknown"),
                    "owner": metadata.get("OWNER_NAME", "Unknown"),
                    "form": metadata.get("FORM", "Unknown"),
                    "draw": metadata.get("DRAW", "Unknown"),
                    "weight": metadata.get("WEIGHT_VALUE", "Unknown"),
                    "age": metadata.get("AGE", "Unknown"),
                    "gear": metadata.get("HEAD_GEAR", "Unknown"),
                    "official_rating": metadata.get("OFFICIAL_RATING", "Unknown"),
                    "country": metadata.get("COUNTRY_CODE", "Unknown"),
                }

    except Exception as e:
        print(f"❌ get_racing_post_meta failed: {e}")

    # Fallback dummy structure
    return {"source": "fallback", "jockey": "John Doe", "trainer": "Jane Smith"}

