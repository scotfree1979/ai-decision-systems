def normalize_market_time(market_start):
    try:
        return datetime.strptime(market_start, "%Y-%m-%dT%H:%M:%S.%fZ")
    except ValueError:
        return datetime.strptime(market_start, "%Y-%m-%dT%H:%M:%SZ")

def upgrade_monitor():
    print("🐛 DEBUG: upgrade_monitor() called from upgrade_20250523.py")
    log_system_initialization()
    session_token = os.environ.get("SESSION_TOKEN", "NO_TOKEN")
    logging.info(f"📌 [DEBUG] signal_queue memory ID (upgrade_monitor): {id(signal_queue)}")

    try:
        markets = []

        print("🚀 Sending request to Betfair API...")
        response = requests.post(
            "https://api.betfair.com/exchange/betting/json-rpc/v1",
            headers={
                "X-Application": "CZHojduNWa3kxWIn",
                "X-Authentication": session_token,
                "Content-Type": "application/json"
            },
            data=json.dumps([{
                "jsonrpc": "2.0",
                "method": "SportsAPING/v1.0/listMarketCatalogue",
                "params": {
                    "filter": {
                        "eventTypeIds": ["7"],
                        "marketCountries": ["GB", "IE"],
                        **({"marketTypeCodes": ["WIN"]} if USE_MARKET_TYPE_FILTER else {}),
                        "marketStartTime": {
                            "from": datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
                            "to": (datetime.utcnow() + timedelta(days=1)).strftime("%Y-%m-%dT%H:%M:%SZ")
                        }
                    },
                    "marketProjection": ["RUNNER_DESCRIPTION", "MARKET_START_TIME"],
                    "maxResults": "200"
                },
                "id": 1
            }])
        )

        raw_markets = response.json()[0].get("result", []) if response.status_code == 200 else []

        # 🧪 Inject test market with runners mapped to 80, 60, 40, 20, 10, 5, 0 min sessions
        test_runners = []
        for i, mins in enumerate([80, 60, 40, 20, 10, 5, 0, 30, 50, 15, 25, 12, 18, 8, 3, 1], start=1):
            test_runners.append({
                "selectionId": 12345000 + i,
                "runnerName": f"Test Runner {mins}min",
                "marketStartTime": (datetime.utcnow() + timedelta(minutes=mins)).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
            })

        raw_markets.append({
            "marketId": "1.234567890",
            "marketName": "Test Session Market",
            "marketStartTime": (datetime.utcnow() + timedelta(minutes=80)).strftime("%Y-%m-%dT%H:%M:%S.%fZ"),
            "runners": test_runners
        })
        logging.info("🧪 [UpgradeMonitor] Injected multi-session test market")

        print(f"📦 Raw markets fetched: {len(raw_markets)}")

        for m in raw_markets:
            try:
                start_time_raw = m.get('marketStartTime') or m.get('marketStartTimeUtc')
                if not start_time_raw:
                    raise KeyError("marketStartTime missing")

                market_time = normalize_market_time(start_time_raw)
                seconds_to_off = (market_time - datetime.utcnow()).total_seconds()
                if seconds_to_off > 4800:
                    if len(m.get('runners', [])) <= 7:
                        print(f"⛔ Skipped (<=7 runners): {m['marketName']}")
                        continue
                    print(f"✅ Market accepted: {m['marketName']} | Off in {int(seconds_to_off / 60)} min")
                    try:
                        os.makedirs(os.path.dirname(SIGNALS_DB_PATH), exist_ok=True)
                        conn = sqlite3.connect(SIGNALS_DB_PATH)
                        cursor = conn.cursor()
                        cursor.execute("""
                            CREATE TABLE IF NOT EXISTS bets (
                                marketId TEXT,
                                selectionId INTEGER,
                                strategy_name TEXT,
                                bot_name TEXT,
                                stake REAL,
                                status TEXT,
                                time_session INTEGER
                            )""")
                        import uuid
                        for runner in m.get("runners", []):
                            customer_order_ref = uuid.uuid4().hex[:32]
                            cursor.execute("""
                                INSERT OR IGNORE INTO bets (marketId, selectionId, status, customerOrderRef)
                                VALUES (?, ?, ?, ?)""",
                                (m["marketId"], runner["selectionId"], "pending")
                            )
                        conn.commit()
                        conn.close()
                        logging.info(f"🧾 [UpgradeMonitor] Runners for {m['marketName']} logged to DB")
                    except Exception as db_e:
                        logging.error(f"❌ [UpgradeMonitor] Failed to write runners to DB: {db_e}")
                    markets.append(m)
            except Exception as e:
                print(f"⚠️ Skipped market due to bad startTime: {m.get('marketName', 'unknown')} | Error: {e}")

        print(f"🎯 Filter complete: {len(markets)} markets ready")

        logging.info(f"🧮 Total signals in queue after creation: {signal_queue.qsize()}")

    except Exception as e:
        print(f"🛑 Unhandled exception during upgrade_monitor: {e}")
        traceback.print_exc()

    print("🔄 [Upgrade] Run Monitor Cycle Complete")
    time.sleep(60)

def queue_monitor():
    import sqlite3
    db_path = SIGNALS_DB_PATH
    logging.info("🧪 [QueueMonitor] Thread active. Waiting for signals...")
    logging.info(f"📌 [DEBUG] signal_queue memory ID (queue_monitor): {id(signal_queue)}")

    while True:
        # 🧪 [QueueMonitor] Fetch unevaluated pending runners from bets.db
        try:
            conn = sqlite3.connect(db_path)
            cursor = conn.cursor()
            cursor.execute("""
                SELECT marketId, selectionId FROM bets
                WHERE status = 'pending'
                AND (strategy_name IS NULL OR strategy_name = '')
                AND (stake IS NULL OR stake = 0)
                AND (bot_name IS NULL OR bot_name = '')
            """)
            rows = cursor.fetchall()
            conn.close()

            for market_id, selection_id in rows:
                signal = {
                    "marketId": market_id,
                    "selectionId": selection_id,
                    "timestamp": datetime.utcnow().isoformat(),
                    "status": "pending"
                }
                signal_queue.put(signal)
                logging.info(f"🧪 [QueueMonitor] Injected unevaluated signal for {selection_id}")
        except Exception as e:
            logging.error(f"❌ [QueueMonitor] Failed to inject unevaluated signals: {e}")

        # 🧪 [QueueMonitor] Fetch pending test runners from bets.db
        try:
            conn = sqlite3.connect(db_path)
            cursor = conn.cursor()
            cursor.execute("""
                SELECT marketId, selectionId FROM bets
                WHERE status = 'pending'
                AND strategy_name IS NOT NULL
                AND stake IS NOT NULL
                AND bot_name IS NULL
                AND selectionId BETWEEN 12345001 AND 12345016
            """)
            rows = cursor.fetchall()
            conn.close()

            for market_id, selection_id in rows:
                signal = {
                    "marketId": market_id,
                    "selectionId": selection_id,
                    "timestamp": datetime.utcnow().isoformat(),
                    "status": "pending"
                }
                signal_queue.put(signal)
                logging.info(f"🧪 [QueueMonitor] Injected test signal for {selection_id}")
        except Exception as e:
            logging.error(f"❌ [QueueMonitor] Failed to fetch test signals: {e}")
        try:
            signal = signal_queue.get(timeout=5)
            logging.info(f"📥 [QueueMonitor] Signal received from queue: {signal}")

            logging.info(f"🔁 [QueueMonitor] Passing signal to Signal Monitor: {signal}")
            process_signal(signal)
            logging.info(f"🔎 [QueueMonitor] Signal after enrichment: {signal}")
            logging.info("🧠 [QueueMonitor] Evaluating signal...")
            if evaluate_signal(signal):
                logging.info("✅ [QueueMonitor] Signal approved by Risk Manager")
                if signal.get('stake', 0) <= 800.0:
                    logging.info("💰 [QueueMonitor] Budget check passed, routing to bot...")
                    bot = signal.get('bot_name')
                    if not bot:
                        logging.warning("🛡️ [Upgrade Enforcer] No bot assigned — forcing fallback to OGHeadTrader")
                        bot = 'OGHeadTrader'
                    bot_signal_queues[bot].put(signal)
                    logging.info(f"📦 [QueueMonitor] Signal routed to {bot}")
                else:
                    logging.info("🔒 [QueueMonitor] Budget check failed")
            else:
                logging.info("🚫 [QueueMonitor] Risk check failed")

        except Empty:
            continue
        except Exception as e:
            logging.error(f"❌ [QueueMonitor] Error while processing signal: {e}")
            traceback.print_exc()

