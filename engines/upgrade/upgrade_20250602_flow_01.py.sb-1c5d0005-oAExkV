SNAPSHOT_DATA = {}  # ✅ This must be filled with market_id: {"start_time": datetime} entries

# 🕒 CLOCK-ONLY COUNTDOWN LOOP

def get_time_to_off(start_time):
    from datetime import datetime, timezone
    now = datetime.now(timezone.utc)
    return int((start_time - now).total_seconds() / 60)


def run_clock_only():
    import time
    import logging
    from datetime import datetime

    logging.info("🕒 [Live Clock] Starting countdown loop...")
    while True:
        for market_id, snapshot in SNAPSHOT_DATA.items():
            try:
                start_time = snapshot.get("start_time")
                if not start_time:
                    continue
                minutes_to_off = get_time_to_off(start_time)
                logging.info(f"🕒 [Clock] {market_id}: {minutes_to_off} minutes to off")
            except Exception as e:
                logging.error(f"❌ [Clock Error] {market_id}: {e}")
        time.sleep(60)

