def in_session_window(minutes_to_off, target):
    return (target - 2) <= minutes_to_off <= (target + 2)

def run_monitor():
    import sqlite3
    import logging
    from datetime import datetime
    from upgrade.upgrade_20250525 import DB_PATH, get_simulated_now, in_session_window

    logging.info("🧭 Running session window match for all supported time slots")
    now = get_simulated_now()

    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()

        cursor.execute("SELECT DISTINCT marketId FROM bets")
        market_ids = [row[0] for row in cursor.fetchall()]

        for market_id in market_ids:
            cursor.execute("""
                SELECT * FROM bets
                WHERE marketId = ? AND time_signal = 'time_80'
            """, (market_id,))
            rows = cursor.fetchall()
            if not rows:
                continue

            top_runners = sorted(rows, key=lambda x: x[1])[:4]

            for row in top_runners:
                market_start = datetime.fromisoformat(row[35])
                minutes_to_off = (market_start - now).total_seconds() / 60

                for target_time in [60, 40, 20, 10, 5, 0]:
                    if not in_session_window(minutes_to_off, target_time):
                        continue

                    time_label = f"time_{target_time}"

                    cursor.execute("""
                        SELECT 1 FROM bets
                        WHERE marketId = ? AND selectionId = ? AND time_signal = ?
                    """, (row[0], row[1], time_label))
                    if cursor.fetchone():
                        continue

                    customer_order_ref = f"{row[0][-5:]}_{row[1]}_{target_time}"[:32]
                    timestamp = datetime.utcnow().isoformat()

                    try:
                        cursor.execute("""
                            INSERT INTO bets (
                                marketId, selectionId, stake, odds, bet_type, placed_at, status,
                                matched_liability, unmatched_liability, pnl, liability, result,
                                timestamp, matched_timestamp, betfair_bet_id, horse_name,
                                strategy_name, signal_type, bot_name, date, time_signal,
                                can_accept_liability, time_session, race_name, market_name, event_name,
                                anchor_odd, odds_check_1, odds_check_2, odds_check_3, odds_check_4,
                                odds_check_5, odds_check_6, customerOrderRef, bet_settled,
                                marketStartTime, meta_json, test_mode
                            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                        """, (
                            row[0], row[1], None, None, None, None, "awaiting_signal",
                            None, None, None, None, None,
                            timestamp, None, None, row[15],
                            None, None, None, now.strftime('%Y-%m-%d'), time_label,
                            None, None, row[23], row[24], row[25],
                            None, None, None, None, None,
                            None, None, customer_order_ref, None,
                            row[35], None, None
                        ))
                        logging.info(f"➕ Added {time_label} row for {row[15]} in {row[0]}")
                    except Exception as e:
                        logging.error(f"❌ Failed to insert {time_label} row: {e}")

        conn.commit()


