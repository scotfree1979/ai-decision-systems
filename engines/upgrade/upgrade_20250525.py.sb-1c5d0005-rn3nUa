def evaluate_signal(signal):
    try:
        approved = evaluate_budget(signal)  # returns True/False
        if approved:
            signal["place_bet"] = True
        else:
            logging.info(f"❌ Budget check failed for {signal['customerOrderRef']}")
    except Exception as e:
        logging.error(f"❌ Risk manager failed: {e}")
    return signal

