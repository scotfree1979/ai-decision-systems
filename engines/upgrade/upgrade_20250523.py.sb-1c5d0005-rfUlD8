logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    force=True
)

TOTAL_PNL = 0

USE_MARKET_TYPE_FILTER = True
USE_RUNNER_COUNT_FILTER = False

def enforce_signal_progress(signal):
    print(f"🛡️ [Upgrade] Verifying signal progress: {signal}")
    strategy = signal.get("strategy_name", "").lower()
    routed = False

    if "green-up" in strategy:
        bot_signal_queues["OGHeadTrader"].put(signal)
        routed = True
        print(f"📦 [Upgrade] Enforced route to OGHeadTrader")
    elif "pre-off" in strategy:
        bot_signal_queues["OGPreoff"].put(signal)
        routed = True
        print(f"📦 [Upgrade] Enforced route to OGPreoff")
    elif "in-play" in strategy:
        bot_signal_queues["OGInPlay"].put(signal)
        routed = True
        print(f"📦 [Upgrade] Enforced route to OGInPlay")

    if not routed:
        print(f"⚠️ [Upgrade] No route found. Fallback to wrap_run_monitor().")
        wrap_run_monitor(signal)

def launch_protocol():
    with signal_queue.mutex:
        signal_queue.queue.clear()
    for q in bot_signal_queues.values():
        with q.mutex:
            q.queue.clear()
    logging.info("✅ System boot sequence complete.")

def log_system_initialization():
    for msg in [
        "✅ Market Monitor Initialized",
        "✅ Signal Monitor Active",
        "✅ Risk Manager Engaged",
        "✅ Budget Manager Online",
        "✅ Bot Queues Live",
        "✅ Thread Launch Confirmed"]:
        logging.info(msg)

def create_signal(market_id, selection_id, strategy_name, time_session):
    return {
        "marketId": market_id,
        "selectionId": selection_id,
        "strategy_name": strategy_name,
        "time_session": time_session,
        "timestamp": datetime.utcnow().isoformat(),
        "stake": 5.0,
        "confidence": 1.0,
        "status": "pending"
    }

def normalize_market_time(market_start):
    try:
        return datetime.strptime(market_start, "%Y-%m-%dT%H:%M:%S.%fZ")
    except ValueError:
        return datetime.strptime(market_start, "%Y-%m-%dT%H:%M:%SZ")

def bot_listener(bot_name):
    print(f"👂 [{bot_name}] Listener started...")
    q = bot_signal_queues[bot_name]
    while True:
        try:
            signal = q.get(timeout=5)
            print(f"🎯 [{bot_name}] Received signal: {signal}")
            place_basic_lay_bet(signal)
        except Empty:
            continue
        except Exception as e:
            print(f"❌ [{bot_name}] Listener error: {e}")
            traceback.print_exc()

def upgrade_monitor():
    print("🐛 DEBUG: upgrade_monitor() called from upgrade_20250523.py")
    log_system_initialization()
    session_token = os.environ.get("SESSION_TOKEN", "NO_TOKEN")
    print(f"📌 [DEBUG] signal_queue memory ID (upgrade_monitor): {id(signal_queue)}")

    while True:
        try:
            markets = []
            print("🚀 Sending request to Betfair API...")
            response = requests.post(
                "https://api.betfair.com/exchange/betting/json-rpc/v1",
                headers={
                    "X-Application": "CZHojduNWa3kxWIn",
                    "X-Authentication": session_token,
                    "Content-Type": "application/json"
                },
                data=json.dumps([{
                    "jsonrpc": "2.0",
                    "method": "SportsAPING/v1.0/listMarketCatalogue",
                    "params": {
                        "filter": {
                            "eventTypeIds": ["7"],
                            "marketCountries": ["GB", "IE"],
                            **({"marketTypeCodes": ["WIN"]} if USE_MARKET_TYPE_FILTER else {}),
                            "marketStartTime": {
                                "from": datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
                                "to": (datetime.utcnow() + timedelta(days=1)).strftime("%Y-%m-%dT%H:%M:%SZ")
                            }
                        },
                        "marketProjection": ["RUNNER_DESCRIPTION", "MARKET_START_TIME"],
                        "maxResults": "200"
                    },
                    "id": 1
                }])
            )

            raw_markets = response.json()[0].get("result", []) if response.status_code == 200 else []
            print(f"📦 Raw markets fetched: {len(raw_markets)}")

            for m in raw_markets:
                try:
                    start_time_raw = m.get('marketStartTime') or m.get('marketStartTimeUtc')
                    if not start_time_raw:
                        raise KeyError("marketStartTime missing")

                    market_time = normalize_market_time(start_time_raw)
                    seconds_to_off = (market_time - datetime.utcnow()).total_seconds()
                    if seconds_to_off > 4800:
                        if len(m.get('runners', [])) <= 7:
                            print(f"⛔ Skipped (<=7 runners): {m['marketName']}")
                            continue
                        print(f"✅ Market accepted: {m['marketName']} | Off in {int(seconds_to_off / 60)} min")
                        markets.append(m)
                except Exception as e:
                    print(f"⚠️ Skipped market due to bad startTime: {m.get('marketName', 'unknown')} | Error: {e}")

            print(f"🎯 Filter complete: {len(markets)} markets ready")
            for market in markets:
                market_id = market['marketId']
                for runner in market['runners']:
                    selection_id = runner['selectionId']
                    signal = create_signal(
                        market_id=market_id,
                        selection_id=selection_id,
                        strategy_name="Green-Up",
                        time_session=999
                    )
                    signal_queue.put(signal)
                    print(f"📤 Signal created | Market: {market['marketName']} | Runner: {selection_id}")

            print(f"🧮 Total signals in queue after creation: {signal_queue.qsize()}")

        except Exception as e:
            print(f"🛑 Unhandled exception during upgrade_monitor: {e}")
            traceback.print_exc()

        print("🔄 [Upgrade] Run Monitor Cycle Complete")
        time.sleep(60)

def queue_monitor():
    print("🧪 [QueueMonitor] Thread active. Waiting for signals...")
    print(f"📌 [DEBUG] signal_queue memory ID (queue_monitor): {id(signal_queue)}")

    while True:
        try:
            print("🧪 [QueueMonitor] LOOP CONFIRMATION: queue_monitor has started")
            print(f"🧬 signal_queue ID in queue_monitor: {id(signal_queue)}")

            signal = signal_queue.get(timeout=5)
            print(f"📥 [QueueMonitor] Signal received: {signal}")
            process_signal(signal)
            print(f"🧠 [QueueMonitor] Evaluating signal...")
            if evaluate_signal(signal):
                print(f"✅ [QueueMonitor] Signal approved by Risk Manager")
                if budget_manager(signal):
                    print(f"💰 [QueueMonitor] Budget check passed, routing to bot...")
                    bot = signal.get('bot_name', 'OGHeadTrader')
                    bot_signal_queues[bot].put(signal)
                    print(f"📦 [QueueMonitor] Signal routed to {bot}")
                else:
                    print(f"🔒 [QueueMonitor] Budget check failed")
            else:
                print(f"🚫 [QueueMonitor] Risk check failed")

        except Empty:
            continue
        except Exception as e:
            print(f"❌ [QueueMonitor] Error while processing signal: {e}")
            traceback.print_exc()

if __name__ == "__main__":
    launch_protocol()
    threading.Thread(target=queue_monitor, name="queue_monitor", daemon=True).start()
    threading.Thread(target=upgrade_monitor, name="upgrade_monitor", daemon=True).start()
    threading.Thread(target=HeadTraderBot().run, name="bot_threads", daemon=True).start()
    for bot_name in bot_signal_queues.keys():
        threading.Thread(target=bot_listener, args=(bot_name,), daemon=True).start()
    print("✅ All core threads launched successfully.")