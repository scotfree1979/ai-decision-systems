def in_session_window(minutes_to_off, target):
    return (target - 2) <= minutes_to_off <= (target + 2)

def run_monitor():
    logging.info("🧭 Running session window match for all supported time slots")
    now = get_simulated_now().replace(tzinfo=timezone.utc)

    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT DISTINCT marketId, marketStartTime FROM bets")
        market_data = cursor.fetchall()

        for market_id, market_start in market_data:
            try:
                start_time = datetime.fromisoformat(market_start.replace("Z", "+00:00"))
                minutes_to_off = (start_time - now).total_seconds() / 60
            except Exception as e:
                logging.error(f"❌ Time parse failed for {market_id}: {e}")
                continue

            for target_time in [60, 40, 20, 10, 5, 0]:
                if not in_session_window(minutes_to_off, target_time):
                    continue

                time_label = f"time_{target_time}"

                cursor.execute("""
                    SELECT 1 FROM bets
                    WHERE marketId = ? AND time_signal = ?
                """, (market_id, time_label))
                if cursor.fetchone():
                    continue

                cursor.execute("""
                    SELECT * FROM bets
                    WHERE marketId = ? AND time_signal = 'time_80'
                """, (market_id,))
                base_rows = cursor.fetchall()

                for row in base_rows:
                    ref = f"{market_id[-5:]}_{row[1]}_{target_time}"[:32]
                    timestamp = datetime.utcnow().isoformat()

                    fallback_odds = row[27] or row[28] or row[29] or row[30] or row[31] or row[32] or row[26]
                    odds_check_fields = {
                        80: 32, 60: 31, 40: 30, 20: 29, 10: 28, 5: 27, 0: 26
                    }
                    odds_fields = [row[26], row[27], row[28], row[29], row[30], row[31], row[32]]

                    if target_time in odds_check_fields:
                        index = odds_check_fields[target_time] - 26
                        odds_fields[index] = fallback_odds

                    try:
                        cursor.execute("""
                            INSERT INTO bets (
                                marketId, selectionId, stake, odds, bet_type, placed_at, status,
                                matched_liability, unmatched_liability, pnl, liability, result,
                                timestamp, matched_timestamp, betfair_bet_id, horse_name,
                                strategy_name, signal_type, bot_name, date, time_signal,
                                can_accept_liability, time_session, race_name, market_name, event_name,
                                anchor_odd, odds_check_1, odds_check_2, odds_check_3, odds_check_4,
                                odds_check_5, odds_check_6, customerOrderRef, bet_settled,
                                marketStartTime, meta_json, test_mode
                            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                        """, (
                            row[0], row[1], row[2], row[3], row[4], row[5], "awaiting_signal",
                            row[7], row[8], row[9], row[10], row[11],
                            timestamp, row[13], row[14], row[15],
                            row[16], row[17], row[18], now.strftime('%Y-%m-%d'), time_label,
                            row[21], row[22], row[23], row[24], row[25],
                            odds_fields[0], odds_fields[1], odds_fields[2], odds_fields[3], odds_fields[4],
                            odds_fields[5], odds_fields[6], ref, row[34],
                            row[35], row[36], row[37]
                        ))

                        cursor.execute("""
                            UPDATE bets SET
                                odds_check_6 = COALESCE(odds_check_6, ?),
                                odds_check_5 = COALESCE(odds_check_5, ?),
                                odds_check_4 = COALESCE(odds_check_4, ?),
                                odds_check_3 = COALESCE(odds_check_3, ?),
                                odds_check_2 = COALESCE(odds_check_2, ?),
                                odds_check_1 = COALESCE(odds_check_1, ?),
                                anchor_odd = COALESCE(anchor_odd, ?)
                            WHERE marketId = ? AND selectionId = ?
                        """, (
                            odds_fields[6], odds_fields[5], odds_fields[4], odds_fields[3], odds_fields[2], odds_fields[1], odds_fields[0],
                            row[0], row[1]
                        ))

                        logging.info(f"➕ Triggered {time_label} for {row[15]} [{row[0]}] with full odds propagation")
                    except Exception as e:
                        logging.error(f"❌ Failed to insert {time_label} for {row[1]}: {e}")

        conn.commit()

