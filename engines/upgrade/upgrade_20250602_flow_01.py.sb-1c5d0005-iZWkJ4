# ✅ Upgrade 20250602 – Part 2: Run Monitor Clock Rows
# -----------------------------

import time
from datetime import datetime
import json

def run_monitor():
    logging.info("🕒 RunMonitor waiting for data to appear in bets table...")
    CLOCKS = {}
    while True:
        try:
            with sqlite3.connect(DB_PATH) as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    SELECT DISTINCT marketId, marketStartTime, meta_json
                    FROM bets
                    WHERE status = 'pending'
                """)
                rows = cursor.fetchall()

            if not rows:
                time.sleep(30)
                continue

            for market_id, market_start_time, meta_json in rows:
                if market_id in CLOCKS:
                    continue

                try:
                    if market_start_time:
                        target = datetime.strptime(market_start_time, "%Y-%m-%dT%H:%M:%S.%fZ")
                    else:
                        meta = json.loads(meta_json) if meta_json else {}
                        race_time = meta.get("race_start")
                        target = datetime.strptime(race_time, "%Y-%m-%dT%H:%M:%S.%fZ")
                except Exception as e:
                    logging.warning(f"⚠️ Failed to parse start time for {market_id}: {e}")
                    continue

                mins_to_off = int((target - datetime.utcnow()).total_seconds() / 60)
                CLOCKS[market_id] = mins_to_off
                logging.info(f"⏱ {market_id} | Internal clock started at T-{mins_to_off} mins")

            time.sleep(60)

            for market_id in list(CLOCKS.keys()):
                CLOCKS[market_id] -= 1
                now = CLOCKS[market_id]

                if now in [80, 60, 40, 20, 10, 5, 0]:
                    logging.info(f"🚀 Trigger fired at time_{now} for {market_id}")
                    with sqlite3.connect(DB_PATH) as conn:
                        cursor = conn.cursor()
                        cursor.execute("""
                            INSERT INTO bets (marketId, selectionId, horse_name, status, time_session, test_mode)
                            SELECT marketId, selectionId, horse_name, 'pending', ?, test_mode
                            FROM bets
                            WHERE marketId = ? AND time_session IS NULL
                        """, (f"time_{now}", market_id))
                        conn.commit()

                if now == 0:
                    logging.info(f"🔚 Market {market_id} has gone off. Switching to count-up mode.")

                if now < -80:
                    logging.info(f"🏁 Market {market_id} has expired. Cleaning up.")
                    CLOCKS.pop(market_id)

        except Exception as e:
            logging.error(f"❌ Error inside run_monitor loop: {e}")
            time.sleep(60)

