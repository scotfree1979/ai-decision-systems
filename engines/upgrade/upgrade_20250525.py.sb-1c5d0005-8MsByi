# signal_monitor
# -----------------------------
def signal_monitor():
    logging.info("📡 [Thread] signal_monitor launched")
    while True:
        for key, snapshot in SNAPSHOT_DATA.items():
            market_id = snapshot["marketId"]
            selection_id = snapshot["selectionId"]
            runner_name = snapshot["runnerName"]

            if market_id not in CLOCK_DATA:
                continue  # Skip markets already off

            time_remaining = CLOCK_DATA[market_id]
            if time_remaining <= 10:
                logging.info(f"📡 [Signal Monitor] Runner ready: {runner_name} ({selection_id})")
                signal_queue.put(snapshot)
        time.sleep(30)

