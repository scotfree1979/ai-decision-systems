sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

signal_queue = Queue()

race_runners = [8, 10, 15, 9, 18, 12, 14, 10, 11, 13]

TOTAL_PNL = 0

bot_signal_queues = {
    "OGHeadTrader": Queue(),
    "OGPreoff": Queue(),
    "OGInPlay": Queue()
}

def generate_test_markets():
    base_time = datetime.utcnow()
    markets = []
    runner_id = 1000
    for i in range(10):
        race_time = base_time + timedelta(minutes=15 * i)
        market_id = f"1.TEST{i+1}"
        runners = [{"selectionId": runner_id + j} for j in range(race_runners[i % len(race_runners)])]
        market = {
            "marketId": market_id,
            "marketName": f"WIN R{i+1}",
            "marketStatus": "OPEN",
            "marketStartTime": race_time.isoformat(),
            "event": {
                "countryCode": "GB",
                "name": f"Test Race {i+1}",
                "openDate": race_time.isoformat()
            },
            "runners": runners
        }
        runner_id += race_runners[i % len(race_runners)]
        markets.append(market)
    return markets

strategy_combos = [
    ("Ladder Lays", "20min"),
    ("Ladder Lays", "20min"),
    ("Scalping (Lay to Back)", "10min"),
    ("Scalping (Back to Lay)", "10min"),
    ("Scalping (Lay to Back)", "10min"),
    ("Scalping (Back to Lay)", "10min"),
    ("Green-Up", "5min"),
    ("Green-Up", "5min"),
    ("Green-Up", "5min"),
    ("In-Play", "inplay"),
    ("In-Play", "inplay")
]

def process_signal(signal):
    if signal.get("strategy_name") == "Basic Lay" and signal.get("time_session") == "20min":
        signal["strategy_name"] = "Ladder Lays"
    if signal.get("strategy_name") == "Green-Up":
        signal["bot_name"] = "OGHeadTrader"
    return signal

def update_matched_bets(signal):
    signal.update({"matched_timestamp": datetime.utcnow().isoformat()})
    logging.info(f"📥 [{signal['status'].upper()}] {signal['strategy_name']} | {signal['selectionId']} | Odds: {signal['odds']} | Matched: £{signal['matched_liability']:.2f} | Unmatched: £{signal['unmatched_liability']:.2f}")

def bet_worker(signal):
    odds = signal.get("odds", 0)
    stake = signal.get("stake", 0)
    liability = round((odds - 1) * stake, 2)
    if odds > 20 or liability > 40:
        logging.warning(f"❌ Rejected | Market: {signal['marketId']} | Selection: {signal['selectionId']} | Reason: {'Odds > 20' if odds > 20 else 'Liability > 40'}")
        return 0
    matched = choice([True, False, False])
    signal["matched_liability"] = liability if matched else 0
    signal["unmatched_liability"] = 0 if matched else liability
    signal["status"] = "placed" if matched else "retry"
    update_matched_bets(signal)
    return round(stake, 2) if matched else 0

def launch_protocol():
    with signal_queue.mutex:
        signal_queue.queue.clear()
    for q in bot_signal_queues.values():
        with q.mutex:
            q.queue.clear()
    logging.info("✅ System boot sequence complete.")

def run_test_mode():
    global TOTAL_PNL
    logging.info("🧪 TEST MODE — Simulating 10 race markets with full strategy set...")
    test_markets = generate_test_markets()
    for i, market in enumerate([m for m in test_markets if m["marketStatus"] == "OPEN"]):
        logging.info(f"\nRACE {i+1} – {market['event']['name']}")
        race_pnl = 0
        for idx, (strategy, timing) in enumerate(strategy_combos):
            runner = market["runners"][idx % len(market["runners"])]
            selection_id = runner["selectionId"]
            odds = round(2.0 + (idx % 6) * 0.5, 2)
            signal = {
                "marketId": market["marketId"],
                "selectionId": selection_id,
                "odds": odds,
                "stake": 5.0,
                "strategy_name": strategy,
                "bot_name": "OGHeadTrader" if timing != "inplay" else "OGInPlay",
                "session_token": "TEST_TOKEN",
                "time_session": timing,
                "signal_type": f"{timing} signal",
                "original_signal_type": "upgrade_test",
                "timestamp": datetime.utcnow().isoformat(),
                "source": "upgrade_test",
                "detail": f"test sim {timing}",
                "customerOrderRef": f"TEST-{selection_id}-{strategy[:3].upper()}",
                "market_name": market["marketName"],
                "event_name": market["event"]["name"],
                "meta": {"fire": choice([True, False]), "ice": choice([True, False])},
                "horse": f"TestHorse_{selection_id}"
            }
            logging.info(f"🐎 {selection_id} | {strategy:<25} | Odds: {odds} | Stake: £5 | Liab: £{round((odds-1)*5.0, 2):.2f}")
            if (processed := process_signal(signal)):
                race_pnl += bet_worker(processed)
        TOTAL_PNL += race_pnl
        logging.info(f"\n🜩 GREEN-UP | Race {i+1} Complete")
        logging.info(f"💰 Race {i+1} PnL: £{race_pnl:.2f}")
        logging.info(f"🏇 RACE {i+1} STARTED | 🏋 FINISHED")
    logging.info(f"\n====================")
    logging.info(f"🏋 TOTAL TEST PnL across 10 races: £{TOTAL_PNL:.2f}")
    logging.info(f"📊 Average PnL per race: £{(TOTAL_PNL/10):.2f}")
    logging.info("🧪 Test run complete.")

