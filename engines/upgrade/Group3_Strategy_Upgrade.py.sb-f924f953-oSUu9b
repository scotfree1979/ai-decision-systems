###6 STOP LOSS EXECUTION TRIGGER
# Monitors market to activate predefined stop logic

def check_and_execute_stop(selection_id, current_odds):
    from bet_core import place_bet
    info = stop_logic_tracker.get(selection_id)
    if not info or info["executed"]:
        return

    if (info["side"] == "BACK" and current_odds >= info["odds"]) or \
       (info["side"] == "LAY" and current_odds <= info["odds"]):
        print(f"🚨 Stop triggered for {selection_id} @ {current_odds}. Placing {info['side']} @ {info['odds']}")
        session_token = get_session_token()
        place_bet(session_token, signal["marketId"], selection_id, info["stake"], info["odds"], info["side"], info["ref"])
        info["executed"] = True
