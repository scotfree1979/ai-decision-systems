# ✅ Monitor Stop Loss Logic
# -----------------------------
def monitor_stop_loss(signal, market_id, selection_id, stake, direction, tick_size, entry_odds, stop_ref):
    session_token = get_session_token()
    stop_ticks = signal.get("stop_ticks", 4)
    min_profit_ticks = signal.get("breakeven_ticks", 3)
    trailing_ticks = signal.get("trailing_ticks", 3)  # Number of ticks to trail stop after breakeven

    initial_trigger_odds = round(entry_odds + stop_ticks * tick_size, 2) if direction == "lay_to_back" else round(entry_odds - stop_ticks * tick_size, 2)
    breakeven_trigger_odds = entry_odds

    current_stop_odds = initial_trigger_odds
    stop_moved_to_breakeven = False

    side = "BACK" if direction == "lay_to_back" else "LAY"

    try:
        for _ in range(50):
            odds_data = fetch_live_odds(session_token, market_id, selection_id)
            if not odds_data:
                time.sleep(3)
                continue

            current_price = odds_data.get("lay") if side == "LAY" else odds_data.get("back")
            if not current_price:
                time.sleep(3)
                continue

            favorable_move = entry_odds - current_price if direction == "lay_to_back" else current_price - entry_odds
            favorable_ticks = round(favorable_move / tick_size)

            # 🟢 Move to breakeven if price moves enough in favour
            if not stop_moved_to_breakeven and favorable_ticks >= min_profit_ticks:
                current_stop_odds = breakeven_trigger_odds
                stop_moved_to_breakeven = True

            # 🟢 After breakeven, trail by trailing_ticks
            if stop_moved_to_breakeven and favorable_ticks > trailing_ticks:
                if direction == "lay_to_back":
                    new_stop = round(current_price + trailing_ticks * tick_size, 2)
                    if new_stop < current_stop_odds:
                        current_stop_odds = new_stop
                else:
                    new_stop = round(current_price - trailing_ticks * tick_size, 2)
                    if new_stop > current_stop_odds:
                        current_stop_odds = new_stop

            # 🔴 Trigger stop
            if (direction == "lay_to_back" and current_price >= current_stop_odds) or \
               (direction == "back_to_lay" and current_price <= current_stop_odds):

                stop_bet_id = place_bet(session_token, market_id, selection_id, stake, current_stop_odds, side, stop_ref, persistence_type="PERSIST")
                if stop_bet_id:
                    save_bet_to_db(market_id, selection_id, current_stop_odds, stake, side, stop_ref, stop_bet_id)
                return

            time.sleep(3)

    except Exception as e:
        print(f"💥 [STOP] Monitor crashed: {e}")

