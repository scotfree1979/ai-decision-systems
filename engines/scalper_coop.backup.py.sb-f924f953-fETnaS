# 📍 Market Loop Handler – Live Mode Refactored from RANDCARB
# -----------------------------
def market_loop():
    from upgrade_import_patch import get_session_token
    from utils.api_tools import fetch_live_odds
    from volatility_check import get_volatility_meta, get_recent_odds
    from get_markets import get_markets_and_insert
    from config_paths import DB_PATH
    from brain_headtrader import evaluate_signal
    from datetime import datetime, timezone
    import sqlite3, time

    print("🚀 Starting market loop...")

    while True:
        all_markets = get_markets_and_insert()
        now = datetime.now(timezone.utc)
        filtered = [m for m in all_markets if -15 <= (datetime.fromisoformat(m["marketStartTime"].replace("Z", "+00:00")) - now).total_seconds() / 60.0 <= 100 and len(m.get("runners", [])) >= 7]

        segment_totals = {"<20": 0, "20-40": 0, "40-60": 0, "60-80": 0, "80-90": 0, ">90": 0}
        market_segments = {"<20": 0, "20-40": 0, "40-60": 0, "60-80": 0, "80-90": 0, ">90": 0}
        anchor_total = 0
        odds_check_totals = {"oc1": 0, "oc2": 0, "oc3": 0, "oc4": 0, "oc5": 0, "oc6": 0}
        signal_count = 0

        for market in filtered:
            signal = None
            last_odds_map = {}
            market_id = market["marketId"]
            start_time = datetime.fromisoformat(market["marketStartTime"].replace("Z", "+00:00"))
            minutes_to_off = (start_time - now).total_seconds() / 60.0

            # Classify market segment
            if minutes_to_off < 20:
                market_segments["<20"] += 1
            elif 20 <= minutes_to_off < 40:
                market_segments["20-40"] += 1
            elif 40 <= minutes_to_off < 60:
                market_segments["40-60"] += 1
            elif 60 <= minutes_to_off < 80:
                market_segments["60-80"] += 1
            elif 80 <= minutes_to_off <= 90:
                market_segments["80-90"] += 1
            else:
                market_segments[">90"] += 1

            for runner in market.get("runners", []):
                selection_id = runner["selectionId"]
                odds_data = fetch_live_odds(get_session_token(), market_id, selection_id)
                if not odds_data or "lay" not in odds_data:
                    continue

                current_odds = odds_data["lay"]
                odds_list = get_recent_odds(market_id, selection_id)

                if minutes_to_off < 20:
                    with sqlite3.connect(DB_PATH) as conn:
                        cursor = conn.cursor()
                        cursor.execute("SELECT anchor_odd FROM bets WHERE marketId = ? AND selectionId = ? AND anchor_odd IS NOT NULL", (market_id, selection_id))
                        anchor_exists = cursor.fetchone() is not None
                    if not anchor_exists:
                        segment_totals["<20"] += 1
                        continue
                elif 20 <= minutes_to_off < 40:
                    segment_totals["20-40"] += 1
                elif 40 <= minutes_to_off < 60:
                    segment_totals["40-60"] += 1
                elif 60 <= minutes_to_off < 80:
                    segment_totals["60-80"] += 1
                elif 80 <= minutes_to_off <= 90:
                    segment_totals["80-90"] += 1
                else:
                    segment_totals[">90"] += 1

                with sqlite3.connect(DB_PATH) as conn:
                    cursor = conn.cursor()
                    cursor.execute("SELECT anchor_odd FROM bets WHERE marketId = ? AND selectionId = ? AND anchor_odd IS NOT NULL", (market_id, selection_id))
                    exists = cursor.fetchone()
                    if not exists:
                        cursor.execute("UPDATE bets SET anchor_odd = ?, placed_at = ? WHERE marketId = ? AND selectionId = ?", (current_odds, datetime.utcnow().isoformat(), market_id, selection_id))
                        conn.commit()
                        anchor_total += 1

                    oc_field = None
                    field_key = None
                    if 85 <= minutes_to_off <= 95:
                        oc_field, field_key = "odds_check_1", "oc1"
                    elif 65 <= minutes_to_off < 85:
                        oc_field, field_key = "odds_check_2", "oc2"
                    elif 45 <= minutes_to_off < 65:
                        oc_field, field_key = "odds_check_3", "oc3"
                    elif 25 <= minutes_to_off < 45:
                        oc_field, field_key = "odds_check_4", "oc4"
                    elif 10 <= minutes_to_off < 25:
                        oc_field, field_key = "odds_check_5", "oc5"
                    elif 0 <= minutes_to_off < 10:
                        oc_field, field_key = "odds_check_6", "oc6"

                    if oc_field:
                        cursor.execute(f"SELECT {oc_field} FROM bets WHERE marketId = ? AND selectionId = ?", (market_id, selection_id))
                        existing_value = cursor.fetchone()
                        if existing_value and existing_value[0] is None:
                            cursor.execute(f"UPDATE bets SET {oc_field} = ? WHERE marketId = ? AND selectionId = ?", (current_odds, market_id, selection_id))
                            conn.commit()
                            odds_check_totals[field_key] += 1

                if 0 <= minutes_to_off < 20:
                    volatility_meta = get_volatility_meta(market_id, selection_id, odds_list)
                    range_low = volatility_meta.get("range_low")
                    range_high = volatility_meta.get("range_high")

                    if not range_low or not range_high or range_low >= range_high:
                        continue

                    position_ratio = round((current_odds - range_low) / (range_high - range_low), 3)
                    anchor = current_odds

                    with sqlite3.connect(DB_PATH) as conn:
                        cursor = conn.cursor()
                        cursor.execute("SELECT anchor_odd FROM bets WHERE marketId = ? AND selectionId = ?", (market_id, selection_id))
                        row = cursor.fetchone()
                        if row and row[0] is not None:
                            anchor = row[0]

                    drift = round(((current_odds - anchor) / anchor) * 100, 2)
                    signal_candidate = {
                        "selectionId": selection_id,
                        "marketId": market_id,
                        "runnerName": runner["runnerName"],
                        "odds": current_odds,
                        "anchor_odds": anchor,
                        "drift": drift,
                        "volatility_trend": volatility_meta.get("volatility_trend", "choppy"),
                        "quality_score": volatility_meta.get("quality_score", 75),
                        "confidence": 0.85,
                        "spread": 3,
                        "time_signal": "time_10"
                    }

                    signal_result = evaluate_signal(
                        signal_candidate,
                        headers={},
                        horses=market.get("runners"),
                        initial_stakes=None,
                        current_odds={selection_id: current_odds},
                        fire_ice_status=None,
                        bot_queues=None
                    )

                    if isinstance(signal_result, dict):
                        signal_count += 1

        print("📈 Market Segment Breakdown:", market_segments)
        print("📈 Runner Segment Totals:", segment_totals)
        print("📊 Odds Check Summary:")
        print(f"  • ANCHOR updated: {anchor_total}")
        for key, value in odds_check_totals.items():
            print(f"  • {key.upper()} updated: {value}")
        print(f"📊 Signals Generated This Loop: {signal_count}")
        print("🔁 Auto-cycle continuing – monitoring markets for valid signal...")
        time.sleep(10)

