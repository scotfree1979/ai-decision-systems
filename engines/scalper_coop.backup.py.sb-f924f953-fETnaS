            print("📭 No markets found.")
            return

        now = datetime.now(timezone.utc)

        # ✅ FIXED: Only switch to test mode if *all* markets are more than 90 mins away
        future_markets = [
            m for m in all_markets
            if (datetime.fromisoformat(m["marketStartTime"].replace("Z", "+00:00")) - now).total_seconds() / 60.0 > 90
            and len(m.get("runners", [])) >= 7
        ]

