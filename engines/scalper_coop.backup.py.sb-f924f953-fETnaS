                value TEXT
            )
        """)
    return db_path

# -----------------------------
# 🧠 Confidence Score Helper
# -----------------------------
def calculate_confidence_score(selection_id, drift_pct):
    base = 0.75
    boost = min(abs(drift_pct) * 0.005, 0.1)
    return round(base + boost, 3)

