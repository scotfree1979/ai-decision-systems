# ✅ standalone_bot_test.py – Simulates full bot launcher flow with test signals

import logging
import time
from queue import Queue
from og_bot_family_launcher import launch_bot_family
import upgrade_import_patch
from datetime import datetime
from daily_config import SESSION_TOKEN
from upgrade.upgrade_20250602_flow_01 import get_markets
from utils.api_tools import fetch_live_odds

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(message)s')

# ✅ Shared Queues
signal_queue = Queue()
bot_signal_queues = {
    "OGHeadTrader": Queue(),
    "OGPreoff": Queue(),
    "OGInPlay": Queue()
}

# ✅ Patch queues into upgrade import patch for downstream use
upgrade_import_patch.bot_signal_queues = bot_signal_queues

# ✅ Dummy managers to satisfy launcher injection
class DummyRiskManager:
    pass

class DummyBudgetManager:
    pass

# ✅ Fetch real market and runner data
def fetch_real_test_data():
    markets = get_markets()
    if not markets:
        logging.error("❌ No markets found for test.")
        return []
    market = markets[0]
    market_id = market["marketId"]
    market_start = market["marketStartTime"]
    runners = market["runners"][:4]  # Top 4 runners
    enriched = []
    for i, runner in enumerate(runners):
        selection_id = runner["selectionId"]
        name = runner["runnerName"]
        odds = fetch_live_odds(marketId=market_id, selectionId=selection_id, session_token=SESSION_TOKEN)
        if not odds:
            continue
        enriched.append({
            "selectionId": selection_id,
            "runnerName": name,
            "marketId": market_id,
            "marketStartTime": market_start,
            "odds": odds
        })
    return enriched

now = datetime.utcnow().isoformat()
test_data = fetch_real_test_data()

# ✅ Build test signals from real runners
def build_signals(runner_data):
    signals = []
    for i, data in enumerate(runner_data):
        for bot, bet_type, time_signal, ref_tag in [
            ("OGHeadTrader", "LADDER", "time_20", "HTL"),
            ("OGPreoff", "LADDER", "time_20", "POL"),
            ("OGHeadTrader", "SCALP", "time_10", "HTS"),
            ("OGPreoff", "SCALP", "time_10", "POS"),
            ("OGHeadTrader", "GREENUP", "time_5", "HTG"),
            ("OGInPlay", "INPLAY", "time_0", "IPI")
        ]:
            ref = f"{ref_tag}_{data['selectionId']}"
            signals.append({
                "status": "approved",
                "bet_type": bet_type,
                "marketId": data["marketId"],
                "selectionId": data["selectionId"],
                "odds": data["odds"],
                "stake": 10.0,
                "customerOrderRef": ref,
                "marketStartTime": data["marketStartTime"],
                "bot_name": bot,
                "session_token": SESSION_TOKEN,
                "time_signal": time_signal
            })
    return signals

signals_to_test = build_signals(test_data)

# ✅ Queue signals for testing
for signal in signals_to_test:
    bot_queue = bot_signal_queues.get(signal["bot_name"])
    if bot_queue:
        bot_queue.put(signal)
        logging.info(f"📬 Queued signal: {signal['customerOrderRef']} → {signal['bot_name']}")

# ✅ Launch bots
launch_bot_family(
    headers={"X-Authentication": SESSION_TOKEN, "X-Application": "CZHojduNWa3kxWIn"},
    risk_mgr=DummyRiskManager(),
    bot_assignments={},
    bot_budget_limits={},
    toggles={},
    budget_mgr=DummyBudgetManager(),
    bot_signal_queues=bot_signal_queues
)

# ⏱️ Let it run and observe output
logging.info("🧪 [Standalone Test] Bots launched with test signals. Watching for output...")
time.sleep(15)
