#!/usr/bin/env python3
"""
Scalper Sprint DB v1 – code-based sprint database (tickable)

Use this single file to track Sprint 1 (Virtual/Live DB-Driven Scalper) with
checkable tasks, blockers, and acceptance criteria. State persists to JSON.

Quick start:
  python scalper_sprint_db_v1.py list             # see all tasks in order
  python scalper_sprint_db_v1.py next             # show next actionable task
  python scalper_sprint_db_v1.py show T5          # show full details for a task
  python scalper_sprint_db_v1.py check T5         # mark complete (adds timestamp)
  python scalper_sprint_db_v1.py uncheck T5       # revert to TODO
  python scalper_sprint_db_v1.py export-md        # emit a Markdown checklist
  python scalper_sprint_db_v1.py blockers         # view/update current blockers
  python scalper_sprint_db_v1.py intro            # print the sprint intro prompt

Notes:
- IDs (e.g., T0, T1A) are stable and patch-friendly for Control Center.
- This merges the old Sprint template with Scalper Sprint V2.
- Before each task: use `show <ID>` to see the required files you should supply.

Persistence: creates/updates `sprint_state.json` in the same directory.
"""
from __future__ import annotations
import json, sys, time, pathlib
from dataclasses import dataclass, asdict, field
from typing import List, Dict, Optional

STATE_PATH = pathlib.Path(__file__).with_name("sprint_state.json")
NOW = lambda: int(time.time() * 1000)

# ─────────────────────────────────────────────────────────────
# Data model
# ─────────────────────────────────────────────────────────────
@dataclass
class Task:
    id: str
    section: str
    title: str
    desc: str = ""
    status: str = "TODO"  # TODO | DONE
    depends_on: List[str] = field(default_factory=list)
    files_required: List[str] = field(default_factory=list)
    tables_required: List[str] = field(default_factory=list)
    acceptance: List[str] = field(default_factory=list)
    notes: List[str] = field(default_factory=list)
    ts_done_ms: Optional[int] = None

@dataclass
class Sprint:
    name: str
    mode: str  # plan-only / building
    goal: str
    intro_prompt: str
    tasks: List[Task]
    blockers: List[str]
    checklist: List[str]

# ─────────────────────────────────────────────────────────────
# Initial data – merged plan (old template + Scalper Sprint V2)
# ─────────────────────────────────────────────────────────────

def initial_sprint() -> Sprint:
    goal = (
        "Ship a scalping-only tool with Simulation (virtual) and Live modes, "
        "DB-driven decisions (Blueprints/features), minimal GUI (ladder + orders + paired scalp P&L), "
        "deterministic logs, single source of time, and patch-friendly boundaries."
    )
    intro = (
        "\nTo resume this sprint in any tab, paste this and say:\n"
        "  \"Continue Sprint 1 — pick up from where we left off.\"\n"
        "I will detect ▶️ next and ✅ ticks and proceed.\n"
    )

    # Immediate blockers from run logs
    blockers = [
        "watchdog missing (ModuleNotFoundError in reload_watcher.py)",
        "Blueprints file missing/stale at boot (auto-run required)",
        "sqlite 'unable to open database file' (path/permissions/init)",
        "detect_inplay_blueprints undefined (gate or import)",
        "Interactive Betfair token prompts (provide env/secret fallback)",
    ]

    # Helper for concise creation
    def T(id, section, title, desc="", **kw):
        return Task(id=id, section=section, title=title, desc=desc, **kw)

    tasks: List[Task] = []

    # Baseline alignment (from V2)
    tasks += [
        T("T0", "Baseline", "Verify plan reflects completed work", desc=(
          "Cross-check against commits/chat; restore any missing A-task details."),
          files_required=[], acceptance=["Plan matches repo + chat"], depends_on=[]),
    ]

    # Phase A – Fix blockers first
    tasks += [
        T("T1A", "Blockers", "Environment: install watchdog or gate it",
          desc="Add watchdog to requirements; allow running without watcher.",
          files_required=["engines/reload_watcher.py", "requirements.txt"],
          acceptance=["run_tool.py starts without import error"],
          depends_on=["T0"]),
        T("T1B", "Blockers", "Blueprints auto-run & staleness test",
          desc="If today's blueprint JSON missing/stale → run and version-stamp.",
          files_required=["engines/scalper_module.py", "blueprints/*"],
          acceptance=["Fresh blueprint_signals_YYYY-MM-DD.json on start"],
          depends_on=["T0"]),
        T("T1C", "Blockers", "DB path/access readiness (sqlite)",
          desc="Resolve 'unable to open database file'; print absolute path; open test; busy_timeout; readiness gates.",
          files_required=["*db*.py", "engines/run_tool.py", "config/settings.*"],
          tables_required=["markets", "runners", "books", "blueprints", "oc1_band"],
          acceptance=["No DB-open spam; single consolidated error or clean run"],
          depends_on=["T0"]),
        T("T1D", "Blockers", "In-play blueprint extension gate",
          desc="Import or feature-flag detect_inplay_blueprints; no runtime NameError.",
          files_required=["blueprints/*.py", "engines/scalper_module.py"],
          acceptance=["No NameError during blueprint export"],
          depends_on=["T1B"]),
        T("T1E", "Blockers", "Non-interactive Betfair token",
          desc="Read token from env or ~/.betfair_token; never block Simulation.",
          files_required=["engines/scalper_module.py", "engines/run_tool.py"],
          acceptance=["Simulation starts without prompt; Live uses token if present"],
          depends_on=["T0"]),
    ]

    # Phase B – Simulation mode online (no GUI yet)
    tasks += [
        T("T2A", "Simulation", "Route decisions to Virtual OMS",
          desc="Simulation uses paper fills only; no broker payloads.",
          files_required=["oms/*.py", "engine.py", "decision.py"],
          acceptance=["ORDER/FILL/POSITION/PNL events emitted"], depends_on=["T1A","T1B","T1C","T1E"]),
        T("T2B", "Simulation", "Deterministic replay harness",
          desc="Record 2-min sim; replay for identical outputs.",
          files_required=["replay/*.py", "log_schema.json"],
          acceptance=["Byte-for-byte DECISION/ORDER/FILL match"], depends_on=["T2A"]),
    ]

    # Phase C – Scalping GUI (minimal panels)
    tasks += [
        T("T3A", "GUI", "Ladder view (N levels) + your orders (age)",
          files_required=["gui/ladder_view.*", "gui/telemetry_bus.*"],
          acceptance=["Best back/lay + depth + your orders visible"], depends_on=["T2A"]),
        T("T3B", "GUI", "Positions & PnL (paired scalp profit + residuals)",
          files_required=["gui/pnl_panel.*", "pnl.py"],
          acceptance=["Paired profit updates as fills occur"], depends_on=["T2A"]),
        T("T3C", "GUI", "Signals panel (top-N + reason)",
          files_required=["gui/signals_panel.*", "features.py"],
          acceptance=["Edge/confidence/TTL shown for top-N"], depends_on=["T2A"]),
        T("T3D", "GUI", "Risk panel + controls (Start/Stop, Mode toggle, Conservative, Run Blueprints, Patch A1/A2)",
          files_required=["gui/controls.*", "gui/patch_panel.*"],
          acceptance=["Mode flips logged; A1/A2 flow callable"], depends_on=["T2A","T1B"]),
    ]

    # Phase D – Live mode toggle
    tasks += [
        T("T4A", "Live", "Mode router: Simulation ↔ Live (and optional Shadow)",
          files_required=["oms/router.py", "broker_adapter.py", "permissions.yaml"],
          acceptance=["Simulation never calls broker; Live sends payloads; flips audited"], depends_on=["T3D"]),
        T("T4B", "Live", "Kill switch + circuit breakers",
          files_required=["risk_policy.md", "oms/*.py"],
          acceptance=["Active orders cancelled; new intents blocked until re-armed"], depends_on=["T4A"]),
    ]

    # Acceptance & demo (DoD)
    checklist = [
        "Data gates green; OC1 band queryable",
        "Blueprints current or auto-generated; version stamped",
        "DB-driven decisions; fallback behavior documented",
        "GUI shows horse, odds, our lay/back, paired profit, residuals",
        "Record-and-replay exact match (Simulation)",
        "Latency within single-digit ms per stage (in-process)",
        "Patch A1/A2 callable from GUI; validation + rollback visible",
        "All new boundaries wrapped with full-function triple-headers",
    ]

    return Sprint(
        name="Sprint 1 – Virtual/Live DB-Driven Scalper",
        mode="plan-only",
        goal=goal,
        intro_prompt=intro,
        tasks=tasks,
        blockers=blockers,
        checklist=checklist,
    )

# ─────────────────────────────────────────────────────────────
# Persistence helpers
# ─────────────────────────────────────────────────────────────

def load_state() -> Sprint:
    if STATE_PATH.exists():
        data = json.loads(STATE_PATH.read_text())
        tasks = [Task(**t) for t in data["tasks"]]
        return Sprint(
            name=data["name"], mode=data["mode"], goal=data["goal"],
            intro_prompt=data["intro_prompt"], tasks=tasks,
            blockers=data.get("blockers", []), checklist=data.get("checklist", [])
        )
    s = initial_sprint()
    save_state(s)
    return s

def save_state(s: Sprint):
    data = asdict(s)
    data["tasks"] = [asdict(t) for t in s.tasks]
    STATE_PATH.write_text(json.dumps(data, indent=2))

# ─────────────────────────────────────────────────────────────
# CLI
# ─────────────────────────────────────────────────────────────

def cmd_list(s: Sprint, args: List[str]):
    section = None
    status = None
    if args:
        for a in args:
            if a.startswith("--section="): section = a.split("=",1)[1]
            if a.startswith("--status="):  status  = a.split("=",1)[1].upper()
    for t in s.tasks:
        if section and t.section != section: continue
        if status and t.status != status: continue
        mark = "✅" if t.status=="DONE" else "▶️"
        print(f"{mark} {t.id} [{t.section}] {t.title}")


def find_task(s: Sprint, tid: str) -> Task:
    for t in s.tasks:
        if t.id.upper() == tid.upper():
            return t
    sys.exit(f"Task not found: {tid}")


def cmd_show(s: Sprint, args: List[str]):
    if not args: sys.exit("Usage: show <TASK_ID>")
    t = find_task(s, args[0])
    print(f"\n{t.id} [{t.section}] {t.title}\n{'-'*60}")
    if t.desc: print(t.desc)
    print(f"\nStatus: {t.status}")
    if t.depends_on: print("Depends on:", ", ".join(t.depends_on))
    if t.files_required: print("Files required:", ", ".join(t.files_required))
    if t.tables_required: print("Tables required:", ", ".join(t.tables_required))
    if t.acceptance:
        print("Acceptance:")
        for a in t.acceptance: print("  -", a)
    if t.notes:
        print("Notes:")
        for n in t.notes: print("  -", n)


def cmd_check(s: Sprint, args: List[str], done=True):
    if not args: sys.exit("Usage: check|uncheck <TASK_ID> [note...]")
    t = find_task(s, args[0])
    if done:
        t.status = "DONE"; t.ts_done_ms = NOW()
        if len(args) > 1: t.notes.append(" ".join(args[1:]))
    else:
        t.status = "TODO"; t.ts_done_ms = None
    save_state(s)
    print(f"{t.id} -> {t.status}")


def cmd_next(s: Sprint, args: List[str]):
    # first TODO whose deps are all DONE
    for t in s.tasks:
        if t.status == "DONE":
            continue
        if all(find_task(s, d).status == "DONE" for d in t.depends_on):
            print(f"Next: {t.id} [{t.section}] {t.title}")
            if t.files_required:
                print("Files to provide:", ", ".join(t.files_required))
            return
    print("No next task found — either everything is done or dependencies remain TODO.")


def cmd_export_md(s: Sprint, args: List[str]):
    print(f"# {s.name}\n\n**Goal:** {s.goal}\n")
    current_section = None
    for t in s.tasks:
        if t.section != current_section:
            current_section = t.section
            print(f"\n## {current_section}")
        box = "[x]" if t.status=="DONE" else "[ ]"
        print(f"- {box} {t.id} — {t.title}")


def cmd_blockers(s: Sprint, args: List[str]):
    if not args:
        print("Current blockers:")
        for i,b in enumerate(s.blockers,1):
            print(f" {i}. {b}")
        print("\nAdd with: blockers add <text>  |  remove with: blockers rm <index>")
        return
    if args[0] == "add":
        text = " ".join(args[1:]).strip()
        if not text: sys.exit("Provide blocker text")
        s.blockers.append(text); save_state(s); print("Added.")
    elif args[0] in ("rm","remove"):
        idx = int(args[1]) - 1
        if 0 <= idx < len(s.blockers):
            s.blockers.pop(idx); save_state(s); print("Removed.")
        else:
            sys.exit("Invalid index")
    else:
        sys.exit("blockers [add|rm] ...")


def cmd_intro(s: Sprint, args: List[str]):
    print(s.intro_prompt)


CMDS = {
    "list": cmd_list,
    "show": cmd_show,
    "check": lambda s,a: cmd_check(s,a,True),
    "uncheck": lambda s,a: cmd_check(s,a,False),
    "next": cmd_next,
    "export-md": cmd_export_md,
    "blockers": cmd_blockers,
    "intro": cmd_intro,
}


def main(argv: List[str]):
    s = load_state()
    if len(argv) < 2:
        print(__doc__)
        return
    cmd = argv[1]
    handler = CMDS.get(cmd)
    if not handler:
        sys.exit(f"Unknown command: {cmd}\nAvailable: {', '.join(CMDS)}")
    handler(s, argv[2:])

if __name__ == "__main__":
    main(sys.argv)
