# Place a persistent lay bet (Pre-off logic)
def place_pre_off_lay_bet(runner, odds, stake, market_id):
    lay_payload = {
        "marketId": market_id,
        "instructions": [{
            "selectionId": runner,
            "side": "LAY",
            "orderType": "LIMIT",
            "limitOrder": {"size": stake, "price": odds, "persistenceType": "PERSIST"}
        }]
    }

    lay_response = requests.post(BETFAIR_ENDPOINT + "placeOrders/", headers=headers, json=lay_payload).json()
    print("🔍 Betfair Response:", lay_response)
    if lay_response.get('status') == 'SUCCESS':
        report = lay_response['instructionReports'][0]
        print(f"✅ Pre-off Lay Bet Placed: Runner {runner}, Odds {odds}, Stake {stake}, Status: {report.get('status')}, Bet ID: {report.get('betId')}")
    else:
        print(f"🚫 Failed Pre-off Lay Bet: Runner {runner}, Error: {lay_response.get('errorCode')}")

# Enhanced continuous odds monitoring and placement (Fill-and-Fill logic with market check)
def place_in_play_lay_bet(runner_id, odds, stake, market_id, headers, max_attempts=1):
    lay_payload = {
        "marketId": market_id,
        "instructions": [{
            "selectionId": runner_id,
            "side": "LAY",
            "orderType": "LIMIT",
            "limitOrder": {
                "size": stake,
                "price": odds,
                "persistenceType": "FILL_OR_KILL"
            }
        }],
        "customerRef": f"{market_id}_{runner_id}_{datetime.utcnow().timestamp()}"  # Unique ID
    }

    response = requests.post(BETFAIR_ENDPOINT + "placeOrders/", headers=headers, json=lay_payload).json()

    if response.get('status') == 'SUCCESS':
        report = response['instructionReports'][0]
        if report.get('status') == 'SUCCESS':
            log_event("BET_MATCHED", f"Runner matched successfully", market_id, runner_id, odds)
            return True
        else:
            error_detail = report.get('errorCode', 'No detail')
            log_event("UNMATCHED", f"Bet unmatched: {error_detail}", market_id, runner_id, odds)
            return False
    else:
        faultcode = response.get('faultcode', 'Unknown')
        detail = response.get('detail', {})
        log_event("ERROR", f"Bet Error: {faultcode} | Detail: {detail}", market_id, runner_id, odds)
        return False





