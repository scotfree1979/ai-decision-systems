logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

def log_event(event_type, message, market_id=None, runner_id=None, odds=None):
    event_message = f"[{event_type}]"
    if market_id:
        event_message += f" Market: {market_id}"
    if runner_id:
        event_message += f" | Runner: {runner_id}"
    if odds:
        event_message += f" | Odds: {odds}"
    event_message += f" | {message}"
    logging.info(event_message)

