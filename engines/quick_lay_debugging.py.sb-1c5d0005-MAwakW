# Check signals based on drift criteria and Betfair fire/ice signals
def check_signals(market):
    signals = []
    for runner in market.runners:
        metadata = runner.metadata or {}
        runner_name = runner.runner_name or ""

        if 'FIRE' in metadata.values() or 'ICE' in metadata.values():
            drift_signal = 'FIRE' if 'FIRE' in metadata.values() else 'ICE'
            signals.append({
                'marketId': market.market_id,
                'selectionId': runner.selection_id,
                'runnerName': runner_name,
                'signalType': drift_signal,
                'timeDetected': datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
                'strength': 1
            })
    return signals

