def keep_alive(headers):
    if TOGGLES["keep_alive"]:
        response = requests.post("https://identitysso.betfair.com/api/keepAlive", headers=headers)
        status = "success" if response.status_code == 200 else "fail"
        log_session_management(f"session_alive_{status}", error_message=response.text)


def fetch_budget(headers):
    url = "https://api.betfair.com/exchange/account/json-rpc/v1"
    payload = {
        "jsonrpc": "2.0",
        "method": "AccountAPING/v1.0/getAccountFunds",
        "params": {},
        "id": 1
    }
    response = requests.post(url, headers=headers, json=payload)
    response.raise_for_status()
    account_data = response.json().get('result', {})
    return account_data.get('availableToBetBalance', 0.0)



def fetch_settled_bets(headers):
    url = "https://api.betfair.com/exchange/betting/rest/v1.0/listClearedOrders/"
    params = {"betStatus": "SETTLED"}
    response = requests.post(url, headers=headers, json=params)
    if response.status_code == 200:
        cleared_orders = response.json().get('clearedOrders', [])
        for order in cleared_orders:
            log_bet_and_db_operations("bet_settled", details={
                'market_id': order.get('marketId'),
                'selection_id': order.get('selectionId'),
                'stake': order.get('sizeSettled', 0),
                'odds': order.get('priceMatched', 0),
                'runner': order.get('runnerName', 'Unknown Runner'),
                'pnl': order.get('profit', 0)
            })
    else:
        log_bet_and_db_operations("bet_settle_fetch_failed", details={
            'error_message': response.text
        })


def fetch_and_store_markets(headers):
    today = datetime.utcnow().strftime('%Y-%m-%dT00:00:00Z')
    tomorrow = (datetime.utcnow() + timedelta(days=1)).strftime('%Y-%m-%dT00:00:00Z')

    params = {
        "filter": {
            "eventTypeIds": ["7"],  # Horse Racing
            "marketStartTime": {"from": today, "to": tomorrow},
            "marketTypeCodes": ["WIN"]
        },
        "maxResults": 1000,
        "marketProjection": ["RUNNER_DESCRIPTION", "EVENT"]
    }

    response = requests.post(
        "https://api.betfair.com/exchange/betting/json-rpc/v1",
        headers=headers,
        json={"jsonrpc": "2.0", "method": "SportsAPING/v1.0/listMarketCatalogue", "params": params, "id": 1}
    )

    response.raise_for_status()
    markets = response.json().get('result', [])

    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()

    for market in markets:
        if len(market['runners']) >= 8:
            for runner in market['runners']:
                cursor.execute(
                    """
                    INSERT OR IGNORE INTO bets (marketId, selectionId, horse_name, marketStartTime, timestamp)
                    VALUES (?, ?, ?, ?, ?)
                    """,
                    (
                        market['marketId'],
                        runner['selectionId'],
                        runner['runnerName'],
                        market['marketStartTime'],
                        datetime.utcnow().isoformat()
                    )
                )

    conn.commit()
    conn.close()
    logging.info("✅ Today's markets and runners stored successfully.")


def get_all_upcoming_races():
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("SELECT DISTINCT marketId, marketStartTime FROM bets WHERE DATE(marketStartTime) = DATE('now')")
    races = cursor.fetchall()
    conn.close()

    return [
        {
            'marketId': marketId,
            'raceStartTime': datetime.strptime(marketStartTime, '%Y-%m-%dT%H:%M:%S.%fZ')
        } for marketId, marketStartTime in races
    ]


def evaluate_signal(signal, risk_mgr, budget_mgr):
    logging.info(f"🔍 Evaluating signal explicitly: {signal}")

    odds = signal.get('odds', 0)
    stake = signal.get('stake', 0)
    bot_name = signal.get('bot_name')

    if not risk_mgr.is_odds_within_limits(signal['signal_type'], odds):
        logging.warning(f"❌ Odds outside risk limits: {odds}")
        return []

    available_budget = budget_mgr.get_available_budget(bot_name)
    required_liability = (odds - 1) * stake

    if available_budget < required_liability:
        logging.warning(f"❌ Budget insufficient. Needed: {required_liability}, Available: {available_budget}")
        return []

    approved_signal = {
        **signal,
        "approved_timestamp": datetime.utcnow().isoformat()
    }

    logging.info(f"✅ Signal approved: {approved_signal}")
    return [approved_signal]


def run_monitor(headers, risk_mgr, bot_queues):
    TIME_WINDOWS = [80, 20, 10, 5, 0]
    sent_signals = set()

    while True:
        current_time = datetime.utcnow()

        if not fetch_market_data(headers):
            fetch_and_store_markets(headers)

        upcoming_races = get_all_upcoming_races()
        next_race_time = min(race['raceStartTime'] for race in upcoming_races) if upcoming_races else None
        minutes_to_next_race = int((next_race_time - current_time).total_seconds() / 60) if next_race_time else None

        for race in upcoming_races:
            market_id = race['marketId']
            race_start_time = race['raceStartTime']
            minutes_to_race = int((race_start_time - current_time).total_seconds() / 60)

            if minutes_to_race in TIME_WINDOWS:
                signal_identifier = (market_id, minutes_to_race)
                if signal_identifier not in sent_signals:
                    signal = {
                        "signal_type": f"time_{minutes_to_race}_min",
                        "time_session": minutes_to_race,
                        "marketId": market_id,
                        "timestamp": current_time.isoformat()
                    }

                    processed_signals = evaluate_signal(signal, risk_mgr, budget_mgr)

                    for proc_signal in processed_signals:
                        bot_name = proc_signal['bot_name']
                        if bot_name in bot_queues:
                            bot_queues[bot_name].put(proc_signal)
                            logging.info(f"✅ Time-based signal queued for {bot_name}: {proc_signal}")

                    sent_signals.add(signal_identifier)
                    logging.info(f"✅ Sent time_{minutes_to_race}_min signal for market {market_id}")

        sleep_duration = 30

        logging.info(f"🕒 Sleeping for {sleep_duration} seconds.")
        time.sleep(sleep_duration)


