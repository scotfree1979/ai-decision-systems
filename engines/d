import sqlite3
from datetime import datetime, timedelta

def get_markets_starting_in(minutes):
    logging.info(f"🔍 Fetching markets starting in next {minutes} minutes.")

    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()

    now = datetime.utcnow()
    target_time = now + timedelta(minutes=minutes)

    cursor.execute("""
        SELECT DISTINCT marketId, marketStartTime FROM bets
        WHERE datetime(marketStartTime) BETWEEN ? AND ?
    """, (now.isoformat(), target_time.isoformat()))

    markets_data = cursor.fetchall()

    markets = []
    for marketId, marketStartTime in markets_data:
        cursor.execute("""
            SELECT DISTINCT selectionId FROM bets WHERE marketId = ?
        """, (marketId,))
        selections = cursor.fetchall()
        selection_ids = [s[0] for s in selections]

        markets.append({
            'marketId': marketId,
            'marketStartTime': marketStartTime,
            'selectionIds': selection_ids
        })

    conn.close()

    logging.info(f"✅ Found {len(markets)} markets starting within {minutes} minutes.")
    return markets



def fetch_anchor_odds(market_id, headers):
    params = {"marketIds": [market_id], "priceProjection": {"priceData": ["EX_BEST_OFFERS"]}}

    response = requests.post(
        "https://api.betfair.com/exchange/betting/json-rpc/v1",
        headers=headers,
        json={"jsonrpc": "2.0", "method": "SportsAPING/v1.0/listMarketBook", "params": params, "id": 1}
    )

    response.raise_for_status()
    market_books = response.json().get('result', [])

    if market_books:
        runners_odds = {}
        for runner in market_books[0]['runners']:
            best_offer = runner['ex']['availableToBack'][0]['price'] if runner['ex']['availableToBack'] else None
            if best_offer:
                runners_odds[runner['selectionId']] = best_offer
        return runners_odds

    return {}

def fetch_live_odds(market_id, headers):
    # Assuming fetch_live_odds functionality matches fetch_anchor_odds for live market data
    return fetch_anchor_odds(market_id, headers)



