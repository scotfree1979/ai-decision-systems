def patch_queue_monitor():
    logging.info("🧪 [Patch QueueMonitor] Thread active...")
    logging.info(f"📌 [Patch] signal_queue memory ID: {id(signal_queue)}")

    while True:
        try:
            signal = signal_queue.get(timeout=5)
            logging.info(f"📥 [Patch] Signal received: {signal}")
            process_signal(signal)
        except Empty:
            continue
        except Exception as e:
            logging.error(f"❌ [Patch QueueMonitor] Error: {e}")
            traceback.print_exc()


# ✅ Launch upgrade monitor and patched queue
threading.Thread(target=upgrade_monitor, daemon=True).start()
threading.Thread(target=patch_queue_monitor, daemon=True).start()
threading.Thread(target=lambda: logging.info("⏰ Patch idle loop running...") or time.sleep(60), daemon=True).start()
