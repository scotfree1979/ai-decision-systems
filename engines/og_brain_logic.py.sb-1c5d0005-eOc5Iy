# ✅ Shared queue instance
signal_queue = Queue()

head_trader = UpgradeHeadTrader()
globals()['head_trader'] = head_trader


def expose_patch_functions():
    from upgrade.upgrade_20250525 import (
        place_basic_lay_bet,
        place_ladder_lay_bet,
        place_scalp_trade,
        place_greenup_exit,
        get_market_book,
        evaluate_signal,
