def get_tick_size(odds):
    if odds < 2.0:
        return 0.01
    elif odds < 3.0:
        return 0.02
    elif odds < 4.0:
        return 0.05
    elif odds < 6.0:
        return 0.1
    elif odds < 10.0:
        return 0.2
    elif odds < 20.0:
        return 0.5
    elif odds < 30.0:
        return 1.0
    elif odds < 50.0:
        return 2.0
    elif odds < 100.0:
        return 5.0
    else:
        return 10.0

def place_lay_strategy(signal):
    from bet_core import place_bet, check_bet_matched, cancel_bet

    session_token = signal.get("session_token")
    marketId = signal.get("marketId")
    runner_id = signal.get("selectionId")
    odds = signal.get("odds")
    stake = signal.get("stake") or 10.0
    direction = signal.get("scalp_direction", "lay_to_back")

    tick_size = get_tick_size(odds)

    if direction == "back_to_lay":
        entry_side = "BACK"
        exit_side = "LAY"
        hedge_odds = round(odds - 2 * tick_size, 2)
    else:
        entry_side = "LAY"
        exit_side = "BACK"
        hedge_odds = round(odds + 2 * tick_size, 2)

    # Place entry bet
    entry_bet_id = place_bet(session_token, marketId, runner_id, stake, odds, entry_side)
    if not entry_bet_id:
        logging.warning("❌ Entry bet failed. No scalp placed.")
        return

    # Wait for partial or full match
    matched = False
    for _ in range(10):  # check every 3s up to 30s
        time.sleep(3)
        matched = check_bet_matched(session_token, entry_bet_id)
        if matched:
            break

    if not matched:
        cancel_bet(session_token, entry_bet_id)
        logging.warning("⚠️ Entry bet unmatched after timeout. Cancelled.")
        return

    # Place hedge bet after match
    exit_bet_id = place_bet(session_token, marketId, runner_id, stake, hedge_odds, exit_side)
    if not exit_bet_id:
        logging.warning("❌ Hedge bet failed after entry matched.")
    else:
        place_bet_direct(session_token, marketId, runner_id, stake, odds, "LAY")
        tick_size = get_tick_size(odds)
        back_odds = round(odds + (2 * tick_size), 2)
        place_bet_direct(session_token, marketId, runner_id, stake, back_odds, "BACK")


