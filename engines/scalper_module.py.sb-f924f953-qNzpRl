def _file_fresh_enough(path: str) -> bool:
    try:
        if not os.path.exists(path):
            return False
        if os.path.getsize(path) < BLUEPRINT_MIN_BYTES:
            return False
        mtime = datetime.fromtimestamp(os.path.getmtime(path))
        return mtime.date().isoformat() == _today_str()
    except Exception:
        return False
