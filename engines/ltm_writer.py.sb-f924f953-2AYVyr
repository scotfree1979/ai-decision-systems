import sqlite3
from datetime import datetime
from config_paths import DB_PATH

def write_to_ltm_playbook(signal):
    """
    Save a completed signal and its execution result into the long-term memory (ltm_playbooks table).
    """
    try:
        with sqlite3.connect(DB_PATH) as conn:
            cursor = conn.cursor()
            cursor.execute("""
                INSERT INTO ltm_playbooks (
                    playbook_group_id, marketId, selectionId, pattern_key,
                    blueprint_match, scalp_direction, tick_pattern,
                    confidence, scalp_ticks, entry_odds, hedge_odds,
                    entry_side, hedge_side, entry_stake, hedge_stake,
                    entry_bet_id, hedge_bet_id, pnl, result,
                    opened_at, closed_at, customer_order_ref,
                    ladder_matched, ladder_total
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (
                signal.get("playbook_group_id"),
                signal.get("marketId"),
                signal.get("selectionId"),
                signal.get("pattern_key"),
                signal.get("blueprint_match"),
                signal.get("scalp_direction"),
                signal.get("tick_pattern"),
                signal.get("confidence"),
                signal.get("scalp_ticks"),
                signal.get("entry_odds"),
                signal.get("hedge_odds"),
                signal.get("entry_side"),
                signal.get("hedge_side"),
                signal.get("entry_stake"),
                signal.get("hedge_stake"),
                signal.get("entry_bet_id"),
                signal.get("hedge_bet_id"),
                signal.get("pnl"),
                signal.get("result"),
                signal.get("opened_at", datetime.utcnow().isoformat()),
                signal.get("closed_at", datetime.utcnow().isoformat()),
                signal.get("customer_order_ref"),
                signal.get("ladder_matched"),
                signal.get("ladder_total")
            ))
            conn.commit()
            print(f"📘 LTM: Saved long-term playbook record for {signal.get('selectionId')}.")

    except Exception as e:
        print(f"⚠️ Failed to write to LTM playbooks: {e}")

# Phase 6: LTM Match Log Table

# This file defines the schema for a table that records every known blueprint
# and partial signal match attempt — successful or not — for future AI tuning and analysis.

import sqlite3
from config_paths import DB_PATH

def create_ltm_match_log_table():
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS ltm_match_log (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp TEXT,
                marketId TEXT,
                selectionId INTEGER,
                pattern_key TEXT,
                segment_key TEXT,
                tick_pattern TEXT,
                scalp_direction TEXT,
                match_type TEXT, -- exact_match | partial_match | failure
                result TEXT,     -- launched | skipped | error
                oc_band TEXT,
                confidence REAL,
                scalp_ticks INTEGER,
                reason TEXT
            )
        """)
        conn.commit()
        print("✅ LTM Match Log table created.")

if __name__ == "__main__":
    create_ltm_match_log_table()

