def estimate_data_coverage():
    import sqlite3, os
    db_path = os.path.join(os.path.dirname(__file__), "odds_history.db")
    try:
        with sqlite3.connect(db_path) as conn:
            cursor = conn.cursor()
            cursor.execute("""
                SELECT marketId, COUNT(*) as samples
                FROM odds_snapshots
                GROUP BY marketId
            """)
            rows = cursor.fetchall()
