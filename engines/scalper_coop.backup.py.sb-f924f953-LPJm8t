# 📍 Market Loop Handler – Live Mode Refactored from RANDCARB
# -----------------------------
def market_loop():
    from upgrade_import_patch import get_session_token
    from utils.api_tools import fetch_live_odds
    from volatility_check import get_volatility_meta, get_recent_odds
    from get_markets import get_markets_and_insert
    from config_paths import DB_PATH
    from brain_headtrader import evaluate_signal
    from datetime import datetime, timezone
    import sqlite3, time

    print("🚀 Starting market loop...")

    while True:
        all_markets = get_markets_and_insert()
        now = datetime.now(timezone.utc)
        filtered = [m for m in all_markets if -15 <= (datetime.fromisoformat(m["marketStartTime"].replace("Z", "+00:00")) - now).total_seconds() / 60.0 <= 90 and len(m.get("runners", [])) >= 7]

        for market in filtered:
            segments = {"<20": 0, "20-40": 0, "40-60": 0, "60-80": 0, "80-90": 0, ">90": 0}
            odds_check_counts = {"anchor": 0, "oc1": 0, "oc2": 0, "oc3": 0, "oc4": 0, "oc5": 0, "oc6": 0}

            print(f"📍 {market['event']['venue']} – {market['marketName']} @ {market['marketStartTime']}")
            signal = None
            last_odds_map = {}
            runners_checked = 0
            valid_ranges = 0
            invalid_ranges = 0
            entry_signals = 0
            exit_signals = 0
            neutral_signals = 0
            missing_odds_history = 0
            missed_runners = 0

            for runner in market.get("runners", []):
                runners_checked += 1
                selection_id = runner["selectionId"]
                odds_data = fetch_live_odds(get_session_token(), market["marketId"], selection_id)

                start_time = datetime.fromisoformat(market["marketStartTime"].replace("Z", "+00:00"))
                minutes_to_off = (start_time - now).total_seconds() / 60.0

                if minutes_to_off < 20:
                    segments["<20"] += 1
                    missed_runners += 1
                    continue
                elif 20 <= minutes_to_off < 40:
                    segments["20-40"] += 1
                elif 40 <= minutes_to_off < 60:
                    segments["40-60"] += 1
                elif 60 <= minutes_to_off < 80:
                    segments["60-80"] += 1
                elif 80 <= minutes_to_off <= 90:
                    segments["80-90"] += 1
                else:
                    segments[">90"] += 1

                if not odds_data or "lay" not in odds_data:
                    missed_runners += 1
                    continue

                current_odds = odds_data["lay"]
                odds_list = get_recent_odds(market["marketId"], selection_id)
                if not odds_list:
                    missing_odds_history += 1

                try:
                    with sqlite3.connect(DB_PATH) as conn:
                        cursor = conn.cursor()
                        cursor.execute("""
                            SELECT anchor_odd FROM bets
                            WHERE marketId = ? AND selectionId = ? AND anchor_odd IS NOT NULL
                        """, (market["marketId"], selection_id))
                        exists = cursor.fetchone()
                        if not exists:
                            cursor.execute("""
                                UPDATE bets
                                SET anchor_odd = ?, placed_at = ?
                                WHERE marketId = ? AND selectionId = ?
                            """, (current_odds, datetime.utcnow().isoformat(), market["marketId"], selection_id))
                            conn.commit()
                            odds_check_counts["anchor"] += 1

                        oc_field = None
                        field_key = None
                        if 85 <= minutes_to_off <= 95:
                            oc_field, field_key = "odds_check_1", "oc1"
                        elif 65 <= minutes_to_off < 85:
                            oc_field, field_key = "odds_check_2", "oc2"
                        elif 45 <= minutes_to_off < 65:
                            oc_field, field_key = "odds_check_3", "oc3"
                        elif 25 <= minutes_to_off < 45:
                            oc_field, field_key = "odds_check_4", "oc4"
                        elif 10 <= minutes_to_off < 25:
                            oc_field, field_key = "odds_check_5", "oc5"
                        elif 0 <= minutes_to_off < 10:
                            oc_field, field_key = "odds_check_6", "oc6"

                        if oc_field:
                            cursor.execute(f"""
                                UPDATE bets
                                SET {oc_field} = COALESCE({oc_field}, ?)
                                WHERE marketId = ? AND selectionId = ?
                            """, (current_odds, market["marketId"], selection_id))
                            conn.commit()
                            odds_check_counts[field_key] += 1
                except Exception as e:
                    print(f"⚠️ DB error for {selection_id}: {e}")

                volatility_meta = get_volatility_meta(market["marketId"], selection_id, odds_list)
                range_low = volatility_meta.get("range_low")
                range_high = volatility_meta.get("range_high")
                if not range_low or not range_high or range_low >= range_high:
                    invalid_ranges += 1
                    continue
                else:
                    valid_ranges += 1

                position_ratio = round((current_odds - range_low) / (range_high - range_low), 3)
                if position_ratio <= 0.3:
                    entry_signals += 1
                elif position_ratio >= 0.7:
                    exit_signals += 1
                else:
                    neutral_signals += 1

                last_odds = last_odds_map.get(selection_id)
                if last_odds == current_odds:
                    continue
                last_odds_map[selection_id] = current_odds

                anchor = volatility_meta.get("anchor", current_odds)
                drift = round(((current_odds - anchor) / anchor) * 100, 2)
                signal_candidate = {
                    "selectionId": selection_id,
                    "marketId": market["marketId"],
                    "runnerName": runner["runnerName"],
                    "odds": current_odds,
                    "anchor_odds": anchor,
                    "drift": drift,
                    "volatility_trend": volatility_meta.get("volatility_trend", "choppy"),
                    "quality_score": volatility_meta.get("quality_score", 75),
                    "confidence": calculate_confidence_score(selection_id, drift),
                    "spread": 3,
                    "time_signal": "time_10"
                }
                signal_result = evaluate_signal(signal_candidate, headers={}, horses=market.get("runners"), initial_stakes=None, current_odds={selection_id: current_odds}, fire_ice_status=None, bot_queues=None)
                if isinstance(signal_result, dict):
                    signal = signal_result
                    break

            print(f"📊 Market Summary: {market['event']['venue']} – {market['marketName']} @ {market['marketStartTime']}")
            print(f"• Runners Checked: {runners_checked}")
            print(f"• Valid Ranges: {valid_ranges} ✅ | Invalid Ranges: {invalid_ranges} ❌")
            print(f"• Entry Signals: {entry_signals} ✅ | Exit Signals: {exit_signals} ✅ | Neutral: {neutral_signals} 🛁")
            print(f"• Odds History Missing: {missing_odds_history} ⚠️")
            print(f"• Missed (<20 mins or no data): {missed_runners} ⚠️")
            print(f"🔹 Time Segment Summary (This Market):")
            for label, count in segments.items():
                print(f"  • {label} mins: {count} runners")
            print(f"🔹 Odds Check Summary (This Market):")
            for key, value in odds_check_counts.items():
                print(f"  • {key.upper()} updated: {value}")

            if not signal:
                print("📜 No signal change. Monitoring...")
                time.sleep(10)
                continue

            print_signal_analysis(signal)

            import threading
            user_input = None
            def prompt_with_timeout():
                nonlocal user_input
                try:
                    user_input = input("🔀 Your choice: ").strip().lower()
                except Exception as e:
                    print(f"⚠️ Prompt error: {e}")

            thread = threading.Thread(target=prompt_with_timeout)
            thread.start()
            thread.join(timeout=60)

            if user_input is None:
                print("⏳ No response. Signal marked as missed.")
                log_coop_result(signal, "missed")
                continue
            if user_input in ("accept", "y", "yes"):
                result = execute_coop_trade(signal)
                log_coop_result(signal, result)
            elif user_input in ("edit", "e"):
                print("✏️ Edit functionality not yet implemented.")
            elif user_input in ("manual", "m"):
                manual_bet_entry(get_session_token())
            elif user_input in ("quit", "q"):
                print("👋 Co-op session ended.")
                return
            else:
                log_coop_result(signal, "skipped")

        print("🔁 Auto-cycle continuing – monitoring markets for valid signal...")
        time.sleep(10)

