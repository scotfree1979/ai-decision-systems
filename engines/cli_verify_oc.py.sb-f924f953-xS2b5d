from sqlite_utils import Database
from rich import print
import os
import json

db_path = os.path.join("data", "bets.db")
db = Database(db_path)

print("\n[bold green]OC Snapshot Coverage:[/bold green]")

try:
    for band in range(8):
        oc_label = f"OC{band}"
        # Check how many RunnerRAMSnapshot entries have Snapshot JSON with this band
        rows = db.query(f"""
            SELECT Snapshot
            FROM RunnerRAMSnapshot
            WHERE Snapshot LIKE '%"{oc_label}":%'
        """)
        count = len(list(rows))
        status = "[green]✅" if count > 0 else "[red]❌"
        print(f"{oc_label} → {status} ({count} matches in Snapshot)")
except Exception as e:
    print(f"[red]❌ Error accessing snapshot data: {e}[/red]")
