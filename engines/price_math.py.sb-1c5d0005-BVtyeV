# -----------------------------
# ✅ BETFAIR TICK TABLE
# -----------------------------

TICK_SIZES = [
    (1.01, 2.0, 0.01),
    (2.0, 3.0, 0.02),
    (3.0, 4.0, 0.05),
    (4.0, 6.0, 0.1),
    (6.0, 10.0, 0.2),
    (10.0, 20.0, 0.5),
    (20.0, 30.0, 1.0),
    (30.0, 50.0, 2.0),
    (50.0, 100.0, 5.0),
    (100.0, 1000.0, 10.0)
]

# -----------------------------
# ✅ GET TICK SIZE FOR GIVEN ODDS
# -----------------------------

def get_tick_size(odds):
    for lower, upper, tick in TICK_SIZES:
        if lower <= odds < upper:
            return tick
    return 0.01
