import logging
from datetime import datetime

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

# ✅ Session Management Logs
def log_session_management(activity_type, error_message=""):
    timestamp = datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S')
    messages = {
        "session_start": f"🚀 [Session] Starting new session at {timestamp}",
        "session_alive_success": f"✅ [Session] Session keep-alive successful at {timestamp}",
        "session_alive_fail": f"❌ [Session] Session keep-alive failed: {error_message}",
        "session_end": f"🛑 [Session] Ending session at {timestamp}",
        "budget_fetched": f"💰 [Budget Sync] Budget fetched at {timestamp} — £{error_message}"
    }
    logging.info(messages.get(activity_type, f"❓ Unknown session activity: {activity_type}"))

# ✅ Bot Heartbeat Log
def log_heartbeat(active_bots):
    heartbeat_timestamp = datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S')
    logging.info(f"💓 [Heartbeat] All bots alive: {', '.join(active_bots)} at {heartbeat_timestamp}")

# ✅ Market Operations Log
def log_market_operations(activity_type, details="", error_message=""):
    messages = {
        "market_fetch_success": f"📥 [Market Fetch] Success: {details}",
        "market_fetch_fail": f"❌ [Market Fetch] FAILED — {error_message}",
        "market_store_success": f"📦 [Market Store] Success: {details}",
        "market_store_fail": f"❌ [Market Store] FAILED — {error_message}",
    }
    logging.info(messages.get(activity_type, f"❓ Unknown market op: {activity_type}"))

# ✅ Signal Processing Log
def log_signal_processing(activity_type, details=""):
    messages = {
        "signal_generated": f"📡 [Signal] Generated: {details}",
        "signal_processed": f"✅ [Signal] Processed: {details}",
        "signal_dropped": f"⚠️ [Signal] Dropped or rejected: {details}"
