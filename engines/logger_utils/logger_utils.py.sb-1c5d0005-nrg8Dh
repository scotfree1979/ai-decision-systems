# ✅ Risk & Budget Log
def log_risk_management(activity_type, strategy_name, details=""):
    messages = {
        "risk_approval": f"✅ [Risk] APPROVED ({strategy_name}) — {details}",
        "risk_rejection": f"❌ [Risk] REJECTED ({strategy_name}) — {details}",
        "budget_approval": f"💰 [Budget] APPROVED ({strategy_name}) — {details}",
        "budget_rejection": f"❌ [Budget] REJECTED ({strategy_name}) — {details}"
    }
    logging.info(messages.get(activity_type, f"❓ Unknown risk event: {activity_type}"))

# ✅ Bet + DB Ops
def log_bet_and_db_operations(operation_type, bet_id=None, details=None):
    messages = {
        "bet_attempt": f"📥 [Bet Attempt] Market: {details['market_id']}, Runner: {details['selection_id']}, Stake: {details['stake']}, Odds: {details['odds']}",
        "bet_placed": f"✅ [Bet Placed] Bet ID: {bet_id}, Details: {details}",
        "bet_settled": f"🏁 [Bet Settled] Runner: {details['runner']}, PnL: {details['pnl']}",
        "db_record_success": f"💾 [DB] Record saved: {details}",
        "db_record_fail": f"❌ [DB] Record failed: {details}"
    }
    logging.info(messages.get(operation_type, f"❓ Unknown bet/db op: {operation_type}"))

# ✅ Error Logs
def log_error_handling(error_type, error_detail):
    timestamp = datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S')
    logging.error(f"🔴 [Error] {error_type}: {error_detail} @ {timestamp}")
