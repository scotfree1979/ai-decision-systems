# 5_🚨_Critical_Alerts.py
import streamlit as st
import sqlite3
import pandas as pd
from datetime import datetime

DB_PATH = 'data/bets.db'

st.title("🚨 Critical Alerts")

st.subheader("Thread & System Alerts")
try:
    import threading
    active = threading.enumerate()
    st.success(f"Active threads: {len(active)}")
    st.write([t.name for t in active])
except Exception as e:
    st.error(f"Error checking threads: {e}")

st.subheader("Recent Optimizer Errors")
try:
    with sqlite3.connect(DB_PATH) as conn:
        df = pd.read_sql_query("SELECT * FROM optimizer_logs WHERE status='error' ORDER BY timestamp DESC LIMIT 10", conn)
        if df.empty:
            st.info("No optimizer errors found.")
        else:
            st.dataframe(df[['timestamp', 'error_message']], use_container_width=True)
except Exception as e:
    st.error(f"Optimizer log error: {e}")

st.subheader("Watchdog Alerts")
try:
    with open('logs/watchdog_status.log') as log:
        alerts = log.readlines()[-5:]
        for line in alerts:
            st.code(line.strip())
except Exception:
    st.warning("No watchdog logs available.")
