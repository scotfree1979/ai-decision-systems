        conn.executescript("""
            CREATE TABLE IF NOT EXISTS brain_output (
                timestamp TEXT,
                recommendation TEXT,
                reasoning TEXT,
                type TEXT
            );

            CREATE TABLE IF NOT EXISTS strategy_journal (
                timestamp TEXT,
                author TEXT,
                action TEXT,
                description TEXT
            );

            CREATE TABLE IF NOT EXISTS system_flags (
                key TEXT PRIMARY KEY,
                value TEXT
            );
        """)
        conn.commit()

