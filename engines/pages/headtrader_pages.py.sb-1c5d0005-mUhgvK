# 📘 Strategy Journal Timeline
# ----------------------------
def strategy_journal():
    st.title("📘 Strategy Journal")
    try:
        with sqlite3.connect(DB_PATH) as conn:
            df = pd.read_sql_query("""
                SELECT timestamp, author, action, description
                FROM strategy_journal
                ORDER BY timestamp DESC
            """, conn)
        if not df.empty:
        df['timestamp'] = pd.to_datetime(df['timestamp']).dt.strftime('%Y-%m-%d %H:%M:%S')
        st.dataframe(df, use_container_width=True)
    else:
        st.info("📭 No strategy journal entries found.")
    except Exception as e:
        st.warning(f"⚠️ Strategy journal failed to load: {e}")
    df['timestamp'] = pd.to_datetime(df['timestamp']).dt.strftime('%Y-%m-%d %H:%M:%S')
    st.dataframe(df, use_container_width=True)

# ----------------------------
# 🚨 Lockdown Protocol
# ----------------------------
def lockdown_panel():
    st.title("🚨 Lockdown Protocol")
    st.warning("Lockdown disables all strategy execution and approvals. Use only in emergencies.")

    with sqlite3.connect(DB_PATH) as conn:
        lock_status = pd.read_sql_query("SELECT value FROM system_flags WHERE key = 'SYSTEM_LOCKDOWN'", conn)

    current_status = lock_status['value'].iloc[0] if ('value' in lock_status.columns and not lock_status.empty) else 'off'
    st.metric("Current Lockdown Mode", current_status.upper())

    toggle = st.radio("Update Lockdown Mode:", ["on", "off"], index=0 if current_status == 'on' else 1)
    if st.button("Update Lockdown"):
        with sqlite3.connect(DB_PATH) as conn:
            conn.execute("REPLACE INTO system_flags (key, value) VALUES (?, ?)", ("SYSTEM_LOCKDOWN", toggle))
            conn.commit()
        st.success(f"System lockdown updated to: {toggle.upper()}")

# ----------------------------
# 🔥 Exposure Heatmap
# ----------------------------
def exposure_heatmap():
    st.title("🔥 Exposure Heat Zones")
    with sqlite3.connect(DB_PATH) as conn:
        df = pd.read_sql_query("""
            SELECT strategy_name, SUM(liability) as total_liability,
                   SUM(matched_liability) as matched, SUM(unmatched_liability) as unmatched
            FROM bets
            WHERE time_signal IN ('time_40', 'time_20', 'time_10', 'time_5', 'time_0')
            GROUP BY strategy_name
        """, conn)
    df['exposure_ratio'] = (df['matched'] / df['total_liability']).fillna(0).round(2)
    st.bar_chart(df.set_index('strategy_name')[['matched', 'unmatched']])
    st.dataframe(df, use_container_width=True)

# ----------------------------
# 📄 Daily Debrief
# ----------------------------
def daily_debrief():
    st.title("📄 Daily Performance Debrief")
    with sqlite3.connect(DB_PATH) as conn:
        df = pd.read_sql_query("""
            SELECT date, SUM(pnl) as pnl, COUNT(*) as bets,
                   ROUND(AVG(pnl), 2) as avg_return,
                   SUM(CASE WHEN pnl > 0 THEN 1 ELSE 0 END) AS wins,
                   SUM(CASE WHEN pnl < 0 THEN 1 ELSE 0 END) AS losses
            FROM bets
            GROUP BY date
            ORDER BY date DESC
            LIMIT 7
        """, conn)
    df['win_rate'] = round(df['wins'] / df['bets'] * 100, 2)
    df['date'] = pd.to_datetime(df['date']).dt.strftime('%Y-%m-%d')
    st.dataframe(df, use_container_width=True)

