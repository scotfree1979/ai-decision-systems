import streamlit as st
import sqlite3
import pandas as pd

st.title("📈 Market Insights")

DB_PATH = 'data/bets.db'

st.subheader("Forecast vs Actual Outcomes")

@st.cache_data
def fetch_insights():
    with sqlite3.connect(DB_PATH) as conn:
        df = pd.read_sql_query("""
            SELECT strategy_name, confidence, status, settled_at FROM bets 
            WHERE settled_at IS NOT NULL ORDER BY settled_at DESC LIMIT 100
        """, conn)
    return df

df = fetch_insights()
if df.empty:
    st.info("No settled bet data to show insights.")
else:
    match_rate = df[df['status'] == 'won'].groupby('strategy_name').size() / df.groupby('strategy_name').size()
    st.dataframe(match_rate.reset_index(name='win_match_rate'))
