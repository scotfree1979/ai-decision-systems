import streamlit as st
import pandas as pd
import sqlite3

st.title("📡 API Technical Monitoring")

DB_PATH = 'data/bets.db'

@st.cache_data
def fetch_api_logs():
    with sqlite3.connect(DB_PATH) as conn:
        df = pd.read_sql_query("""
            SELECT timestamp, api_name, round_trip_ms, error_code
            FROM api_logs
            ORDER BY timestamp DESC LIMIT 100
        """, conn)
    return df

df = fetch_api_logs()

if df.empty:
    st.warning("No API log data available.")
else:
    st.subheader("API Latency Monitor")
    st.line_chart(df.set_index('timestamp')['round_trip_ms'])

    st.subheader("Recent API Errors")
    error_df = df[df['error_code'].notnull()]
    st.dataframe(error_df[['timestamp', 'api_name', 'error_code']])
