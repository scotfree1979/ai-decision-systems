import streamlit as st
import pandas as pd
import plotly.express as px
import sqlite3

# Page Configuration
st.set_page_config(page_title="Strategy Analytics", layout="wide")
st.title('⚙️ Strategy Analytics')

# Load Historical Strategy Data from Database
def load_strategy_data():
    conn = sqlite3.connect('/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db')
    query = """
    SELECT strategy_name, timestamp, pnl, odds, stake
    FROM bets
    ORDER BY timestamp ASC
    """
    return pd.read_sql(query, conn)

strategy_df = load_strategy_data()
strategy_df['timestamp'] = pd.to_datetime(strategy_df['timestamp'])

# Cumulative Profit/Loss by Strategy
st.subheader("Cumulative Profit/Loss by Strategy")
strategy_df['cumulative_pnl'] = strategy_df.groupby('strategy_name')['pnl'].cumsum()
fig_cum_pnl = px.line(strategy_df, x='timestamp', y='cumulative_pnl', color='strategy_name',
                      title='Cumulative Profit/Loss Over Time by Strategy', markers=True)
st.plotly_chart(fig_cum_pnl, use_container_width=True)

# Total Profit by Strategy
st.subheader("Total Profit by Strategy")
total_profit_df = strategy_df.groupby('strategy_name')['pnl'].sum().reset_index().sort_values(by='pnl', ascending=False)
fig_total_profit = px.bar(total_profit_df, x='strategy_name', y='pnl',
                          title='Total Profit (£) per Strategy', color='pnl',
                          color_continuous_scale='RdYlGn')
st.plotly_chart(fig_total_profit, use_container_width=True)

# Strategy Strike Rate Analysis
st.subheader("Strategy Strike Rate Analysis")
strike_rate_df = strategy_df.groupby('strategy_name').agg(
    total_trades=('pnl', 'count'),
    winning_trades=('pnl', lambda x: (x > 0).sum())
).reset_index()
strike_rate_df['strike_rate (%)'] = (strike_rate_df['winning_trades'] / strike_rate_df['total_trades']) * 100

fig_strike_rate = px.bar(strike_rate_df, x='strategy_name', y='strike_rate (%)',
                         title='Strike Rate (%) per Strategy', color='strike_rate (%)',
                         color_continuous_scale='Blues')
st.plotly_chart(fig_strike_rate, use_container_width=True)

# Recent Strategy Activity
st.subheader("Recent Strategy Activity")
recent_activity_df = strategy_df.tail(20)[['timestamp', 'strategy_name', 'pnl', 'odds', 'stake']]
st.dataframe(recent_activity_df, use_container_width=True)

# Odds vs Stake Analysis by Strategy
st.subheader("Odds vs Stake Analysis")
fig_odds_stake = px.scatter(strategy_df, x='odds', y='stake', color='strategy_name', size='pnl',
                            title='Odds vs Stake by Strategy (size = P/L)',
                            labels={'odds': 'Odds', 'stake': 'Stake (£)'})
st.plotly_chart(fig_odds_stake, use_container_width=True)

# Footer
st.markdown('---')
st.caption('🔄 Dashboard refreshes every 30 seconds. Data sourced from historical database.')
