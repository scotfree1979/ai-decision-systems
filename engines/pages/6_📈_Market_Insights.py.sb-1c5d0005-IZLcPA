import streamlit as st
import pandas as pd
import plotly.express as px
import requests
import json

# Page Configuration
st.set_page_config(page_title="Market Insights", layout="wide")
st.title('📈 Market Insights')

# Headers with session token from session state
headers = {
    "X-Application": "CZHojduNWa3kxWIn",
    "X-Authentication": st.session_state.get('session_token', ''),
    "Content-Type": "application/json"
}

# API Back-door methods
def hijack_call(method, params=None):
    url = "https://api.betfair.com/exchange/betting/json-rpc/v1"
    payload = {"jsonrpc": "2.0", "method": f"SportsAPING/v1.0/{method}", "params": params or {}, "id": 1}
    response = requests.post(url, headers=headers, data=json.dumps(payload))
    response.raise_for_status()
    return response.json().get('result', {})

# Fetch Market Catalogue
def fetch_market_catalogue():
    params = {
        "filter": {"eventTypeIds": ["7"], "marketCountries": ["GB", "IE"]},
        "maxResults": "50",
        "marketProjection": ["RUNNER_METADATA"]
    }
    return hijack_call("listMarketCatalogue", params=params)

# Load Market Catalogue
market_catalogue = fetch_market_catalogue()
market_ids = [market['marketId'] for market in market_catalogue]

# Fetch Live Market Data (corrected API call)
market_book_data = hijack_call("listMarketBook", params={
    "marketIds": market_ids,
    "priceProjection": {"priceData": ["EX_BEST_OFFERS"]}
})

# Display Market Overview
st.subheader("Market Overview")
market_overview_df = pd.DataFrame([{
    'Market ID': market['marketId'],
    'Market Name': market['marketName'],
    'Total Matched': market.get('totalMatched', 'N/A')
} for market in market_catalogue])
st.dataframe(market_overview_df, use_container_width=True)

# Live Odds & Liquidity Visualization
st.subheader("Live Odds & Liquidity")
for market in market_book_data:
    runners_data = []
    for runner in market['runners']:
        if 'ex' in runner and 'availableToBack' in runner['ex']:
            best_offer = runner['ex']['availableToBack'][0]
            runners_data.append({
                'Selection ID': runner['selectionId'],
                'Odds': best_offer['price'],
                'Liquidity (£)': best_offer['size']
            })

    if runners_data:
        runners_df = pd.DataFrame(runners_data)
        fig_odds_liquidity = px.bar(runners_df, x='Selection ID', y='Liquidity (£)',
                                    title=f"Market ID: {market['marketId']} - Odds & Liquidity",
                                    color='Odds', color_continuous_scale='Viridis')
        st.plotly_chart(fig_odds_liquidity, use_container_width=True)

# Odds Movement Heatmap
st.subheader("Odds Movement Heatmap")
odds_heatmap_data = []
for market in market_book_data:
    for runner in market['runners']:
        if 'ex' in runner and 'availableToBack' in runner['ex']:
            best_offer = runner['ex']['availableToBack'][0]
            odds_heatmap_data.append({
                'Market ID': market['marketId'],
                'Selection ID': runner['selectionId'],
                'Odds': best_offer['price']
            })

if odds_heatmap_data:
    odds_heatmap_df = pd.DataFrame(odds_heatmap_data)
    fig_heatmap = px.density_heatmap(odds_heatmap_df, x='Selection ID', y='Odds',
                                     title="Odds Distribution Across Selections",
                                     nbinsx=30, nbinsy=30, color_continuous_scale='RdYlGn')
    st.plotly_chart(fig_heatmap, use_container_width=True)
else:
    st.info("No sufficient odds data available for heatmap.")

# Footer
st.markdown('---')
st.caption('🔄 Dashboard refreshes every 30 seconds. Data sourced from live Betfair API.')