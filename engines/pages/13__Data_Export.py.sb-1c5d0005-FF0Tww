## 📁 Data Export Page

Here's the complete Streamlit code snippet for your Data Export management page:

```python
import streamlit as st
import pandas as pd
from io import BytesIO

# Placeholder Data (replace with actual data for export)
data_for_export = pd.DataFrame({
    "Date": pd.date_range(start="2025-01-01", periods=50),
    "Trades": range(1, 51),
    "Profit/Loss (£)": [round(i * 10.5, 2) for i in range(-25, 25)]
})

# Page Title
st.title("📁 Data Export")

# Display Data
st.subheader("Preview Data")
st.dataframe(data_for_export, use_container_width=True)

# Data Export Function
st.subheader("Export Data")
def convert_df_to_csv(df):
    return df.to_csv(index=False).encode('utf-8')

csv = convert_df_to_csv(data_for_export)

st.download_button(
    label="📥 Download data as CSV",
    data=csv,
    file_name='trades_data.csv',
    mime='text/csv',
)

# Excel Export
def convert_df_to_excel(df):
    output = BytesIO()
    with pd.ExcelWriter(output, engine='xlsxwriter') as writer:
        df.to_excel(writer, index=False, sheet_name='Sheet1')
    processed_data = output.getvalue()
    return processed_data

excel = convert_df_to_excel(data_for_export)

st.download_button(
    label="📥 Download data as Excel",
    data=excel,
    file_name='trades_data.xlsx',
    mime='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
)
```

