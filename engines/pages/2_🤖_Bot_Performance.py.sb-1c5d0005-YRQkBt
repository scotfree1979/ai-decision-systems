# 2_🤖_Bot_Performance.py – Merged Bot Metrics & 30-Day Breakdown
import streamlit as st
import pandas as pd
import sqlite3
import plotly.express as px
import threading
from datetime import datetime

DB_PATH = '/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db'

st.set_page_config(page_title="Bot Performance", layout="wide")
st.title("🤖 Bot Performance")

# Load historical bets
@st.cache_data
def fetch_bot_data():
    with sqlite3.connect(DB_PATH) as conn:
        return pd.read_sql_query("SELECT * FROM bets WHERE placed_at >= date('now', '-30 day')", conn)

df = fetch_bot_data()

# Bot Acceptance + Queue Stats
st.subheader("Bot Acceptance Overview (Last 30 Days)")
def calculate_bot_stats(df):
    if df.empty:
        return pd.DataFrame(columns=['bot_name', 'acceptance_rate', 'queue_processed'])
    grouped = df.groupby('bot_name')
    summary = grouped.size().reset_index(name='total')
    accepted = df[df['status'] == 'placed'].groupby('bot_name').size().reset_index(name='accepted')
    stats = pd.merge(summary, accepted, on='bot_name', how='left').fillna(0)
    stats['acceptance_rate'] = (stats['accepted'] / stats['total']) * 100
    stats['queue_processed'] = stats['total']
    return stats[['bot_name', 'acceptance_rate', 'queue_processed']]

stats_df = calculate_bot_stats(df)
st.dataframe(stats_df, use_container_width=True)

# Profitability Per Bot
st.subheader("📈 Total Profit by Bot")
if 'bot_name' in df and 'pnl' in df:
    pnl_summary = df.groupby('bot_name')['pnl'].sum().reset_index().sort_values(by='pnl', ascending=False)
    fig = px.bar(pnl_summary, x='bot_name', y='pnl', color='pnl', title='Total P/L by Bot')
    st.plotly_chart(fig, use_container_width=True)

# Strike Rates
st.subheader("🎯 Strike Rates by Bot")
if 'bot_name' in df and 'status' in df:
    wins = df[df['status'] == 'won'].groupby('bot_name').size().reset_index(name='wins')
    total = df.groupby('bot_name').size().reset_index(name='total')
    strike = pd.merge(total, wins, on='bot_name', how='left').fillna(0)
    strike['strike_rate'] = (strike['wins'] / strike['total']) * 100
    fig_strike = px.bar(strike, x='bot_name', y='strike_rate', color='strike_rate',
                        title='Strike Rate (%) by Bot', color_continuous_scale='Viridis')
    st.plotly_chart(fig_strike, use_container_width=True)

# Trades Executed
st.subheader("📊 Trades Executed")
trade_counts = df.groupby('bot_name').size().reset_index(name='trades')
fig_trades = px.bar(trade_counts, x='bot_name', y='trades', title='Total Trades by Bot', color='trades')
st.plotly_chart(fig_trades, use_container_width=True)

# Watchdog Threads
st.subheader("🧠 System Thread Status")
th_names = [t.name for t in threading.enumerate()]

core_threads = ['MainThread', 'queue_monitor', 'upgrade_monitor', 'bot_threads']
missing = [name for name in core_threads if name not in th_names]

if missing:
    st.warning(f"⚠️ Missing critical threads: {', '.join(missing)}")
else:
    st.success("✅ All core system threads are running correctly.")

with st.expander("🔍 Show all active threads"):
    st.write(th_names)
