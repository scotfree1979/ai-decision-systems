import sqlite3
import streamlit as st
from datetime import datetime, timedelta
import pandas as pd

DB_PATH = 'data/bets.db'

st.title("📊 Trading Performance")

def fetch_bet_data():
    with sqlite3.connect(DB_PATH) as conn:
        df = pd.read_sql_query("""
            SELECT * FROM bets 
            WHERE placed_at >= date('now', '-1 day')
        """, conn)
    return df

def calculate_metrics(df):
    if df.empty:
        return 0, 0, 0, 0
    total = len(df)
    wins = df[df['status'] == 'won']
    losses = df[df['status'] == 'lost']
    win_rate = len(wins) / total * 100
    roi = (wins['stake'].sum() - losses['stake'].sum()) / df['stake'].sum() * 100
    drawdown = df['stake'].sum() - wins['stake'].sum()
    return total, win_rate, roi, drawdown

def show_optimizer_trends():
    with sqlite3.connect(DB_PATH) as conn:
        df = pd.read_sql_query("SELECT * FROM optimizer_logs ORDER BY timestamp DESC LIMIT 7", conn)
    if df.empty:
        st.warning("No optimizer logs available.")
    else:
        df['timestamp'] = pd.to_datetime(df['timestamp'])
        st.line_chart(df.set_index('timestamp')['win_rate'])

df = fetch_bet_data()
total, win_rate, roi, drawdown = calculate_metrics(df)

st.metric("Total Trades (24h)", total)
st.metric("Win Rate (%)", f"{win_rate:.2f}")
st.metric("ROI (%)", f"{roi:.2f}")
st.metric("Drawdown", f"£{drawdown:.2f}")

st.subheader("7-Day Optimizer Win Rate Trend")
show_optimizer_trends()
