import streamlit as st
import sqlite3
import pandas as pd

st.title("⚙️ Strategy Analytics")

DB_PATH = 'data/bets.db'

@st.cache_data
def load_strategy_data():
    with sqlite3.connect(DB_PATH) as conn:
        df = pd.read_sql_query("""
            SELECT strategy_name, status, stake, confidence, rejection_reason 
            FROM bets WHERE placed_at >= date('now', '-7 day')
        """, conn)
    return df

df = load_strategy_data()

if df.empty:
    st.warning("No strategy data available.")
else:
    st.subheader("Strategy Summary")
    summary = df.groupby('strategy_name').agg({
        'stake': 'sum',
        'confidence': 'mean',
        'status': lambda x: (x == 'rejected').mean() * 100
    }).rename(columns={'confidence': 'avg_confidence', 'status': 'rejection_%'})
    st.dataframe(summary)

    st.subheader("Rejection Reasons")
    rejection_counts = df[df['status'] == 'rejected'].groupby('rejection_reason').size().reset_index(name='count')
    st.dataframe(rejection_counts)
