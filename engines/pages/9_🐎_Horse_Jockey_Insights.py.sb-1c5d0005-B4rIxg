# 14_🧠_HeadTrader_Dashboard.py – Momentum Insights: Horse, Jockey, Trainer
import streamlit as st
import pandas as pd
import sqlite3
from datetime import datetime

DB_PATH = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db"

st.set_page_config(page_title="HeadTrader Dashboard", layout="wide")
st.title("🧠 HeadTrader Momentum Dashboard")

@st.cache_data
def load_bets():
    with sqlite3.connect(DB_PATH) as conn:
        return pd.read_sql_query("""
            SELECT horse_name, bot_name, status, date, marketStartTime,
                   strategy_name, jockey, trainer
            FROM bets
            WHERE date >= date('now', '-60 day')
        """, conn)

df = load_bets()

df['date'] = pd.to_datetime(df['date'])
df['marketStartTime'] = pd.to_datetime(df['marketStartTime'])

today = datetime.utcnow().date()
today_df = df[df['marketStartTime'].dt.date == today]

# 🐎 Horse Momentum Panel
def get_horse_momentum(df):
    wins = df[df['status'] == 'won']
    win_counts = wins.groupby('horse_name').size().reset_index(name='wins')
    momentum = win_counts[win_counts['wins'] >= 1]
    merged = pd.merge(momentum, today_df, on='horse_name')
    return merged[['horse_name', 'bot_name', 'strategy_name', 'marketStartTime', 'wins']].drop_duplicates()

# 🧑‍✈️ Jockey Form Panel
def get_hot_jockeys(df):
    wins = df[df['status'] == 'won']
    jockey_form = wins.groupby('jockey').size().reset_index(name='wins')
    hot_jockeys = jockey_form[jockey_form['wins'] >= 2]
    return pd.merge(hot_jockeys, today_df, on='jockey')[['jockey', 'horse_name', 'trainer', 'marketStartTime']].drop_duplicates()

# 🏠 Trainer Form Panel
def get_hot_trainers(df):
    wins = df[df['status'] == 'won']
    trainer_form = wins.groupby('trainer').size().reset_index(name='wins')
    hot_trainers = trainer_form[trainer_form['wins'] >= 3]
    return pd.merge(hot_trainers, today_df, on='trainer')[['trainer', 'horse_name', 'jockey', 'marketStartTime']].drop_duplicates()

col1, col2, col3 = st.columns(3)

# Display each panel
with col1:
    st.subheader("🐎 Horse Form Momentum")
    horse_df = get_horse_momentum(df)
    st.dataframe(horse_df.sort_values(by='wins', ascending=False), use_container_width=True)

with col2:
    st.subheader("🧑‍✈️ Jockey Hot List")
    jockey_df = get_hot_jockeys(df)
    st.dataframe(jockey_df.sort_values(by='marketStartTime'), use_container_width=True)

with col3:
    st.subheader("🏠 Trainer Hot List")
    trainer_df = get_hot_trainers(df)
    st.dataframe(trainer_df.sort_values(by='marketStartTime'), use_container_width=True)

st.markdown("---")
st.caption("⚡ Updated daily with live market runners. Momentum is everything.")
