import streamlit as st
import sys
import pandas as pd
import requests
import json
from datetime import datetime
import sqlite3

# Page Config
st.set_page_config(page_title="Betfair Trading Dashboard", layout="wide")
st.title('📈 Dashboard Homepage')

# Add path explicitly to engines directory to import daily_config
sys.path.insert(0, '/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/engines')

# Import session token and app key from daily_config.py
from daily_config import SESSION_TOKEN, APP_KEY

# Headers with active session token
headers = {
    "X-Application": APP_KEY,
    "X-Authentication": SESSION_TOKEN,
    "Content-Type": "application/json"
}

# API Call method
def hijack_call(method, params=None):
    url = "https://api.betfair.com/exchange/account/json-rpc/v1"
    payload = {"jsonrpc": "2.0", "method": f"AccountAPING/v1.0/{method}", "params": params or {}, "id": 1}
    response = requests.post(url, headers=headers, data=json.dumps(payload))
    response.raise_for_status()
    return response.json().get('result', {})

# Fetch Real-Time Account Data
account_data = hijack_call("getAccountFunds")

# Load Today's Trades from Database
def load_todays_trades():
    conn = sqlite3.connect('/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db')
    today_date = datetime.now().date().isoformat()
    query = f"SELECT * FROM bets WHERE DATE(timestamp) = '{today_date}'"
    return pd.read_sql(query, conn)

todays_trades_df = load_todays_trades()

# Calculate Today's Metrics
daily_pl = todays_trades_df['pnl'].sum() if not todays_trades_df.empty else 0.00
open_trades = len(todays_trades_df)

# Key Metrics
st.subheader("Key Metrics")
cols = st.columns(5)
cols[0].metric("Total Bankroll", f"£{account_data.get('availableToBetBalance', 0):,.2f}")
cols[1].metric("Current Liability", f"£{account_data.get('exposure', 0):,.2f}")
cols[2].metric("Exposure", f"£{account_data.get('exposure', 0):,.2f}")
cols[3].metric("Daily P/L", f"£{daily_pl:,.2f}")
cols[4].metric("Open Trades", f"{open_trades}")

# Recent Trades
st.subheader("Recent Trades")
if not todays_trades_df.empty:
    recent_trades_display = todays_trades_df[['timestamp', 'odds', 'stake', 'pnl']].copy()
    recent_trades_display.columns = ['Time', 'Odds', 'Stake', 'P/L']
    st.dataframe(recent_trades_display, use_container_width=True)
else:
    st.info("No recent trades available.")

# Critical Alerts
st.subheader("Critical Alerts")
alerts = []

if account_data.get('exposure', 0) > (account_data.get('availableToBetBalance', 0) * 0.75):
    alerts.append("⚠️ High Exposure")
else:
    alerts.append("✅ Exposure Levels Normal")

if account_data.get('availableToBetBalance', 0) < 300:
    alerts.append("⚠️ Low Available Balance")
else:
    alerts.append("✅ Sufficient Available Balance")

for alert in alerts:
    if "⚠️" in alert:
        st.warning(alert)
    else:
        st.success(alert)

# Footer
st.markdown('---')
st.caption('🔄 Dashboard refreshes every 30 seconds. Data sourced via Betfair API & historical database.')