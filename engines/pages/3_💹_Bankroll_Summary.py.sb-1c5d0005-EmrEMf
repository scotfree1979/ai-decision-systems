import streamlit as st
import sys
from daily_config import AVAILABLE_BUDGET

# Page Configuration
st.set_page_config(page_title="Critical Alerts", layout="wide")
st.title('🚨 Critical Alerts')

# Add path explicitly to engines directory to import daily_config
sys.path.insert(0, '/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/engines')

# Import session token and headers from daily_config
from daily_config import SESSION_TOKEN, APP_KEY

# Headers with stable, live session token
headers = {
    "X-Application": APP_KEY,
    "X-Authentication": SESSION_TOKEN,
    "Content-Type": "application/json"
}

# API Call method
import requests
import json

def hijack_call(method, params=None):
    url = "https://api.betfair.com/exchange/betting/json-rpc/v1"
    payload = {"jsonrpc": "2.0", "method": f"SportsAPING/v1.0/{method}", "params": params or {}, "id": 1}
    response = requests.post(url, headers=headers, data=json.dumps(payload))
    response.raise_for_status()
    return response.json().get('result', {})

# Fetch account data and active bets for alert evaluation
account_data = hijack_call("getAccountFunds")
active_bets_data = hijack_call("listCurrentOrders")

# Evaluate Critical Alerts
alerts = []

# Low Available Balance Alert
if account_data.get('availableToBetBalance', 0) < 300:
    alerts.append(f"⚠️ Low Available Balance: Less than £300 available")
else:
    alerts.append(f"✅ Available Balance Healthy: £{account_data.get('availableToBetBalance', 0):.2f}")

# API Response Health Check
try:
    hijack_call("keepAlive")
    alerts.append("✅ API Connection Healthy")
except requests.RequestException as e:
    alerts.append(f"⚠️ API Connection Issue: {str(e)}")

# Unmatched Bets Alert
unmatched_bets = [bet for bet in active_bets_data.get('currentOrders', []) if bet['status'] == 'EXECUTABLE']
if unmatched_bets:
    alerts.append(f"⚠️ Unmatched Bets: {len(unmatched_bets)} orders currently unmatched")
else:
    alerts.append("✅ All bets matched successfully")

# Display Alerts
st.subheader("Real-Time System Alerts")
for alert in alerts:
    if "⚠️" in alert:
        st.warning(alert)
    else:
        st.success(alert)

# Footer
st.markdown('---')
st.caption('🔄 Dashboard refreshes every 30 seconds. Alerts are sourced from live Betfair API data.')