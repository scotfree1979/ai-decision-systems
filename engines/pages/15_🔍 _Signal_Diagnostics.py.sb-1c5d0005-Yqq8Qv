import sqlite3
from datetime import datetime, timedelta
import logging

DB_PATH = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db"

def fetch_today_bets():
    try:
        conn = sqlite3.connect(DB_PATH)
        cur = conn.cursor()
        cur.execute("""
            SELECT stake, confidence, strategy_name, placed_at
            FROM signal_diagnostics
            WHERE placed_at LIKE ?
        """, (datetime.utcnow().date().isoformat() + '%',))
        results = cur.fetchall()
        conn.close()
        return results
    except Exception as e:
        logging.error(f"❌ Failed to fetch today's bets: {e}")
        return []

def calculate_aggregate_metrics(records):
    total_bets = len(records)
    if total_bets == 0:
        return {
            "total_bets": 0,
            "total_stake": 0.0,
            "avg_confidence": 0.0,
            "projected_profit": 0.0,
            "roi_estimate": 0.08
        }
    total_stake = sum([r[0] for r in records])
    avg_conf = sum([r[1] for r in records]) / total_bets
    roi = 0.08  # baseline assumed
    profit = total_stake * roi
    return {
        "total_bets": total_bets,
        "total_stake": total_stake,
        "avg_confidence": round(avg_conf, 2),
        "projected_profit": round(profit, 2),
        "roi_estimate": roi
    }

def display_forecast(metrics):
    print("\n🧮 LIVE DAILY P&L FORECAST")
    print(f"📌 Total Bets Placed: {metrics['total_bets']}")
    print(f"💰 Total Stake: £{metrics['total_stake']:.2f}")
    print(f"📈 Avg Confidence: {metrics['avg_confidence']:.2f}")
    print(f"💸 Projected Profit (ROI {metrics['roi_estimate']*100:.0f}%): £{metrics['projected_profit']:.2f}")

def live_forecast_dashboard():
    records = fetch_today_bets()
    metrics = calculate_aggregate_metrics(records)
    display_forecast(metrics)

if __name__ == "__main__":
    live_forecast_dashboard()
