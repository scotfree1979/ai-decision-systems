# 13__Data_Export.py – Full Export Utility with Smart Filters & Summaries
import streamlit as st
import sqlite3
import pandas as pd
from datetime import datetime, timedelta
import json
import shutil
import os
import subprocess

DB_PATH = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db"
ARCHIVE_DIR = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/archive/"

st.set_page_config(page_title="Data Export Tool", layout="wide")
st.title("📤 Strategy Data Export")

# -------------------- UTILITY BUTTONS --------------------
st.markdown("### 🔧 System Maintenance")
colA, colB, colC = st.columns(3)

if colA.button("📦 Archive & Clear Database (End of Day)"):
    try:
        archive_name = f"bets_{datetime.utcnow().strftime('%Y-%m-%d')}.db"
        shutil.copy(DB_PATH, os.path.join(ARCHIVE_DIR, archive_name))
        with sqlite3.connect(DB_PATH) as conn:
            conn.execute("DELETE FROM bets")
            conn.commit()
        st.success(f"✅ Archived to {archive_name} and cleared bets.db")
    except Exception as e:
        st.error(f"❌ Archive failed: {e}")

if colB.button("🧹 Just Clear Database"):
    try:
        with sqlite3.connect(DB_PATH) as conn:
            conn.execute("DELETE FROM bets")
            conn.commit()
        st.success("✅ bets.db cleared.")
    except Exception as e:
        st.error(f"❌ Failed to clear database: {e}")

# 🧠 Session Token Entry and Launch
st.markdown("---")
st.markdown("### 🚀 Tool Launcher")
from daily_config import set_session_token

session_token = st.text_input("🔐 Enter your Betfair session token", type="password")

if st.button("▶️ Start Tool with Token"):
    try:
        set_session_token(session_token)
        subprocess.Popen(
            [
                "osascript", "-e",
                f'''
                tell application "Terminal"
                    activate
                    do script "cd '/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/engines' && python3 betfair_check.py"
                end tell
                '''
            ]
        )
        st.success("🟢 Tool launched in Terminal — session token saved to config.")
    except Exception as e:
        st.error(f"❌ Could not start tool: {e}")
    except Exception as e:
        st.error(f"❌ Could not start tool: {e}")

st.markdown("---")

# -------------------- FILTERS --------------------
today = datetime.utcnow().date()

date_option = st.selectbox("Select Date Range", ["Today", "Last 7 Days", "Last 30 Days", "Custom Range"])

if date_option == "Today":
    start_date, end_date = today, today
elif date_option == "Last 7 Days":
    start_date, end_date = today - timedelta(days=6), today
elif date_option == "Last 30 Days":
    start_date, end_date = today - timedelta(days=29), today
else:
    col1, col2 = st.columns(2)
    start_date = col1.date_input("Start Date", today - timedelta(days=7))
    end_date = col2.date_input("End Date", today)

with sqlite3.connect(DB_PATH) as conn:
    all_strats = pd.read_sql("SELECT DISTINCT strategy_name FROM bets WHERE strategy_name IS NOT NULL", conn)['strategy_name'].dropna().sort_values().tolist()
    all_bots = pd.read_sql("SELECT DISTINCT bot_name FROM bets WHERE bot_name IS NOT NULL", conn)['bot_name'].dropna().sort_values().tolist()
    all_status = pd.read_sql("SELECT DISTINCT status FROM bets", conn)['status'].dropna().sort_values().tolist()

strat_filter = st.multiselect("Filter by Strategy", all_strats, default=all_strats)
bot_filter = st.multiselect("Filter by Bot", all_bots, default=all_bots)
status_filter = st.multiselect("Filter by Status", all_status, default=all_status)
time_signal_filter = st.multiselect("Time Signal", ["time_20", "time_10", "time_5", "time_0"], default=["time_20", "time_10", "time_5", "time_0"])

# -------------------- LOAD DATA --------------------
query = f"""
    SELECT * FROM bets
    WHERE date BETWEEN '{start_date}' AND '{end_date}'
    AND strategy_name IN ({','.join(['?'] * len(strat_filter))})
    AND bot_name IN ({','.join(['?'] * len(bot_filter))})
    AND status IN ({','.join(['?'] * len(status_filter))})
    AND time_signal IN ({','.join(['?'] * len(time_signal_filter))})
"""
params = strat_filter + bot_filter + status_filter + time_signal_filter

with sqlite3.connect(DB_PATH) as conn:
    df = pd.read_sql_query(query, conn, params=params)

if df.empty:
    st.warning("⚠️ No data found for the selected filters.")
else:
    df['date'] = pd.to_datetime(df['date'])
    df['marketStartTime'] = pd.to_datetime(df['marketStartTime'], errors='coerce')
    df['minutes_to_off'] = ((df['marketStartTime'] - pd.Timestamp.utcnow()).dt.total_seconds() / 60).round(0)
    df['meta_json'] = df['meta_json'].apply(lambda x: json.loads(x) if x else {})
    df['swing_pct'] = df['meta_json'].apply(lambda x: x.get('volatility_swing_pct'))
    df['anchor_odds'] = df['meta_json'].apply(lambda x: x.get('anchor_odds'))
    df['status_tag'] = df['status'].apply(lambda x: f"🟢 {x}" if x == 'fully_enriched' else ("🟡 awaiting_signal" if x == 'awaiting_signal' else ("🔴 missed" if x == 'missed' else x)))
    df['placement_issue'] = df.apply(lambda row: '❌ Not Placed' if row['status'] == 'approved' and row.get('placed', 1) == 0 else '', axis=1)

    st.success(f"✅ Loaded {len(df)} rows")

    st.download_button("📥 Download as CSV", df.to_csv(index=False).encode('utf-8'), file_name="strategy_data_export.csv", mime='text/csv')
    st.download_button("📥 Download as JSON", df.to_json(orient="records").encode('utf-8'), file_name="strategy_data_export.json", mime='application/json')

    st.markdown("""
        #### 🧾 Assistant Diagnostic Export
        Copy and paste the following block into ChatGPT:
        ```
        Assistant Diagnostic Export:
        - Filters: {date_option} | Bots: {', '.join(bot_filter)} | Strategies: {', '.join(strat_filter)} | Status: {', '.join(status_filter)}
        - Time Signals: {', '.join(time_signal_filter)}
        - Includes: meta_json (swing_pct, anchor_odds), minutes_to_off, placement_issue, status_tag
        ```
    """)

    # -------------------- SMART EXPORT SUMMARIES --------------------
    st.subheader("📊 Smart Summary: Strategy Overview")
    strat_summary = df.groupby('strategy_name')['pnl'].agg(['count', 'sum', 'mean']).reset_index()
    strat_summary.columns = ['Strategy', 'Signals', 'Total PnL', 'Avg PnL']
    st.dataframe(strat_summary)

    st.subheader("🧠 Strike Rate & Rejection Rate by Bot")
    bot_df = df.copy()
    total_by_bot = bot_df.groupby('bot_name').size()
    placed_by_bot = bot_df[bot_df['status'] == 'placed'].groupby('bot_name').size()
    rejected_by_bot = bot_df[bot_df['status'] == 'rejected'].groupby('bot_name').size()
    strike_by_bot = bot_df[bot_df['status'] == 'won'].groupby('bot_name').size()

    perf_summary = pd.DataFrame({
        'Placed': placed_by_bot,
        'Rejected': rejected_by_bot,
        'Wins': strike_by_bot,
        'Total': total_by_bot
    }).fillna(0)
    perf_summary['Strike Rate (%)'] = (perf_summary['Wins'] / perf_summary['Total']) * 100
    perf_summary['Rejection Rate (%)'] = (perf_summary['Rejected'] / perf_summary['Total']) * 100

    st.dataframe(perf_summary[['Placed', 'Rejected', 'Strike Rate (%)', 'Rejection Rate (%)']])

    # -------------------- Failed Signals Export --------------------
    st.subheader("❌ Rejected Signals")
    rejected_df = df[df['status'] == 'rejected']
    st.dataframe(rejected_df[['strategy_name', 'bot_name', 'date', 'customerOrderRef', 'odds', 'stake', 'liability']], use_container_width=True)
    st.download_button("⬇️ Export Rejected Only (CSV)", rejected_df.to_csv(index=False).encode('utf-8'), file_name="rejected_signals.csv", mime='text/csv')

    st.markdown("---")
    st.caption("📦 Data is live and pulled from the main bet engine database.")
