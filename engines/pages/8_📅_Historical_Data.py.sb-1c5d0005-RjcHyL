import streamlit as st
import pandas as pd
import sqlite3
from datetime import datetime, timedelta
import plotly.express as px

DB_PATH = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db"

st.set_page_config(page_title="Historical Data Tracker", layout="wide")
st.title("\ud83d\uddd5\ufe0f Historical Strategy Performance")

@st.cache_data
def load_bets():
    with sqlite3.connect(DB_PATH) as conn:
        return pd.read_sql_query("SELECT * FROM bets WHERE placed_at IS NOT NULL", conn)

df = load_bets()

# Convert timestamp and prepare date
df['placed_at'] = pd.to_datetime(df['placed_at'], errors='coerce')
df = df[df['placed_at'].notna()]
df['date'] = df['placed_at'].dt.date

# --- TIMEFRAME FILTER ---
time_option = st.radio("\u23f2\ufe0f Select Timeframe", ["Last 1 Day", "Last 7 Days", "Last 30 Days"], horizontal=True)
if time_option == "Last 1 Day":
    cutoff = datetime.utcnow().date() - timedelta(days=1)
elif time_option == "Last 7 Days":
    cutoff = datetime.utcnow().date() - timedelta(days=7)
else:
    cutoff = datetime.utcnow().date() - timedelta(days=30)

filtered = df[df['date'] > cutoff]

# --- DAILY PERFORMANCE ---
daily = filtered.groupby('date').agg(
    total_races=('customerOrderRef', 'count'),
    winners=('status', lambda x: (x == 'won').sum()),
    losers=('status', lambda x: (x == 'lost').sum()),
    daily_pnl=('pnl', 'sum')
).reset_index()
daily['strike_rate'] = (daily['winners'] / daily['total_races']) * 100
daily['running_bank'] = daily['daily_pnl'].cumsum()

def outcome_category(row):
    if row['strike_rate'] >= 80:
        return "🟢 Excellent"
    elif row['strike_rate'] >= 65:
        return "🟡 Good"
    else:
        return "🔴 Poor"

daily['outcome'] = daily.apply(outcome_category, axis=1)

# --- SUMMARY METRICS ---
st.subheader("\ud83d\udcca Summary")
col1, col2, col3, col4, col5 = st.columns(5)
col1.metric("Total Races", int(daily['total_races'].sum()))
col2.metric("Total Wins", int(daily['winners'].sum()))
col3.metric("Total Losses", int(daily['losers'].sum()))
col4.metric("Avg Strike Rate", f"{daily['strike_rate'].mean():.2f}%")
col5.metric("Net P&L", f"\xa3{daily['daily_pnl'].sum():.2f}")

# --- DAILY STRIKE RATE CHART ---
st.subheader("\ud83d\udcc8 Daily Strike Rate")
fig1 = px.line(daily, x='date', y='strike_rate', markers=True, title="Daily Strike Rate (%)")
st.plotly_chart(fig1, use_container_width=True)

# --- BANKROLL OVER TIME ---
st.subheader("\ud83d\udcc9 Running Bank")
fig2 = px.line(daily, x='date', y='running_bank', markers=True, title="Cumulative P&L Over Time")
st.plotly_chart(fig2, use_container_width=True)

# --- DAILY LOG TABLE ---
st.subheader("\ud83d\udd0d Daily Breakdown")
st.dataframe(daily, use_container_width=True)

st.markdown("---")
st.caption("\u23f0 Refresh daily after each race day. Use this view to analyse success rates and bank growth over time.")
