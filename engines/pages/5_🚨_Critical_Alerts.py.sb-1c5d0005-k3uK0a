import streamlit as st
import sqlite3
import pandas as pd
import threading
from datetime import datetime, timedelta

DB_PATH = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db"

st.set_page_config(page_title="Critical Alerts", layout="wide")
st.title("\ud83d\udea8 Critical System Alerts")

now_utc = datetime.utcnow()
cutoff = now_utc - timedelta(minutes=30)

# ================================
# ⚠️  Load Recent Errors + Rejects
# ================================
def load_critical_issues():
    with sqlite3.connect(DB_PATH) as conn:
        df = pd.read_sql_query("""
            SELECT customerOrderRef, status, strategy_name, signal_type, bot_name, timestamp, marketStartTime
            FROM bets
            WHERE status IN ('rejected', 'error')
            AND timestamp >= ?
            ORDER BY timestamp DESC
        """, conn, params=(cutoff.isoformat(),))
        return df

# ================================
# 🧠 Thread Monitor & Health Check
# ================================
def thread_monitor():
    st.subheader("\ud83e\udde0 Thread Monitor")

    expected = {
        "core": ["RunMonitorLoop", "MarketMonitor", "SignalMonitor"],
        "bots": ["OGHeadTrader", "OGInPlay", "OGPreoff"],
        "utility": ["LaunchProtocol", "MarketMonitorStarter", "queue", "upgrade"]
    }

    active_threads = [t.name for t in threading.enumerate()]
    issues = []

    def check_group(group_name, names):
        group_status = []
        for name in names:
            found = any(name.lower() in t.lower() for t in active_threads)
            group_status.append((name, found))
        return group_status

    for group, names in expected.items():
        results = check_group(group, names)
        with st.expander(f"{group.title()} Threads", expanded=True):
            for thread_name, is_active in results:
                if is_active:
                    st.success(f"🟢 {thread_name}")
                else:
                    st.error(f"🔴 {thread_name} MISSING")

# ================================
# 📣 Display
# ================================
thread_monitor()
st.divider()
st.subheader("\u274c Rejected / Failed Bets (Last 30 min)")

critical_df = load_critical_issues()
if critical_df.empty:
    st.info("✅ No critical rejections or errors in the last 30 minutes.")
else:
    st.dataframe(critical_df, use_container_width=True)  # full-screen table
