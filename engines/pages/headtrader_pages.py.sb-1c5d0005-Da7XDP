import streamlit as st
import sqlite3
import pandas as pd

st.title("📤 Data Export")

DB_PATH = 'data/bets.db'

@st.cache_data
def fetch_export_data():
    with sqlite3.connect(DB_PATH) as conn:
        bets = pd.read_sql_query("SELECT * FROM bets", conn)
        logs = pd.read_sql_query("SELECT * FROM optimizer_logs", conn)
    return bets, logs

bets_df, logs_df = fetch_export_data()

st.subheader("Export Optimizer Logs")
st.download_button("Download as CSV", data=logs_df.to_csv(index=False), file_name="optimizer_logs.csv")
st.download_button("Download as JSON", data=logs_df.to_json(orient='records'), file_name="optimizer_logs.json")

st.subheader("Export Bet Records")
st.download_button("Download as CSV", data=bets_df.to_csv(index=False), file_name="bets.csv")
st.download_button("Download as JSON", data=bets_df.to_json(orient='records'), file_name="bets.json")
