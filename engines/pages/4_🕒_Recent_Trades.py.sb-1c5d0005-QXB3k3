# 4_🕒_Recent_Trades.py – Fixed with Live + Historical Trades
import streamlit as st
import pandas as pd
import plotly.express as px
import sqlite3
import requests
import json

st.set_page_config(page_title="Recent Trades", layout="wide")
st.title('🕒 Recent Trades')

headers = {
    "X-Application": "CZHojduNWa3kxWIn",
    "X-Authentication": st.session_state.get('session_token', ''),
    "Content-Type": "application/json"
}

def hijack_call(method, params=None):
    url = "https://api.betfair.com/exchange/betting/json-rpc/v1"
    payload = {"jsonrpc": "2.0", "method": f"SportsAPING/v1.0/{method}", "params": params or {}, "id": 1}
    response = requests.post(url, headers=headers, data=json.dumps(payload))
    response.raise_for_status()
    return response.json().get('result', {})

def fetch_recent_trades():
    return hijack_call("listClearedOrders")

recent_trades_data = fetch_recent_trades()
recent_trades_df = pd.DataFrame(recent_trades_data.get('clearedOrders', []))

def load_historical_trades():
    conn = sqlite3.connect('/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db')
    query = "SELECT placed_at AS timestamp, market_id, selection_id, horse_name, bot_name, price AS odds, stake, pnl FROM bets ORDER BY placed_at DESC LIMIT 50"
    return pd.read_sql(query, conn)

historical_trades_df = load_historical_trades()

st.subheader("📡 Live Cleared Trades (from API)")
if not recent_trades_df.empty:
    api_df = recent_trades_df[['placedDate', 'marketId', 'selectionId', 'side', 'priceRequested', 'sizeSettled', 'profit']].copy()
    api_df.columns = ['Placed Time', 'Market ID', 'Selection ID', 'Side', 'Odds', 'Stake', 'Profit (£)']
    st.dataframe(api_df, use_container_width=True)
else:
    st.info("No recent cleared trades available from API.")

st.subheader("📋 Last 50 Trades (from Local Database)")
if not historical_trades_df.empty:
    historical_trades_df['timestamp'] = pd.to_datetime(historical_trades_df['timestamp']).dt.strftime('%Y-%m-%d %H:%M:%S')
    st.dataframe(historical_trades_df, use_container_width=True)

    st.subheader("📈 Profit/Loss Analysis")
    fig_pnl = px.bar(historical_trades_df, x='timestamp', y='pnl', title='Profit/Loss per Trade',
                     labels={'pnl': 'Profit/Loss (£)', 'timestamp': 'Trade Timestamp'},
                     color='pnl', color_continuous_scale='RdYlGn')
    st.plotly_chart(fig_pnl, use_container_width=True)

    st.subheader("🎯 Odds vs. Stake Distribution")
    fig_os = px.scatter(historical_trades_df, x='odds', y='stake', color='pnl',
                        title='Odds vs. Stake (Colored by P/L)',
                        labels={'odds': 'Odds', 'stake': 'Stake (£)'},
                        color_continuous_scale='RdYlGn')
    st.plotly_chart(fig_os, use_container_width=True)
else:
    st.info("No local trade history found.")

st.markdown('---')
st.subheader("🏇 Best and Worst Performing Runners (Local DB)")
runner_pnl = historical_trades_df.groupby('horse_name')['pnl'].sum().sort_values(ascending=False)
col1, col2 = st.columns(2)
col1.write("### 🟢 Top 10 Runners")
col1.dataframe(runner_pnl.head(10))
col2.write("### 🔴 Bottom 10 Runners")
col2.dataframe(runner_pnl.tail(10))

st.subheader("📉 Top 5 Drawdown Trades")
worst_trades = historical_trades_df.sort_values(by='pnl').head(5)
st.dataframe(worst_trades[['timestamp', 'horse_name', 'odds', 'stake', 'pnl']], use_container_width=True)

st.markdown('---')
st.caption('🔄 Data sourced from Betfair API & local database (bets.db)')'🔄 Data sourced from Betfair API & local database (bets.db)')
