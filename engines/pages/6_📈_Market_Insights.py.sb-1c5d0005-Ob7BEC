# 6_📈_Market_Insights.py – Live Trading Market Snapshots
import streamlit as st
import pandas as pd
import sqlite3
from datetime import datetime

DB_PATH = '/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db'

st.set_page_config(page_title="Market Insights", layout="wide")
st.title("📈 Market Insights")

@st.cache_data

def fetch_insights():
    with sqlite3.connect(DB_PATH) as conn:
        query = '''
        SELECT
            marketId,
            event_name,
            market_name,
            marketStartTime,
            strategy_name,
            signal_type,
            bot_name,
            status,
            odds,
            stake,
            pnl,
            time_signal,
            datetime(timestamp) as timestamp
        FROM bets
        WHERE strategy_name IS NOT NULL
        ORDER BY timestamp DESC
        LIMIT 500
        '''
        return pd.read_sql_query(query, conn)

# Load data
try:
    df = fetch_insights()

    # Format columns for display
    df['Off Time'] = pd.to_datetime(df['marketStartTime']).dt.strftime('%H:%M')
    df['Timestamp'] = pd.to_datetime(df['timestamp']).dt.strftime('%Y-%m-%d %H:%M:%S')

    rename_cols = {
        'event_name': 'Venue',
        'market_name': 'Market',
        'strategy_name': 'Strategy',
        'signal_type': 'Signal',
        'bot_name': 'Bot',
        'status': 'Status',
        'odds': 'Odds',
        'stake': 'Stake',
        'pnl': 'P&L',
        'time_signal': 'Time Frame'
    }
    df = df.rename(columns=rename_cols)

    display_cols = [
        'marketId', 'Venue', 'Market', 'Off Time', 'Strategy', 'Signal', 'Bot',
        'Status', 'Odds', 'Stake', 'P&L', 'Time Frame', 'Timestamp'
    ]

    st.markdown("""
    ### 📊 Recent Signals & Strategy Activity
    """)
    st.dataframe(df[display_cols], use_container_width=True)

except Exception as e:
    st.error(f"❌ Failed to load market insights: {e}")

# Footer
st.markdown('---')
st.caption(':hourglass: Insights update every 60 seconds. Showing latest 500 signal-driven market entries.')
