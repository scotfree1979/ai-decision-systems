import streamlit as st
import pandas as pd
import plotly.express as px
import requests
import json
import sqlite3

# Page Configuration
st.set_page_config(page_title="Risk & Liability Management", layout="wide")
st.title('⚠️ Risk & Liability Management')

# Headers with session token from session state
headers = {
    "X-Application": "CZHojduNWa3kxWIn",
    "X-Authentication": st.session_state.get('session_token', ''),
    "Content-Type": "application/json"
}

# API Back-door methods
def hijack_call(method, params=None):
    url = "https://api.betfair.com/exchange/betting/json-rpc/v1"
    payload = {"jsonrpc": "2.0", "method": f"SportsAPING/v1.0/{method}", "params": params or {}, "id": 1}
    response = requests.post(url, headers=headers, data=json.dumps(payload))
    response.raise_for_status()
    return response.json().get('result', {})

# Load Real-Time Account Data
account_data = hijack_call("getAccountFunds")

# Risk and Liability Overview
st.subheader("Real-Time Risk & Liability Overview")
cols = st.columns(3)
cols[0].metric("Available to Bet (£)", f"£{account_data.get('availableToBetBalance', 0):,.2f}")
cols[1].metric("Current Exposure (£)", f"£{account_data.get('exposure', 0):,.2f}")
cols[2].metric("Total Liability (£)", f"£{account_data.get('retainedCommission', 0):,.2f}")

# Load Active Bets
active_bets_data = hijack_call("listCurrentOrders")
active_bets_df = pd.DataFrame(active_bets_data.get('currentOrders', []))

# Active Bets and Liability Analysis
st.subheader("Active Bets & Liability")
if not active_bets_df.empty:
    active_bets_df['liability'] = active_bets_df.apply(
        lambda row: row['priceSize']['size'] * (row['priceSize']['price'] - 1) if row['side'] == 'LAY' else row['priceSize']['size'], axis=1)
    total_liability = active_bets_df['liability'].sum()
    st.metric("Total Active Liability (£)", f"£{total_liability:,.2f}")
    st.dataframe(active_bets_df[['marketId', 'selectionId', 'side', 'priceSize', 'status', 'liability']], use_container_width=True)
else:
    st.info("No active bets to display.")

# Historical Liability Management
st.subheader("Historical Liability Analysis")
def load_historical_liability():
    conn = sqlite3.connect('/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db')
    query = "SELECT timestamp, pnl FROM bets ORDER BY timestamp ASC"
    return pd.read_sql(query, conn)

historical_liability_df = load_historical_liability()
historical_liability_df['timestamp'] = pd.to_datetime(historical_liability_df['timestamp'])
historical_liability_df['cumulative_pnl'] = historical_liability_df['pnl'].cumsum()

fig_liability = px.line(historical_liability_df, x='timestamp', y='cumulative_pnl',
                        title='Cumulative Profit & Loss (Historical Liability)',
                        labels={'cumulative_pnl': 'Cumulative PnL (£)'}, markers=True)
st.plotly_chart(fig_liability, use_container_width=True)

# Risk Management Recommendations
st.subheader("Risk Management Recommendations")

if account_data.get('exposure', 0) > 1000:
    st.warning("⚠️ High exposure detected. Consider reducing bet sizes or hedging positions.")
else:
    st.success("✅ Exposure within acceptable limits.")

if account_data.get('availableToBetBalance', 0) < 100:
    st.warning("⚠️ Low available balance. Deposit more funds or reduce active bets.")
else:
    st.success("✅ Available balance is healthy.")

# Footer
st.markdown('---')
st.caption('🔄 Dashboard refreshes every 30 seconds. Data sourced from real-time Betfair API and historical database.')