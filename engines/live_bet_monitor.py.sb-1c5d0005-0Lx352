from core.api_hijacker import list_market_book
import time
import sqlite3
import datetime
from core.betfair_api import get_session as get_trading_session

DATABASE_PATH = '/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/data/bets.db'

def live_bet_monitor_loop(trading_session):
    print("🔍 Live Bet Monitor loop started.")
    while True:
        monitor_bets_in_db(trading_session)
        time.sleep(60)  # Check every 60 seconds

def log_settlement_to_strategy_logs(betfair_bet_id, status):
    print(f"🎯 Betfair Bet ID {betfair_bet_id} settled as {status}")

def monitor_bets_in_db(trading_session):
    conn = sqlite3.connect(DATABASE_PATH)
    cursor = conn.cursor()

    cursor.execute("SELECT betfair_bet_id FROM Bets WHERE bet_outcome = 'Pending'")
    open_bets = cursor.fetchall()

    # Check settlement status via Betfair API (correct method)
    settled_orders = trading_session.betting.list_cleared_orders(bet_status='SETTLED').orders

    # Map Betfair Order IDs to results
    settled_results = {order.bet_id: order.profit for order in settled_orders}

    for (betfair_bet_id,) in open_bets:
        if betfair_bet_id in settled_results:
            profit = settled_results[betfair_bet_id]
            settlement_timestamp = datetime.datetime.now().isoformat()
            status = 'WON' if profit > 0 else 'LOST'
            pnl = round(profit, 2)

            cursor.execute("""
                UPDATE Bets
                SET status = ?, settlement_timestamp = ?, bet_outcome = ?, pnl = ?, result = ?
                WHERE betfair_bet_id = ?
            """, ('settled', settlement_timestamp, status, pnl, status.lower(), betfair_bet_id))

            log_settlement_to_strategy_logs(betfair_bet_id, status)
            print(f"🏁 Bet {betfair_bet_id} settled as {status}, P&L: {pnl}")

        else:
            # Check if still unmatched/matched but not settled
            current_orders = trading_session.betting.list_current_orders(bet_ids=[betfair_bet_id]).orders
            if current_orders:
                order_status = current_orders[0].status.lower()
                matched_timestamp = datetime.datetime.now().isoformat()
                cursor.execute("""
                    UPDATE Bets
                    SET status = ?, matched_timestamp = ?
                    WHERE betfair_bet_id = ?
                """, (order_status, matched_timestamp, betfair_bet_id))
                print(f"✅ Bet {betfair_bet_id} status updated to {order_status}")

    conn.commit()
    conn.close()

if __name__ == "__main__":
    trading_session = get_trading_session()
    live_bet_monitor_loop(trading_session)
