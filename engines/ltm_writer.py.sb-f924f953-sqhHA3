import sqlite3
import threading
import time
import json
from datetime import datetime
from config_paths import DB_PATH
from signal_memory_engine import signal_memory

def extract_ltm_record(key, playbook):
    return {
        "playbook_group_id": playbook.get("playbook_group_id"),
        "marketId": key[0],
        "selectionId": key[1],
        "pattern_key": playbook.get("pattern_key"),
        "blueprint_match": playbook.get("blueprint_match"),
        "scalp_direction": playbook.get("scalp_direction"),
        "tick_pattern": playbook.get("tick_pattern"),
        "confidence": playbook.get("confidence"),
        "scalp_ticks": playbook.get("scalp_ticks"),
        "entry_odds": playbook.get("entry_odds"),
        "hedge_odds": playbook.get("hedge_odds"),
        "entry_side": playbook.get("entry_side"),
        "hedge_side": playbook.get("hedge_side"),
        "entry_stake": playbook.get("entry_stake"),
        "hedge_stake": playbook.get("hedge_stake"),
        "entry_bet_id": playbook.get("entry_bet_id"),
        "hedge_bet_id": playbook.get("hedge_bet_id"),
        "pnl": playbook.get("pnl"),
        "result": playbook.get("status"),
        "opened_at": datetime.utcfromtimestamp(playbook.get("opened_at", time.time())).isoformat(),
        "closed_at": datetime.utcfromtimestamp(playbook.get("closed_at", time.time())).isoformat(),
        "customer_order_ref": playbook.get("customer_order_ref"),
        "ladder_matched": playbook.get("ladder_matched"),
        "ladder_total": playbook.get("ladder_total")
    }

def write_ltm_playbook_record(record):
    try:
        with sqlite3.connect(DB_PATH) as conn:
            cursor = conn.cursor()
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS ltm_playbooks (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    playbook_group_id TEXT,
                    marketId TEXT,
                    selectionId INTEGER,
                    pattern_key TEXT,
                    blueprint_match TEXT,
                    scalp_direction TEXT,
                    tick_pattern TEXT,
                    confidence REAL,
                    scalp_ticks INTEGER,
                    entry_odds REAL,
                    hedge_odds REAL,
                    entry_side TEXT,
                    hedge_side TEXT,
                    entry_stake REAL,
                    hedge_stake REAL,
                    entry_bet_id TEXT,
                    hedge_bet_id TEXT,
                    pnl REAL,
                    result TEXT,
                    opened_at TEXT,
                    closed_at TEXT,
                    customer_order_ref TEXT,
                    ladder_matched INTEGER,
                    ladder_total INTEGER
                )
            """)
            cursor.execute("""
                INSERT INTO ltm_playbooks (
                    playbook_group_id, marketId, selectionId, pattern_key, blueprint_match,
                    scalp_direction, tick_pattern, confidence, scalp_ticks,
                    entry_odds, hedge_odds, entry_side, hedge_side,
                    entry_stake, hedge_stake, entry_bet_id, hedge_bet_id,
                    pnl, result, opened_at, closed_at, customer_order_ref, ladder_matched, ladder_total
                )
                VALUES (:playbook_group_id, :marketId, :selectionId, :pattern_key, :blueprint_match,
                        :scalp_direction, :tick_pattern, :confidence, :scalp_ticks,
                        :entry_odds, :hedge_odds, :entry_side, :hedge_side,
                        :entry_stake, :hedge_stake, :entry_bet_id, :hedge_bet_id,
                        :pnl, :result, :opened_at, :closed_at, :customer_order_ref, :ladder_matched, :ladder_total)
            """, record)
            conn.commit()
            print(f"📘 Saved completed playbook: {record['pattern_key']} for {record['selectionId']}")
    except Exception as e:
        print(f"⚠️ Failed to save playbook record: {e}")

def write_completed_playbooks_to_ltm():
    already_saved = set()
    while True:
        try:
            snapshot = dict(signal_memory.live_playbooks)
            for key, playbook in snapshot.items():
                if playbook.get("status") not in ["success", "poor_edge"]:
                    continue

                id_key = (key[0], key[1], playbook.get("playbook_group_id"))
                if id_key in already_saved:
                    continue

                record = extract_ltm_record(key, playbook)
                write_ltm_playbook_record(record)
                already_saved.add(id_key)

        except Exception as e:
            print(f"❌ LTM playbook writer error: {e}")

        time.sleep(15)

threading.Thread(target=write_completed_playbooks_to_ltm, name="LTMPlaybookWriter", daemon=True).start()
