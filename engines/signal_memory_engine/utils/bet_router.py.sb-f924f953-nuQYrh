from bet_core import place_bet

def fire_initial_bet(market_id, selection_id, side, odds, stake, customer_order_ref):
    return place_bet(
        market_id=market_id,
        selection_id=selection_id,
        side=side,
        odds=odds,
        stake=stake,
        customer_order_ref=customer_order_ref
    )
