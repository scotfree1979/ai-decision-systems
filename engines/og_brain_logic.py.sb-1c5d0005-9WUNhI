import logging
import time
import sqlite3
from datetime import datetime
from queue import Empty

from config_paths import DB_PATH
from upgrade_import_patch import (
    bot_signal_queues,
    place_basic_lay_bet,
    place_ladder_lay_bet,
    place_greenup_exit,
    place_inplay_lay_bet,
    place_scalp_trade,
    manage_bet_hedging,
    penny_logic,
    get_market_book,
    head_trader
)
from volatility_check import real_time_volatility_check
from price_math import calculate_tick_distance

# ✅ Configurable Constants
MAX_INPLAY_LAYS_PER_HORSE = 4
MAX_TOTAL_LAYS_PER_RACE = 16
MIN_TICK_SPREAD = 10
RELAY_COOLDOWN_SECONDS = 15

# 🧠 Internal Tracker for In-Play Lay State
inplay_lays = {}

# 🧠 Core Handler

def place_bets_from_brain():
    logging.info("🧠 OG Brain: Live execution started")
    while True:
        for bot_name, queue in bot_signal_queues.items():
            try:
                signal = queue.get_nowait()
                market_id = signal['marketId']
                selection_id = signal['selectionId']
                strategy = signal['strategy_name']
                bet_type = signal['bet_type']

                # 🧠 Decision Delegation
                if bet_type == "LADDER":
                    if head_trader.should_ladder(selection_id):
                        place_ladder_lay_bet(signal)

                elif bet_type == "GREENUP":
                    result = place_greenup_exit(signal)
                    if not result:
                        # 🧠 Apply fallback risk-shaping logic
                        liability = signal.get("stake", 5.0)
                        runner_rank = head_trader.get_runner_rank(market_id, selection_id)
                        target_loss = runner_rank * 10  # e.g., 1st = 10, 2nd = 20
                        adjusted_liability = head_trader.adjust_liability(liability, target_loss)
                        place_basic_lay_bet({**signal, "stake": adjusted_liability})

                elif bet_type == "SCALP":
                    odds = signal.get("odds")
                    anchor = signal.get("anchor_odd")
                    drift = calculate_tick_distance(anchor, odds)
                    if drift >= MIN_TICK_SPREAD:
                        place_scalp_trade(signal)

                elif bet_type == "INPLAY":
                    if market_id not in inplay_lays:
                        inplay_lays[market_id] = {}
                    if selection_id not in inplay_lays[market_id]:
                        inplay_lays[market_id][selection_id] = []

                    now = time.time()
                    past_lays = inplay_lays[market_id][selection_id]

                    # ✅ Eligibility: Under 4 lays, spaced >15s, min tick movement
                    if len(past_lays) < MAX_INPLAY_LAYS_PER_HORSE:
                        last_lay_time = past_lays[-1] if past_lays else 0
                        if now - last_lay_time > RELAY_COOLDOWN_SECONDS:
                            current_odds = get_market_book(market_id, selection_id).get("lay")
                            if current_odds:
                                drift = calculate_tick_distance(signal["odds"], current_odds)
                                if drift >= MIN_TICK_SPREAD:
                                    place_inplay_lay_bet({**signal, "odds": current_odds})
                                    inplay_lays[market_id][selection_id].append(now)

                else:
                    logging.warning(f"⚠️ Unknown bet_type: {bet_type} for {signal.get('customerOrderRef')}")

            except Empty:
                continue
            except Exception as e:
                logging.error(f"❌ OG Brain Error: {e}")

        time.sleep(1)
