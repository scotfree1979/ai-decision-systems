from upgrade_import_patch import *
import logging
import time
from bet_placer import place_basic_lay_bet, place_inplay_lay_bet, place_greenup_exit
from rules.head_trader_rules import *

class PreOffBot:
    def __init__(self, risk_manager, budget_manager, headers, bot_signal_queue):
        self.risk_manager = risk_manager
        self.budget_manager = budget_manager
        self.headers = headers
        self.bot_signal_queue = bot_signal_queue
        logging.info('PreOffBot initialized clearly with Risk Manager and Budget Manager.')

    def start_loop(self):
        logging.info('PreOffBot loop explicitly started.')

        while True:
            try:
                signal = self.bot_signal_queue.get()
                logging.info(f"[PreOffBot] Explicitly received signal: {signal}")
                logging.info(f"[PreOffBot] session_token: {signal.get('session_token')}")

                if signal.get("status") == "approved":
                    bet_type = signal.get("bet_type", "")

                    if bet_type == "BASIC":
                        place_basic_lay_bet(signal)
                        logging.info(f"✅ Basic lay placed by PreOffBot for market {signal['marketId']}")

                    elif bet_type == "LADDER":
                        place_ladder_lay_bet(signal)
                        logging.info(f"🪜 Ladder lay placed by PreOffBot for market {signal['marketId']}")

                    elif bet_type == "SCALP":
                        place_scalp_trade(signal)
                        logging.info(f"💹 Scalping trade placed by PreOffBot for market {signal['marketId']}")

                    elif bet_type == "GREENUP":
                        place_greenup_exit(signal)
                        logging.info(f"✅ Green-Up completed by PreOffBot for market {signal['marketId']}")

                self.bot_signal_queue.task_done()

            except Exception as e:
                logging.error(f"❌ PreOffBot loop crashed: {e}")
            time.sleep(0.5)
