from upgrade_import_patch import *
import logging
import sqlite3
import pandas as pd
from queue import Queue
from datetime import datetime
from signal_monitor import bot_signal_queues
from bet_placer import place_basic_lay_bet, place_inplay_lay_bet, place_greenup_exit

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

class OGInPlayBot:
    def __init__(self, risk_manager, budget_manager, headers, signal_queue):
        self.risk_manager = risk_manager
        self.budget_manager = budget_manager
        self.headers = headers
        self.signal_queue = signal_queue
        self.DB_PATH = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/engines/bets.db"
        logging.info('OGInPlayBot: Initialized with centralized Risk Manager and Budget Manager.')

    def fetch_recent_trades(self):
        conn = sqlite3.connect(self.DB_PATH)
        trades = pd.read_sql("SELECT horse, odds, result FROM bets ORDER BY timestamp DESC LIMIT 10", conn)
        conn.close()
        return trades

    def start_loop(self):
        logging.info('OGInPlayBot: Starting signal processing loop.')

        while True:
            signal = self.signal_queue.get()
            logging.info(f"[OGInPlay] Received signal: {signal}")

            approved_signal = self.risk_manager.evaluate_signal(signal)
            if approved_signal:
                approved_signal = self.budget_manager.evaluate_budget(approved_signal)

                if approved_signal:
                    strategy_name = approved_signal.get('strategy_name', 'Basic Lay')

                    if strategy_name == 'Basic Lay':
                        place_basic_lay_bet(approved_signal)
                        logging.info(f"✅ Basic lay placed by In-Play Bot for market {approved_signal['marketId']}")

                    elif strategy_name == 'In-Play Lay':
                        place_inplay_lay_bet(approved_signal)
                        logging.info(f"🏇 In-Play lay triggered by In-Play Bot for market {approved_signal['marketId']}")

                    elif strategy_name == 'Green-Up':
                        place_greenup_exit(approved_signal)
                        logging.info(f"✅ Green-Up completed by In-Play Bot for market {approved_signal['marketId']}")

            self.signal_queue.task_done()