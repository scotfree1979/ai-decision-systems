# og_bot_family/og_inplay_bot.py

import logging
from .og_inplay_logic import inplay_loop

class OGInPlayBot:
    def __init__(self, risk_manager):
        self.risk_manager = risk_manager
        logging.info('In-Play Bot: Initialized successfully with centralized Risk Manager.')

    def start_loop(self):
        logging.info('In-Play Bot: Loop starting.')
        inplay_loop(self.risk_manager)
