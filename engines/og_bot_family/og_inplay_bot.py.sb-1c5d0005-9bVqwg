from bet_placer import place_basic_lay_bet, place_ladder_lay_bet, place_scalp_trade, place_greenup_exit, place_inplay_lay_bet
from rules.head_trader_rules import *

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

class OGInPlayBot:
    def __init__(self, risk_manager, budget_manager, headers, bot_signal_queues, head_trader=None):
        self.risk_manager = risk_manager
        self.budget_manager = budget_manager
        self.headers = headers
        self.bot_signal_queues = bot_signal_queues
        self.bot_signal_queue = self.bot_signal_queues["OGInPlay"]
        self.head_trader = head_trader
        self.DB_PATH = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/engines/bets.db"
        logging.info('OGInPlayBot: Initialized with centralized Risk Manager and Budget Manager.')

    def fetch_recent_trades(self):
        conn = sqlite3.connect(self.DB_PATH)
        trades = pd.read_sql("SELECT horse, odds, result FROM bets ORDER BY timestamp DESC LIMIT 10", conn)
        conn.close()
        return trades

    def start_loop(self):
        logging.info('OGInPlayBot: Starting signal processing loop.')

        while True:
            signal = self.bot_signal_queue.get()
            logging.info(f"[OGInPlay] Received signal: {signal}")

            if signal.get("status") == "approved":
                bet_type = signal.get("bet_type", "")

                if bet_type == "BASIC":
                    place_basic_lay_bet(signal)
                    logging.info(f"✅ Basic lay placed by In-Play Bot for market {signal['marketId']}")

                elif bet_type == "INPLAY":
                    place_inplay_lay_bet(signal)
                    logging.info(f"🏇 In-Play lay triggered by In-Play Bot for market {signal['marketId']}")

                elif bet_type == "GREENUP":
                    place_greenup_exit(signal)
                    logging.info(f"✅ Green-Up completed by In-Play Bot for market {signal['marketId']}")

            self.bot_signal_queue.task_done()
