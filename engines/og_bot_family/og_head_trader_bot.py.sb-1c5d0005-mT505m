# og_bot_family/og_head_trader_bot.py

import logging
from .og_inplay_bot import OGInPlayBot
from .og_preoff_bot import PreOffBot

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

def orchestrate_bots(risk_manager):
    logging.info('OGHeadTrader Bot: Starting orchestration.')

    # Initialize subordinate bots explicitly with centralized Risk Manager
    inplay_bot = OGInPlayBot(risk_manager)
    preoff_bot = PreOffBot(risk_manager)

    # Start loops explicitly
    preoff_bot.start_loop()
    inplay_bot.start_loop()

    logging.info('OGHeadTrader Bot: Bots running smoothly.')

if __name__ == '__main__':
    # Note: For standalone testing purposes, initialize a temporary Risk Manager
    from risk_manager import RiskManager
    temp_risk_manager = RiskManager(
        max_liability_per_race=100,
        max_daily_loss_per_bot=300,
        global_max_exposure=500,
        max_concurrent_races=3,
        stop_loss_threshold=50,
        profit_lock_threshold=30
    )
    orchestrate_bots(temp_risk_manager)

