import logging
import sqlite3
import pandas as pd
from queue import Queue
from datetime import datetime
from signal_monitor import bot_signal_queues
from bet_placer import place_bet, execute_scalp, green_up

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

class OGInPlayBot:
    def __init__(self, risk_manager, budget_manager, headers, signal_queue):
        self.risk_manager = risk_manager
        self.budget_manager = budget_manager
        self.headers = headers
        self.signal_queue = signal_queue
        self.DB_PATH = "/Volumes/Sonnics/Race Tool - Sandbox/analytics_beta/engines/bets.db"
        logging.info('OGInPlayBot: Initialized with centralized Risk Manager and Budget Manager.')

    def fetch_recent_trades(self):
        conn = sqlite3.connect(self.DB_PATH)
        trades = pd.read_sql("SELECT horse, odds, result FROM bets ORDER BY timestamp DESC LIMIT 10", conn)
        conn.close()
        return trades

    def inplay_strategy(self, market_data):
        volatility_threshold = 0.5
        bet_signals = []

        for data in market_data:
            horse_name, odds, volatility = data
            if volatility > volatility_threshold:
                bet_signals.append({
                    'horse': horse_name,
                    'odds': odds,
                    'signal_strength': 'high',
                    'reason': 'High volatility, opportunity for profit'
                })
            else:
                bet_signals.append({
                    'horse': horse_name,
                    'odds': odds,
                    'signal_strength': 'low',
                    'reason': 'Volatility below threshold'
                })
        return bet_signals

    def start_loop(self):
        logging.info('OGInPlayBot: Starting signal processing loop.')

        while True:
            signal = self.signal_queue.get()
            logging.info(f"[OGInPlay] Received signal: {signal}")

            market_id = signal['marketId']
            selection_id = signal['selectionId']
            stake = signal['stake']
            odds = signal['odds']
            bet_type = signal['bet_type']
            strategy_name = signal['strategy_name']
            market_start_time = signal['marketStartTime']

            if strategy_name == 'Basic Lay':
                place_bet(self.headers, market_id, selection_id, stake, odds, bet_type)
                logging.info(f"✅ Basic lay bet triggered by In-Play Bot for market {market_id}")

            elif strategy_name == 'Scalping':
                execute_scalp(self.headers, market_id, selection_id, stake, odds, bet_type, market_start_time)
                logging.info(f"✅ Scalping initiated by In-Play Bot for market {market_id}")

            elif strategy_name == 'Green-Up':
                green_up(self.headers, market_id)
                logging.info(f"✅ Green-Up executed by In-Play Bot for market {market_id}")

            recent_trades = self.fetch_recent_trades()
            logging.info(f"[OGInPlay] Recent trades: \n{recent_trades.head()}")

            market_data = recent_trades[['horse', 'odds', 'result']].values
            bet_signals = self.inplay_strategy(market_data)

            for bet_signal in bet_signals:
                logging.info(f"[OGInPlay] Bet Signal: {bet_signal}")
                approved_signal = self.risk_manager.evaluate_signal(bet_signal)

                if not approved_signal:
                    matched_liability, unmatched_liability, _ = self.budget_manager.get_bot_status_from_db("OGInPlay")
                    approved_signal = self.budget_manager.handle_rejected_signal(
                        bet_signal, matched_liability, unmatched_liability, "Budget limit reached"
                    )

                if approved_signal:
                    place_bet(
                        self.headers,
                        approved_signal['marketId'],
                        approved_signal['selectionId'],
                        approved_signal['stake'],
                        approved_signal['odds'],
                        'LAY'
                    )
                    logging.info(f"[OGInPlay] Bet placed explicitly: {approved_signal['marketId']}")

                    execute_scalp(
                        self.headers,
                        approved_signal['marketId'],
                        approved_signal['selectionId'],
                        approved_signal['stake'],
                        approved_signal['odds'],
                        'LAY',
                        market_start_time
                    )
                    logging.info(f"[OGInPlay] Scalping bet executed explicitly for: {bet_signal['horse']}")

            self.signal_queue.task_done()