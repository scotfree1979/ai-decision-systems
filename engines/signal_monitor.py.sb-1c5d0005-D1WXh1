# signal_monitor.py

import logging
from queue import Queue

signal_queue = Queue()

# Explicit bot assignment dictionary for clarity and easy updates
bot_assignments = {
    'Market Drifter Signal': ['OGHeadTrader', 'OGPreoff'],
    'Market Steamer Signal': ['OGHeadTrader', 'OGPreoff'],
    'In-Play Opportunity': ['OGHeadTrader', 'OGInPlay'],
    'Early Pace Collapse': ['OGHeadTrader', 'OGInPlay'],
    'Late Surge Fade': ['OGPreoff'],
    'Odds Spike Reversal': ['OGHeadTrader', 'OGInPlay'],
    'Drifter Recovery': ['OGPreoff'],
    'Venue/Trainer/Jockey Signals': ['OGHeadTrader', 'OGPreoff'],
    'Scalping Signal': ['OGPreoff'],
    'Hedging Signal': ['OGHeadTrader', 'OGPreoff'],
    'Race Off Signal': ['OGInPlay']
}

# Queues for each bot for direct action
bot_signal_queues = {
    'OGHeadTrader': Queue(),
    'OGPreoff': Queue(),
    'OGInPlay': Queue()
}

def signal_monitor(signal):
    strategy_type = signal.get('strategyType')

    if strategy_type in bot_assignments:
        bots = bot_assignments[strategy_type]
        for bot in bots:
            routed_signal = signal.copy()
            routed_signal['bot_name'] = bot
            bot_signal_queues[bot].put(routed_signal)
            logging.info(f"📥 Routed signal '{strategy_type}' explicitly to bot '{bot}'")
    else:
        logging.warning(f"⚠️ Unknown signal type received: '{strategy_type}'")
