def get_all_upcoming_races():
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("""
            SELECT marketId, raceStartTime FROM races
            WHERE date(raceStartTime) = date('now')
            AND raceStartTime > ?
            ORDER BY raceStartTime ASC
        """, (datetime.utcnow().isoformat(),))
        races = cursor.fetchall()
        upcoming = []
        for marketId, raceStartTime in races:
            upcoming.append({
                'marketId': marketId,
                'raceStartTime': datetime.fromisoformat(raceStartTime)
            })
        return upcoming



