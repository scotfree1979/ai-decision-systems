def _create_schema(conn: sqlite3.Connection) -> None:
    cur = conn.cursor()
    for ddl in DDL_STATEMENTS:
        cur.execute(ddl)
    conn.commit()


def _seed_bootstrap(conn: sqlite3.Connection) -> None:
    cur = conn.cursor()
    cur.execute("INSERT OR REPLACE INTO meta(key, value) VALUES(?, ?)",
                ("schema_version", "2"))
    cur.execute(
        "INSERT INTO runs(started_at, mode, notes) VALUES(?,?,?)",
        (datetime.utcnow().isoformat(), "SIM", "bootstrap run")
    )
    conn.commit()

