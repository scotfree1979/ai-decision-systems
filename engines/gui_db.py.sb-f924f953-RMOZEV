except Exception:
    # Fallback: create under ./data
    BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    DATA_DIR = os.path.join(BASE_DIR, "data")
    os.makedirs(DATA_DIR, exist_ok=True)
    GUI_DB_PATH = os.path.join(DATA_DIR, "autoscalp_gui.db")

def _ensure_parent_dir(path: str) -> None:
    d = os.path.dirname(path)
    if d and not os.path.exists(d):
        os.makedirs(d, exist_ok=True)


# ---------------------------------------------------------------------
# Public helpers
# ---------------------------------------------------------------------
def ensure_gui_db() -> str:
    os.makedirs(os.path.dirname(GUI_DB_PATH), exist_ok=True)
    first_time = not os.path.exists(GUI_DB_PATH)

    # extra: verify writability
    test_dir = os.path.dirname(GUI_DB_PATH)
    if not os.access(test_dir, os.W_OK):
        raise PermissionError(f"GUI DB dir not writable: {test_dir}")

    with sqlite3.connect(GUI_DB_PATH) as conn:
        _apply_pragmas(conn)
        _create_schema(conn)
        if first_time:
            _seed_bootstrap(conn)
            print(f"✅ GUI DB created at: {GUI_DB_PATH}")
    return GUI_DB_PATH


# ---------------------------------------------------------------------
# PRAGMAs tuned for high-write, single-writer (GUI) flow
# ---------------------------------------------------------------------

def _apply_pragmas(conn: sqlite3.Connection) -> None:
    cur = conn.cursor()
    cur.execute("PRAGMA journal_mode=WAL;")            # concurrent readers OK
    cur.execute("PRAGMA synchronous=NORMAL;")          # durability/speed tradeoff
    cur.execute("PRAGMA temp_store=MEMORY;")
    cur.execute("PRAGMA mmap_size=30000000000;")       # ~30GB virtual (safe if OS supports)
    cur.execute("PRAGMA page_size=4096;")
    cur.execute("PRAGMA cache_size=-200000;")          # negative => KB units (~200MB)
    cur.execute("PRAGMA foreign_keys=ON;")
    cur.execute("PRAGMA wal_autocheckpoint=1000;")     # checkpoint cadence
    conn.commit()

