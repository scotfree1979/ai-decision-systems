#!/usr/bin/env python3
"""
T0 — Bootstrap GUI DB (create + PRAGMA + indices)
Owner : GUI
Deps  : []
Goal  : New DB that the GUI owns/writes. Reads from BETS DB only. No shared writes.

Usage:
    from engines.gui_db import ensure_gui_db, get_gui_db
    ensure_gui_db()  # call once at startup (StartupView → Start Engine)

    # Example:
    with get_gui_db() as conn:
        conn.execute("INSERT INTO runs(mode, started_at, notes) VALUES(?,?,?)",
                     ("SIM", datetime.utcnow().isoformat(), "startup smoke"))

This module is idempotent (safe to re-run). No memory/RAM caches; DB-first.
"""
from __future__ import annotations

import os
import sqlite3
